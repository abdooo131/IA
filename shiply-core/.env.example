# One .env at shiply-core/ for every app.
DATABASE_URL=postgresql://shiply:shiply@localhost:5433/shiply_core
# Long random string. Signs the login cookie.
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4100
API_URL=http://localhost:4100
WEB_PORT=3100
# First admin, created by pnpm db:seed
SEED_ADMIN_EMAIL=admin@shiply.local
SEED_ADMIN_PASSWORD=change-me
# Password for the demo hub staff, couriers and merchants made by the seed
SEED_DEMO_PASSWORD=demo12345

# Key that encrypts stored secrets such as Shopify access tokens. Long and random; never change it
# once stores are connected. Falls back to JWT_SECRET when empty.
SECRETS_KEY=

# Merchant API: calls each key may make a minute.
API_RATE_PER_MINUTE=300

# Shopify app, from the Shopify Partner dashboard. The connection stays off until all three are set.
# SHOPIFY_APP_URL is the public web address; set the app's redirect URL to
# <SHOPIFY_APP_URL>/api/integrations/shopify/callback and the privacy webhooks to
# <SHOPIFY_APP_URL>/api/integrations/shopify/webhooks
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
