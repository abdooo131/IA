# One .env at shiply-core/ for every app.
DATABASE_URL=postgresql://shiply:shiply@localhost:5433/shiply_core
# Long random string. Signs the login cookie.
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4100
API_URL=http://localhost:4100
WEB_PORT=3100
# First admin, created by pnpm db:seed
SEED_ADMIN_EMAIL=admin@shiply.local
SEED_ADMIN_PASSWORD=change-me
# Password for the demo hub staff, couriers and merchants made by the seed
SEED_DEMO_PASSWORD=demo12345
