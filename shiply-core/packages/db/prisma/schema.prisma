// Shiply Core: parcel management for next day delivery.
// Money columns are integer piastres. Status changes are written to shipment_events (append only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HUB_STAFF
  COURIER
  MERCHANT
  AGENT
}

/// What an agent supplies: pickup staff, delivery staff, or both.
enum AgentSupply {
  PICKUP
  DELIVERY
  BOTH
}

enum CourierType {
  PICKUP
  DELIVERY
}

enum AgentDocumentKind {
  NATIONAL_ID
  COMMERCIAL_REGISTER
  TAX_CARD
  CONTRACT
  OTHER
}

enum VehicleKind {
  VAN
  BOX_TRUCK
  PICKUP_TRUCK
  CAR
  MOTORCYCLE
}

/// FIXED vehicles are rented monthly; SPECIAL ones are paid per request at a custom price.
enum VehicleContract {
  FIXED
  SPECIAL
}

enum VehicleRequestReason {
  MERCHANT_SPECIAL
  BREAKDOWN
  VEHICLE_FULL
  OTHER
}

enum VehicleRequestStatus {
  REQUESTED
  PROVIDED
  DONE
  CANCELLED
}

enum ShiftStatus {
  SCHEDULED
  CHECKED_IN
  LATE_NOTICE
  NOT_COMING
  REPLACED
}

enum AlertStatus {
  OPEN
  RESOLVED
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  AT_INBOUND
  SORTED
  AT_OUTBOUND
  AT_HUB
  ON_HOLD
  IN_TRANSIT
  OUT_FOR_DELIVERY
  ATTEMPT_FAILED
  DELIVERED
  RETURNED
  CANCELLED
  LOST
}

enum Direction {
  FORWARD
  RETURN
}

enum ParcelSize {
  S
  M
  L
  XL
}

enum Team {
  INBOUND
  SORTING
  OUTBOUND
}

enum PickupStatus {
  REQUESTED
  ASSIGNED
  COLLECTED
  RECEIVED
  CANCELLED
}

enum BagStatus {
  OPEN
  SEALED
  HANDED_OVER
  IN_TRANSIT
  RECEIVED
  CHECKED
}

enum TripStatus {
  LOADING
  IN_TRANSIT
  ARRIVED
}

enum RunStatus {
  LOADING
  OUT
  CLOSED
}

enum RunItemResult {
  PENDING
  DELIVERED
  RETURNED
  FAILED
}

/// A sorting facility (isSorting) or a last mile hub (fed by one facility through parentId).
model Hub {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  address   String   @default("")
  isSorting Boolean  @default(false) @map("is_sorting")
  parentId  String?  @map("parent_id") @db.Uuid
  parent    Hub?     @relation("HubParent", fields: [parentId], references: [id])
  children  Hub[]    @relation("HubParent")
  lat       Float    @default(0)
  lng       Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  governorates Governorate[]
  areas        Area[]
  users        User[]
  merchants    Merchant[]

  @@map("hubs")
}

/// Pricing and promise zone, e.g. Greater Cairo next day, Delta two days.
model Zone {
  code        String @id
  name        String
  transitDays Int    @map("transit_days")
  priceS      Int    @map("price_s")
  priceM      Int    @map("price_m")
  priceL      Int    @map("price_l")
  priceXL     Int    @map("price_xl")

  governorates Governorate[]

  @@map("zones")
}

model Governorate {
  code     String  @id
  nameEn   String  @map("name_en")
  nameAr   String  @map("name_ar")
  zoneCode String  @map("zone_code")
  zone     Zone    @relation(fields: [zoneCode], references: [code])
  lat      Float   @default(0)
  lng      Float   @default(0)
  /// Hub that delivers here when the area has no hub of its own. Null means we do not serve it yet.
  hubId    String? @map("hub_id") @db.Uuid
  hub      Hub?    @relation(fields: [hubId], references: [id])

  areas Area[]

  @@map("governorates")
}

model Area {
  id              String        @id @default(uuid()) @db.Uuid
  governorateCode String        @map("governorate_code")
  governorate     Governorate   @relation(fields: [governorateCode], references: [code])
  nameEn          String        @map("name_en")
  nameAr          String        @map("name_ar")
  lat             Float?
  lng             Float?
  hubId           String?       @map("hub_id") @db.Uuid
  hub             Hub?          @relation(fields: [hubId], references: [id])
  couriers        CourierArea[]

  @@unique([governorateCode, nameEn])
  @@map("areas")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  /// Couriers who join with an agent code sign in with their phone; email is optional for them.
  email           String?      @unique
  name            String
  phone           String       @default("")
  passwordHash    String       @map("password_hash")
  role            Role
  /// Inside a sorting facility: the team this person works in. Null = every station (supervisor).
  team            Team?
  hubId           String?      @map("hub_id") @db.Uuid
  hub             Hub?         @relation(fields: [hubId], references: [id])
  merchantId      String?      @map("merchant_id") @db.Uuid
  merchant        Merchant?    @relation(fields: [merchantId], references: [id])
  /// The agent this person works for (couriers) or represents (agent logins).
  agentId         String?      @map("agent_id") @db.Uuid
  agent           Agent?       @relation(fields: [agentId], references: [id])
  courierType     CourierType? @map("courier_type")
  /// A pickup courier registered with their agent to move pallets between hubs.
  hubToHub        Boolean      @default(false) @map("hub_to_hub")
  /// Shift start in Cairo time (HH:MM) and working weekdays (0 Sunday ... 6 Saturday).
  shiftStart      String       @default("09:00") @map("shift_start")
  workDays        Int[]        @default([0, 1, 2, 3, 4, 6]) @map("work_days")
  vehicleId       String?      @map("vehicle_id") @db.Uuid
  vehicle         Vehicle?     @relation(fields: [vehicleId], references: [id])
  /// Joined with an agent code and waiting for the agent to approve.
  pendingApproval Boolean      @default(false) @map("pending_approval")
  /// A courier with a negative wallet is frozen; operations can let them work until this time.
  unfreezeUntil   DateTime?    @map("unfreeze_until")
  unfreezeReason  String       @default("") @map("unfreeze_reason")
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")

  areas  CourierArea[]
  shifts Shift[]       @relation("ShiftCourier")

  @@index([agentId])
  @@map("users")
}

/// A field agent (وكيل): supplies pickup and delivery staff, vehicles and replacements.
model Agent {
  id                 String      @id @default(uuid()) @db.Uuid
  /// Staff can only register with this code, which ties them to the agent.
  code               String      @unique
  name               String
  phone              String
  email              String      @default("")
  supplies           AgentSupply @default(BOTH)
  nationalIdNo       String      @default("") @map("national_id_no")
  commercialRegister String      @default("") @map("commercial_register")
  taxCardNo          String      @default("") @map("tax_card_no")
  bankName           String      @default("") @map("bank_name")
  bankAccountName    String      @default("") @map("bank_account_name")
  iban               String      @default("")
  /// Null = the default commission from settings.
  commissionBp       Int?        @map("commission_bp")
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now()) @map("created_at")

  users           User[]
  documents       AgentDocument[]
  vehicles        Vehicle[]
  vehicleRequests VehicleRequest[]
  shifts          Shift[]

  @@map("agents")
}

model AgentDocument {
  id           String            @id @default(uuid()) @db.Uuid
  agentId      String            @map("agent_id") @db.Uuid
  agent        Agent             @relation(fields: [agentId], references: [id])
  kind         AgentDocumentKind
  fileName     String            @map("file_name")
  mime         String
  size         Int
  data         Bytes
  uploadedById String            @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([agentId])
  @@map("agent_documents")
}

model CourierArea {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  areaId String @map("area_id") @db.Uuid
  area   Area   @relation(fields: [areaId], references: [id])

  @@id([userId, areaId])
  @@map("courier_areas")
}

model Vehicle {
  id              String          @id @default(uuid()) @db.Uuid
  agentId         String          @map("agent_id") @db.Uuid
  agent           Agent           @relation(fields: [agentId], references: [id])
  plate           String          @unique
  kind            VehicleKind
  contract        VehicleContract @default(FIXED)
  /// Monthly rent in piastres for FIXED vehicles.
  monthlyRent     Int             @default(0) @map("monthly_rent")
  capacityParcels Int?            @map("capacity_parcels")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")

  users    User[]
  requests VehicleRequest[]

  @@map("vehicles")
}

/// Operations asks an agent for an extra vehicle with its driver, at a custom price.
model VehicleRequest {
  id            String               @id @default(uuid()) @db.Uuid
  code          String               @unique
  agentId       String               @map("agent_id") @db.Uuid
  agent         Agent                @relation(fields: [agentId], references: [id])
  reason        VehicleRequestReason
  merchantId    String?              @map("merchant_id") @db.Uuid
  hubId         String?              @map("hub_id") @db.Uuid
  date          String
  /// Agreed price for this request, in piastres.
  price         Int
  status        VehicleRequestStatus @default(REQUESTED)
  vehicleId     String?              @map("vehicle_id") @db.Uuid
  vehicle       Vehicle?             @relation(fields: [vehicleId], references: [id])
  driverName    String               @default("") @map("driver_name")
  driverPhone   String               @default("") @map("driver_phone")
  notes         String               @default("")
  requestedById String               @map("requested_by_id") @db.Uuid
  providedAt    DateTime?            @map("provided_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([agentId, status])
  @@map("vehicle_requests")
}

/// One courier's working day: scheduled start, check in, and the agent's answer when they are missing.
model Shift {
  id                  String      @id @default(uuid()) @db.Uuid
  courierId           String      @map("courier_id") @db.Uuid
  courier             User        @relation("ShiftCourier", fields: [courierId], references: [id])
  agentId             String      @map("agent_id") @db.Uuid
  agent               Agent       @relation(fields: [agentId], references: [id])
  date                String
  startAt             DateTime    @map("start_at")
  status              ShiftStatus @default(SCHEDULED)
  checkInAt           DateTime?   @map("check_in_at")
  checkInPhoto        Bytes?      @map("check_in_photo")
  checkInLat          Float?      @map("check_in_lat")
  checkInLng          Float?      @map("check_in_lng")
  lateMinutes         Int?        @map("late_minutes")
  alertedAt           DateTime?   @map("alerted_at")
  answeredAt          DateTime?   @map("answered_at")
  expectedAt          DateTime?   @map("expected_at")
  replacementDeadline DateTime?   @map("replacement_deadline")
  replacementOverdue  Boolean     @default(false) @map("replacement_overdue")
  /// The shift of the person who replaced this one.
  replacementShiftId  String?     @map("replacement_shift_id") @db.Uuid
  /// This shift covers someone else's.
  replacesShiftId     String?     @map("replaces_shift_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")

  @@unique([courierId, date])
  @@index([agentId, date])
  @@map("shifts")
}

/// Something a person must act on. One open alert per kind and entity.
model Alert {
  id           String      @id @default(uuid()) @db.Uuid
  kind         String
  severity     String      @default("normal")
  agentId      String?     @map("agent_id") @db.Uuid
  hubId        String?     @map("hub_id") @db.Uuid
  entity       String
  entityId     String      @map("entity_id")
  message      String
  status       AlertStatus @default(OPEN)
  note         String      @default("")
  resolvedById String?     @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?   @map("resolved_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([status, agentId])
  @@index([kind, entity, entityId])
  @@map("alerts")
}

model Merchant {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  phone           String
  email           String   @default("")
  pickupAddress   String   @map("pickup_address")
  governorateCode String   @map("governorate_code")
  areaId          String?  @map("area_id") @db.Uuid
  /// The sorting facility nearest the merchant: it receives their pickups and hands back returns.
  homeHubId       String   @map("home_hub_id") @db.Uuid
  homeHub         Hub      @relation(fields: [homeHubId], references: [id])
  discountBp      Int      @default(0) @map("discount_bp")
  /// Where payouts go. Once set, a change waits for a second person to approve it.
  bankName        String   @default("") @map("bank_name")
  bankAccountName String   @default("") @map("bank_account_name")
  iban            String   @default("")
  /// Tax registration number, for tax invoices (empty for a person, not a company).
  taxId           String   @default("") @map("tax_id")
  pendingBank     Json?    @map("pending_bank")
  pendingBankById String?  @map("pending_bank_by_id") @db.Uuid
  /// Weekdays the merchant is paid (0 Sunday ... 6 Saturday).
  payoutDays      Int[]    @default([0, 3]) @map("payout_days")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  users     User[]
  shipments Shipment[]
  pickups   Pickup[]
  payouts   Payout[]

  @@map("merchants")
}

model Shipment {
  id              String     @id @default(uuid()) @db.Uuid
  trackingNumber  String     @unique @map("tracking_number")
  merchantId      String     @map("merchant_id") @db.Uuid
  merchant        Merchant   @relation(fields: [merchantId], references: [id])
  merchantRef     String     @default("") @map("merchant_ref")
  customerName    String     @map("customer_name")
  customerPhone   String     @map("customer_phone")
  address         String
  governorateCode String     @map("governorate_code")
  areaId          String?    @map("area_id") @db.Uuid
  size            ParcelSize @default(M)
  description     String     @default("")
  notes           String     @default("")
  allowOpen       Boolean    @default(false) @map("allow_open")
  codAmount       Int        @default(0) @map("cod_amount")

  status           ShipmentStatus @default(CREATED)
  direction        Direction      @default(FORWARD)
  originHubId      String         @map("origin_hub_id") @db.Uuid
  destinationHubId String         @map("destination_hub_id") @db.Uuid
  currentHubId     String?        @map("current_hub_id") @db.Uuid
  pickupId         String?        @map("pickup_id") @db.Uuid
  bagId            String?        @map("bag_id") @db.Uuid
  /// Lane the sorting team put the parcel on (its next place), waiting for outbound to bag it.
  laneHubId        String?        @map("lane_hub_id") @db.Uuid
  runId            String?        @map("run_id") @db.Uuid

  attempts       Int     @default(0)
  lastFailReason String? @map("last_fail_reason")
  holdReason     String? @map("hold_reason")
  promisedDate   String? @map("promised_date")

  shippingFee  Int     @map("shipping_fee")
  codFee       Int     @map("cod_fee")
  returnFee    Int     @default(0) @map("return_fee")
  codCollected Int     @default(0) @map("cod_collected")
  payoutId     String? @map("payout_id") @db.Uuid
  payout       Payout? @relation(fields: [payoutId], references: [id])

  enteredAt   DateTime? @map("entered_at")
  deliveredAt DateTime? @map("delivered_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  events   ShipmentEvent[]
  runItems RunItem[]

  @@index([merchantId, createdAt])
  @@index([status, currentHubId])
  @@index([bagId])
  @@index([runId])
  @@index([pickupId])
  @@map("shipments")
}

/// Append only. A trigger rejects UPDATE and DELETE.
model ShipmentEvent {
  id         String          @id @default(uuid()) @db.Uuid
  shipmentId String          @map("shipment_id") @db.Uuid
  shipment   Shipment        @relation(fields: [shipmentId], references: [id])
  type       String
  fromStatus ShipmentStatus? @map("from_status")
  toStatus   ShipmentStatus  @map("to_status")
  hubId      String?         @map("hub_id") @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  note       String          @default("")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}

model Pickup {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  merchantId    String       @map("merchant_id") @db.Uuid
  merchant      Merchant     @relation(fields: [merchantId], references: [id])
  hubId         String       @map("hub_id") @db.Uuid
  date          String
  status        PickupStatus @default(REQUESTED)
  courierId     String?      @map("courier_id") @db.Uuid
  expectedCount Int          @default(0) @map("expected_count")
  notes         String       @default("")
  collectedAt   DateTime?    @map("collected_at")
  receivedAt    DateTime?    @map("received_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([hubId, date])
  @@map("pickups")
}

model Bag {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique
  originHubId      String    @map("origin_hub_id") @db.Uuid
  destinationHubId String    @map("destination_hub_id") @db.Uuid
  status           BagStatus @default(OPEN)
  tripId           String?   @map("trip_id") @db.Uuid
  trip             Trip?     @relation(fields: [tripId], references: [id])
  sealedAt         DateTime? @map("sealed_at")
  receivedAt       DateTime? @map("received_at")
  /// When the receiving team finished scanning the bag's parcels; unscanned ones were marked lost.
  checkedAt        DateTime? @map("checked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([originHubId, status])
  @@map("bags")
}

/// A line haul vehicle moving sealed bags from one hub to another.
model Trip {
  id               String     @id @default(uuid()) @db.Uuid
  code             String     @unique
  originHubId      String     @map("origin_hub_id") @db.Uuid
  destinationHubId String     @map("destination_hub_id") @db.Uuid
  vehicle          String     @default("")
  driverName       String     @default("") @map("driver_name")
  status           TripStatus @default(LOADING)
  departedAt       DateTime?  @map("departed_at")
  arrivedAt        DateTime?  @map("arrived_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  bags Bag[]

  @@map("trips")
}

/// A courier's delivery run for one day from one hub. Can carry deliveries and returns.
model Run {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique
  hubId        String    @map("hub_id") @db.Uuid
  courierId    String    @map("courier_id") @db.Uuid
  date         String
  status       RunStatus @default(LOADING)
  cashExpected Int       @default(0) @map("cash_expected")
  cashReceived Int?      @map("cash_received")
  startedAt    DateTime? @map("started_at")
  closedAt     DateTime? @map("closed_at")
  closedById   String?   @map("closed_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  items RunItem[]

  @@index([courierId, status])
  @@map("runs")
}

model RunItem {
  id           String        @id @default(uuid()) @db.Uuid
  runId        String        @map("run_id") @db.Uuid
  run          Run           @relation(fields: [runId], references: [id])
  shipmentId   String        @map("shipment_id") @db.Uuid
  shipment     Shipment      @relation(fields: [shipmentId], references: [id])
  direction    Direction
  result       RunItemResult @default(PENDING)
  failReason   String?       @map("fail_reason")
  codCollected Int           @default(0) @map("cod_collected")
  recipient    String        @default("")
  backAtHub    Boolean       @default(false) @map("back_at_hub")
  resolvedAt   DateTime?     @map("resolved_at")

  @@unique([runId, shipmentId])
  @@map("run_items")
}

model Payout {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  merchantId   String       @map("merchant_id") @db.Uuid
  merchant     Merchant     @relation(fields: [merchantId], references: [id])
  codTotal     Int          @map("cod_total")
  feesTotal    Int          @map("fees_total")
  /// Cash out fee kept by Shiply from this payout.
  payoutFee    Int          @default(0) @map("payout_fee")
  /// What the merchant receives: cash collected minus fees minus the cash out fee.
  amount       Int
  status       PayoutStatus @default(PENDING_APPROVAL)
  bankName     String       @default("") @map("bank_name")
  accountName  String       @default("") @map("account_name")
  iban         String       @default("")
  reference    String       @default("")
  createdById  String       @map("created_by_id") @db.Uuid
  approvedById String?      @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?    @map("approved_at")
  paidById     String?      @map("paid_by_id") @db.Uuid
  paidAt       DateTime?    @map("paid_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  shipments Shipment[]

  @@index([status])
  @@map("payouts")
}

enum PayoutStatus {
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

// ---------------------------------------------------------------- accounting

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Who a line belongs to, so one control account holds every merchant's (or courier's) wallet.
enum PartyType {
  MERCHANT
  COURIER
  AGENT
  HUB
  SUPPLIER
}

model Account {
  code      String      @id
  name      String
  nameAr    String      @map("name_ar")
  type      AccountType
  /// Lines on this account must name a party of this type (wallet accounts).
  party     PartyType?
  /// Built in accounts the system posts to; they cannot be removed.
  system    Boolean     @default(false)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")

  lines JournalLine[]

  @@map("accounts")
}

/// Append only. Corrections are new entries. A database check makes every entry balance.
model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  number      Int      @unique @default(autoincrement())
  /// Business date in Cairo (YYYY-MM-DD).
  date        String
  memo        String
  source      String
  /// Stops the same event being posted twice, for example DELIVERED:<parcel id>.
  key         String?  @unique
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  lines JournalLine[]

  @@index([date])
  @@index([source])
  @@map("journal_entries")
}

model JournalLine {
  id          String       @id @default(uuid()) @db.Uuid
  entryId     String       @map("entry_id") @db.Uuid
  entry       JournalEntry @relation(fields: [entryId], references: [id])
  accountCode String       @map("account_code")
  account     Account      @relation(fields: [accountCode], references: [code])
  partyType   PartyType?   @map("party_type")
  partyId     String?      @map("party_id") @db.Uuid
  debit       Int          @default(0)
  credit      Int          @default(0)
  memo        String       @default("")

  @@index([accountCode, partyType, partyId])
  @@index([entryId])
  @@map("journal_lines")
}

enum EarningKind {
  DELIVERY
  RETURN
  PICKUP
  BONUS
  PENALTY
  ADJUSTMENT
}

/// What a courier earned (or lost), in points and money. Money becomes withdrawable after the freeze.
model CourierEarning {
  id           String      @id @default(uuid()) @db.Uuid
  courierId    String      @map("courier_id") @db.Uuid
  /// The agent the courier worked for at the time; their month end settlement takes it.
  agentId      String?     @map("agent_id") @db.Uuid
  kind         EarningKind
  points       Int         @default(0)
  amount       Int
  shipmentId   String?     @map("shipment_id") @db.Uuid
  date         String
  availableAt  DateTime    @map("available_at")
  settlementId String?     @map("settlement_id") @db.Uuid
  note         String      @default("")
  createdById  String?     @map("created_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")

  @@unique([courierId, kind, shipmentId])
  @@index([courierId, date])
  @@index([agentId, date])
  @@map("courier_earnings")
}

enum RequestStatus {
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

/// A courier takes money out of their wallet. A second person approves, finance pays.
model Withdrawal {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique
  courierId     String        @map("courier_id") @db.Uuid
  amount        Int
  method        String        @default("")
  status        RequestStatus @default(PENDING_APPROVAL)
  note          String        @default("")
  requestedById String        @map("requested_by_id") @db.Uuid
  approvedById  String?       @map("approved_by_id") @db.Uuid
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([courierId])
  @@map("withdrawals")
}

enum PayInChannel {
  FAWRY
  BASATA
  BANK_TRANSFER
}

enum PayInPurpose {
  /// Cash collected on a run, paid in instead of handed over at the hub.
  CASH
  /// Money a courier pays to bring a negative wallet back up.
  RECHARGE
}

enum CheckStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
}

/// A courier pays money in through Fawry (or another channel) and uploads the receipt.
model PayIn {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  courierId   String       @map("courier_id") @db.Uuid
  runId       String?      @map("run_id") @db.Uuid
  amount      Int
  channel     PayInChannel @default(FAWRY)
  purpose     PayInPurpose @default(CASH)
  reference   String
  receipt     Bytes?
  receiptMime String       @default("") @map("receipt_mime")
  status      CheckStatus  @default(SUBMITTED)
  note        String       @default("")
  checkedById String?      @map("checked_by_id") @db.Uuid
  checkedAt   DateTime?    @map("checked_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status])
  @@index([runId])
  @@map("pay_ins")
}

/// Hub staff take cash from the hub safe to the bank; finance confirms it arrived.
model SafeDeposit {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique
  hubId       String      @map("hub_id") @db.Uuid
  amount      Int
  reference   String
  receipt     Bytes?
  receiptMime String      @default("") @map("receipt_mime")
  status      CheckStatus @default(SUBMITTED)
  note        String      @default("")
  createdById String      @map("created_by_id") @db.Uuid
  checkedById String?     @map("checked_by_id") @db.Uuid
  checkedAt   DateTime?   @map("checked_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([hubId, status])
  @@map("safe_deposits")
}

/// What an agent is owed for one month: staff pay, commission, vehicles, minus penalties.
model AgentSettlement {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique
  agentId         String        @map("agent_id") @db.Uuid
  /// YYYY-MM
  month           String
  staffPay        Int           @map("staff_pay")
  commissionBp    Int           @map("commission_bp")
  commission      Int
  vehicleRent     Int           @map("vehicle_rent")
  specialVehicles Int           @map("special_vehicles")
  penalties       Int
  /// Advances already paid to the agent this month, taken off the payment.
  advances        Int           @default(0)
  total           Int
  details         Json
  status          RequestStatus @default(PENDING_APPROVAL)
  invoice         Bytes?
  invoiceName     String        @default("") @map("invoice_name")
  invoiceMime     String        @default("") @map("invoice_mime")
  createdById     String        @map("created_by_id") @db.Uuid
  approvedById    String?       @map("approved_by_id") @db.Uuid
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([agentId, month])
  @@map("agent_settlements")
}

enum PaidFrom {
  BANK
  HUB_SAFE
}

model Expense {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  date         String
  accountCode  String        @map("account_code")
  amount       Int
  paidFrom     PaidFrom      @default(BANK) @map("paid_from")
  hubId        String?       @map("hub_id") @db.Uuid
  supplier     String        @default("")
  note         String        @default("")
  receipt      Bytes?
  receiptMime  String        @default("") @map("receipt_mime")
  status       RequestStatus @default(PENDING_APPROVAL)
  createdById  String        @map("created_by_id") @db.Uuid
  approvedById String?       @map("approved_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("expenses")
}

/// A hand written journal (opening balances, corrections) waiting for a second person.
model JournalDraft {
  id           String        @id @default(uuid()) @db.Uuid
  date         String
  memo         String
  lines        Json
  status       RequestStatus @default(PENDING_APPROVAL)
  entryId      String?       @map("entry_id") @db.Uuid
  createdById  String        @map("created_by_id") @db.Uuid
  approvedById String?       @map("approved_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("journal_drafts")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------- tax, suppliers, bank, budgets

/// A tax invoice (monthly, per merchant) or a credit note against one. Numbers never repeat.
model TaxInvoice {
  id           String   @id @default(uuid()) @db.Uuid
  number       String   @unique
  /// INVOICE or CREDIT_NOTE
  kind         String
  merchantId   String   @map("merchant_id") @db.Uuid
  /// YYYY-MM the invoice covers
  month        String
  issueDate    String   @map("issue_date")
  net          Int
  vat          Int
  total        Int
  lines        Json
  /// For a credit note: the invoice it corrects, and why.
  refInvoiceId String?  @map("ref_invoice_id") @db.Uuid
  reason       String   @default("")
  /// ISSUED; credit notes start PENDING_APPROVAL; REJECTED ones never posted.
  status       String   @default("ISSUED")
  /// NOT_SENT, EXPORTED (ETA file downloaded), SUBMITTED (accepted by ETA)
  etaStatus    String   @default("NOT_SENT") @map("eta_status")
  etaUuid      String   @default("") @map("eta_uuid")
  createdById  String   @map("created_by_id") @db.Uuid
  approvedById String?  @map("approved_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([merchantId, month])
  @@map("tax_invoices")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  taxId     String   @default("") @map("tax_id")
  phone     String   @default("")
  email     String   @default("")
  bankName  String   @default("") @map("bank_name")
  iban      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  bills Bill[]

  @@map("suppliers")
}

/// A supplier's invoice: booked when a second person approves, paid later.
model Bill {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  supplierId   String        @map("supplier_id") @db.Uuid
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  /// The supplier's own invoice number.
  number       String        @default("")
  date         String
  dueDate      String        @map("due_date")
  accountCode  String        @map("account_code")
  net          Int
  vat          Int
  whtBp        Int           @default(0) @map("wht_bp")
  wht          Int           @default(0)
  /// net + vat
  total        Int
  /// What we pay the supplier: total minus withholding tax.
  payable      Int
  hubId        String?       @map("hub_id") @db.Uuid
  note         String        @default("")
  attachment   Bytes?
  mime         String        @default("")
  status       RequestStatus @default(PENDING_APPROVAL)
  createdById  String        @map("created_by_id") @db.Uuid
  approvedById String?       @map("approved_by_id") @db.Uuid
  paidAt       DateTime?     @map("paid_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@map("bills")
}

model BankImport {
  id          String   @id @default(uuid()) @db.Uuid
  fileName    String   @map("file_name")
  rows        Int
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  lines BankLine[]

  @@map("bank_imports")
}

/// One line of the bank's statement, matched to a bank line in our books.
model BankLine {
  id            String     @id @default(uuid()) @db.Uuid
  importId      String     @map("import_id") @db.Uuid
  import        BankImport @relation(fields: [importId], references: [id])
  date          String
  description   String
  reference     String     @default("")
  /// Money in is positive, money out negative (piastres).
  amount        Int
  /// The journal line on the bank account it matches.
  matchedLineId String?    @unique @map("matched_line_id") @db.Uuid
  matchedById   String?    @map("matched_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([date])
  @@map("bank_lines")
}

model Budget {
  id          String @id @default(uuid()) @db.Uuid
  accountCode String @map("account_code")
  /// YYYY-MM
  month       String
  amount      Int

  @@unique([accountCode, month])
  @@map("budgets")
}

/// Money paid to an agent before month end, taken off their next settlement.
model AgentAdvance {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique
  agentId       String        @map("agent_id") @db.Uuid
  amount        Int
  status        RequestStatus @default(PENDING_APPROVAL)
  note          String        @default("")
  requestedById String        @map("requested_by_id") @db.Uuid
  approvedById  String?       @map("approved_by_id") @db.Uuid
  settlementId  String?       @map("settlement_id") @db.Uuid
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([agentId])
  @@map("agent_advances")
}
