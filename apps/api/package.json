{
  "name": "@shiply/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && ts-node --transpile-only prisma/seed.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --runInBand --selectProjects integration"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "~6.19.3",
    "@shiply/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.7.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.6.1",
    "ioredis": "^5.7.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.2",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "~6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/src"
        ],
        "testMatch": [
          "**/*.spec.ts"
        ],
        "moduleNameMapper": {
          "^@shiply/shared$": "<rootDir>/../../packages/shared/src"
        }
      },
      {
        "displayName": "integration",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/test"
        ],
        "testMatch": [
          "**/*.e2e-spec.ts"
        ],
        "setupFiles": [
          "<rootDir>/test/env.ts"
        ],
        "globalSetup": "<rootDir>/test/global-setup.ts",
        "moduleNameMapper": {
          "^@shiply/shared$": "<rootDir>/../../packages/shared/src"
        },
        "globalTeardown": "<rootDir>/test/global-teardown.ts"
      }
    ],
    "testTimeout": 30000
  }
}