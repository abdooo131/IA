{
  "name": "shiplynow",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r build",
    "dev": "pnpm build:packages && pnpm --parallel --no-bail --filter @shiplynow/api --filter @shiplynow/web dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r --workspace-concurrency=1 test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @shiplynow/db migrate:dev",
    "db:deploy": "pnpm --filter @shiplynow/db migrate:deploy && pnpm --filter @shiplynow/db generate",
    "db:seed": "pnpm build:packages && pnpm --filter @shiplynow/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
