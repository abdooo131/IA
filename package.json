{
  "name": "shiply",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm --filter @shiply/shared build && pnpm --filter @shiply/api build && pnpm --filter @shiply/merchant build && pnpm --filter @shiply/ops build",
    "test": "pnpm --filter @shiply/shared test && pnpm --filter @shiply/api test",
    "test:e2e": "pnpm --filter @shiply/web-e2e e2e",
    "dev:api": "pnpm --filter @shiply/api dev",
    "dev:merchant": "pnpm --filter @shiply/merchant dev",
    "dev:ops": "pnpm --filter @shiply/ops dev",
    "db:migrate": "pnpm --filter @shiply/api db:migrate",
    "db:seed": "pnpm --filter @shiply/api db:seed"
  }
}