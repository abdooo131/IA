  "shadow": {
    "sm": "0 1px 2px rgba(19,41,75,.06), 0 1px 1px rgba(19,41,75,.04)",
    "md": "0 6px 16px rgba(19,41,75,.10)",
    "lg": "0 16px 32px rgba(19,41,75,.16)"
  },
  "rules": [
    "Sky (#59CBE8) is a fill or background only. Never text, thin lines or outline icons on white.",
    "Every status shows color, its own icon and its label together. Never color alone.",
    "Wallet colors (cash, points) appear only in wallet cards, balances and transactions, never in status chips.",
    "One primary (Blue) button per screen."
  ]
}