// Shiply Now pilot schema. Tables and columns use snake_case to match CLAUDE.md.
//
// Things Prisma cannot express live in the migration SQL and are listed there:
// PostGIS geometry columns and their GiST indexes, CHECK constraints (stock never below
// zero, money never negative) and the triggers that make the append only tables reject
// UPDATE and DELETE.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─── Users and auth ────────────────────────────────────────────────────────────

/// What a finance user may do: look, prepare money movements, or also approve and close months
enum FinanceLevel {
  view
  prepare
  approve

  @@map("finance_level")
}

/// Access level of a team member in one app (docs/ACCESS.md): none < view < use < manage
enum AccessLevel {
  none
  view
  use
  manage

  @@map("access_level")
}

/// A merchant user's place in the merchant's team: owners have every right and manage the team
enum MerchantRole {
  owner
  member

  @@map("merchant_role")
}

enum Role {
  admin
  merchant
  store_staff
  rider
  finance

  @@map("role")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String        @map("password_hash")
  name           String
  /// Normalized Egyptian mobile, +20 followed by 10 digits
  phone          String?       @unique
  role           Role
  isActive       Boolean       @default(true) @map("is_active")
  /// Home dark store for store staff and riders
  darkStoreId    String?       @map("dark_store_id")
  /// The merchant a merchant user belongs to
  merchantId     String?       @map("merchant_id")
  /// Slack member id (U0123...) so tickets can reach this person in Slack
  slackUserId    String?       @unique @map("slack_user_id")
  /// Kept for history only: decisions use user_access.accounting (docs/ACCESS.md)
  financeLevel   FinanceLevel  @default(approve) @map("finance_level")
  /// Merchant users: owner or member
  merchantRole   MerchantRole? @map("merchant_role")
  /// Merchant members: orders, stock, money, settings (owners have all)
  merchantRights String[]      @default([]) @map("merchant_rights")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  darkStore         DarkStore?        @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  merchant          Merchant?         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  createdManifests  InboundManifest[] @relation("manifest_created_by")
  countsSubmitted   StockCount[]      @relation("count_submitted_by")
  countsReviewed    StockCount[]      @relation("count_reviewed_by")
  ordersCreated     Order[]           @relation("order_created_by")
  returnsCreated    MerchantReturn[]  @relation("return_created_by")
  returnsHandedOver MerchantReturn[]  @relation("return_handed_over_by")
  damageReported    DamageReport[]    @relation("damage_reported_by")
  ticketsOpened     Ticket[]          @relation("ticket_created_by")
  ticketsAssigned   Ticket[]          @relation("ticket_assignee")
  ticketMessages    TicketMessage[]
  orderNotes        OrderNote[]       @relation("order_note_author")
  damageSettled     DamageReport[]    @relation("damage_settled_by")
  transfersCreated  Transfer[]        @relation("transfer_created_by")
  transfersApproved Transfer[]        @relation("transfer_approved_by")
  photos            Photo[]           @relation("photo_created_by")
  alertsResolved    Alert[]           @relation("alert_resolved_by")
  rider             Rider?
  stockMovements    StockMovement[]
  orderEvents       OrderEvent[]
  auditEntries      AuditLog[]
  storeAreasCreated StoreArea[]       @relation("store_area_created_by")
  settingChanges    Setting[]

  ledgerEntries            LedgerEntry[]             @relation("ledger_entry_created_by")
  handoversReceived        CashHandover[]            @relation("handover_received_by")
  handoversReviewed        CashHandover[]            @relation("handover_reviewed_by")
  payoutsCreated           Payout[]                  @relation("payout_created_by")
  payoutsPaid              Payout[]                  @relation("payout_paid_by")
  payoutsApproved          Payout[]                  @relation("payout_approved_by")
  booksLocks               BooksLock[]
  financeRequests          FinanceRequest[]          @relation("finance_request_by")
  financeDecisions         FinanceRequest[]          @relation("finance_request_decided_by")
  financeReceipts          FinanceReceipt[]
  advanceAccounts          LedgerAccount[]           @relation("ledger_account_user")
  ledgerLines              LedgerLine[]              @relation("ledger_line_user")
  suppliers                Supplier[]
  billsFor                 Bill[]                    @relation("bill_person")
  chequesCreated           Cheque[]                  @relation("cheque_created_by")
  contractsCreated         MerchantContract[]        @relation("contract_created_by")
  contractVersionsMade     MerchantContractVersion[] @relation("contract_version_created_by")
  contractVersionsActive   MerchantContractVersion[] @relation("contract_version_activated_by")
  contractFiles            MerchantContractFile[]    @relation("contract_file_uploaded_by")
  bankStatements           BankStatement[]
  taxInvoicesMade          TaxInvoice[]              @relation("tax_invoice_created_by")
  bankLinesDecided         BankStatementLine[]       @relation("bank_line_decided_by")
  budgetsSet               Budget[]                  @relation("budget_updated_by")
  bills                    Bill[]
  recurringEntries         RecurringEntry[]
  prepayments              Prepayment[]
  fixedAssets              FixedAsset[]
  access                   UserAccess?
  accessStores             UserStore[]
  employee                 Employee?
  documentsUploaded        EmployeeDocument[]        @relation("employee_document_uploaded_by")
  documentsReviewed        EmployeeDocument[]        @relation("employee_document_reviewed_by")
  salaryPackagesSet        SalaryPackage[]           @relation("salary_package_created_by")
  checklistsStarted        EmployeeChecklist[]       @relation("employee_checklist_created_by")
  checklistTasksDone       EmployeeChecklistTask[]   @relation("employee_checklist_task_done_by")
  merchantsManaged         Merchant[]                @relation("merchant_account_manager")
  pushSubscriptions        PushSubscription[]
  notificationPrefs        NotificationPreference[]
  pettyCashCreated         PettyCashExpense[]        @relation("petty_cash_created_by")
  pettyCashReversed        PettyCashExpense[]        @relation("petty_cash_reversed_by")
  monthEndMarks            MonthEndMark[]
  purchaseOrdersAsked      PurchaseOrder[]           @relation("purchase_order_requested_by")
  purchaseOrdersDecided    PurchaseOrder[]           @relation("purchase_order_decided_by")
  crmCompaniesOwned        CrmCompany[]              @relation("crm_company_owner")
  crmDealsOwned            CrmDeal[]                 @relation("crm_deal_owner")
  crmActivitiesOwned       CrmActivity[]             @relation("crm_activity_owner")
  crmActivitiesCreated     CrmActivity[]             @relation("crm_activity_created_by")
  crmStageChanges          CrmDealStageHistory[]
  crmDealsWon              CrmDeal[]                 @relation("crm_deal_won_by")
  crmProposalsMade         CrmProposal[]             @relation("crm_proposal_created_by")
  crmProposalsApproved     CrmProposal[]             @relation("crm_proposal_approved_by")
  crmProposalsSent         CrmProposal[]             @relation("crm_proposal_sent_by")
  crmProposalsConfirmed    CrmProposal[]             @relation("crm_proposal_confirmed_by")
  crmTargets               CrmTarget[]               @relation("crm_target_user")
  crmTargetsSet            CrmTarget[]               @relation("crm_target_updated_by")
  crmCommissions           CrmCommission[]           @relation("crm_commission_user")
  crmCommissionsAdjusted   CrmCommission[]           @relation("crm_commission_adjusted_by")
  crmCommissionsApproved   CrmCommission[]           @relation("crm_commission_approved_by")
  setupTokens              UserSetupToken[]          @relation("user_setup_token_user")
  setupTokensMade          UserSetupToken[]          @relation("user_setup_token_created_by")
  hireDrafts               HireDraft[]               @relation("hire_draft_created_by")
  exitsRecorded            EmployeeExit[]            @relation("employee_exit_created_by")
  remindersSent            DocumentReminder[]        @relation("document_reminder_created_by")
  riderWithdrawalsApproved RiderWithdrawal[]         @relation("rider_withdrawal_approved_by")
  riderWithdrawalsPaid     RiderWithdrawal[]         @relation("rider_withdrawal_paid_by")
  riderWithdrawalsRejected RiderWithdrawal[]         @relation("rider_withdrawal_rejected_by")
  listFavorites            UserListFavorite[]
  listPrefs                UserListPrefs[]
  recordNotes              RecordNote[]
  activitiesAssigned       RecordActivity[]          @relation("record_activity_assignee")
  activitiesCreated        RecordActivity[]          @relation("record_activity_created_by")
  expenseClaims            ExpenseClaim[]            @relation("expense_claim_user")
  expenseClaimsApproved    ExpenseClaim[]            @relation("expense_claim_manager_decided_by")
  expenseClaimsPaid        ExpenseClaim[]            @relation("expense_claim_paid_by")
  expenseClaimsRejected    ExpenseClaim[]            @relation("expense_claim_rejected_by")
  basataDecided            BasataDeposit[]           @relation("basata_deposit_decided_by")
  basataSettlements        BasataSettlement[]        @relation("basata_settlement_created_by")
  ridersFrozen             RiderFreeze[]             @relation("rider_freeze_frozen_by")
  ridersUnfrozen           RiderFreeze[]             @relation("rider_freeze_unfrozen_by")

  @@index([darkStoreId])
  @@index([merchantId])
  @@map("users")
}

/// What a team member (admin, finance, store staff account) may open and do, per app.
/// Filled from a job role or set by hand (job_role custom). See docs/ACCESS.md.
model UserAccess {
  userId           String      @id @map("user_id")
  /// The job role it was last filled from (label only), or custom
  jobRole          String      @map("job_role")
  store            AccessLevel @default(none)
  operations       AccessLevel @default(none)
  inventory        AccessLevel @default(none)
  merchants        AccessLevel @default(none)
  customers        AccessLevel @default(none)
  accounting       AccessLevel @default(none)
  hr               AccessLevel @default(none)
  /// Sales CRM (docs/SALES.md)
  sales            AccessLevel @default(none)
  settings         AccessLevel @default(none)
  /// true: every store; false: only the stores in user_stores
  allStores        Boolean     @default(false) @map("all_stores")
  /// May open named customer profiles
  customerData     Boolean     @default(false) @map("customer_data")
  /// May see salaries, payslips and the payroll run
  salaries         Boolean     @default(false)
  /// Account managers: only the merchants whose account manager they are
  ownMerchantsOnly Boolean     @default(false) @map("own_merchants_only")
  /// Sales reps: only their own companies, deals and activities
  ownDealsOnly     Boolean     @default(false) @map("own_deals_only")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_access")
}

/// The stores a team member without all_stores works in.
model UserStore {
  userId      String @map("user_id")
  darkStoreId String @map("dark_store_id")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  darkStore DarkStore @relation(fields: [darkStoreId], references: [id], onDelete: Cascade)

  @@id([userId, darkStoreId])
  @@index([darkStoreId])
  @@map("user_stores")
}

/// Opaque refresh tokens, stored only as a SHA256 hash. Rotated on every refresh.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Places ────────────────────────────────────────────────────────────────────

model Governorate {
  id     Int    @id
  /// ISO 3166-2 code, for example EG-C for Cairo
  code   String @unique
  nameEn String @map("name_en")
  nameAr String @map("name_ar")

  darkStores DarkStore[]
  zones      Zone[]

  @@map("governorates")
}

/// A dark store sells and delivers; a hub (sorting facility) only receives merchant stock and
/// distributes it to the stores. Hubs have no zones, take no orders and are not Shopify locations.
enum LocationKind {
  dark_store
  hub

  @@map("location_kind")
}

model DarkStore {
  id            String       @id @default(cuid())
  kind          LocationKind @default(dark_store)
  /// Short stable code used in bins, seeds and Shopify location names, for example NCR
  code          String       @unique
  nameEn        String       @map("name_en")
  nameAr        String       @map("name_ar")
  addressEn     String       @map("address_en")
  addressAr     String       @map("address_ar")
  governorateId Int          @map("governorate_id")
  latitude      Float
  longitude     Float
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  governorate      Governorate       @relation(fields: [governorateId], references: [id])
  accessUsers      UserStore[]
  employees        Employee[]
  departments      Department[]
  hours            StoreHours[]
  zones            Zone[]
  bins             Bin[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  inboundManifests InboundManifest[]
  merchantReturns  MerchantReturn[]
  damageReports    DamageReport[]
  orders           Order[]
  riders           Rider[]
  transfersOut     Transfer[]        @relation("transfer_from")
  transfersIn      Transfer[]        @relation("transfer_to")
  transfersFinal   Transfer[]        @relation("transfer_final")
  stockTargets     StockTarget[]
  users            User[]
  stockCounts      StockCount[]
  alerts           Alert[]
  storeAreas       StoreArea[]

  ledgerAccounts   LedgerAccount[]
  cashHandovers    CashHandover[]
  riderWithdrawals RiderWithdrawal[]
  expenseClaims    ExpenseClaim[]
  basataDeposits   BasataDeposit[]

  shopifyLocations ShopifyLocation[]

  ledgerLines LedgerLine[]

  bills       Bill[]
  prepayments Prepayment[]
  fixedAssets FixedAsset[]
  budgets     Budget[]

  rosterDays     RosterDay[]
  punches        Punch[]
  attendanceDays AttendanceDay[]

  pettyCash       PettyCashExpense[]
  packagingLevels PackagingLevel[]
  purchaseOrders  PurchaseOrder[]

  @@map("dark_stores")
}

/// Opening hours per weekday (0 = Sunday). Minutes from midnight; closes_minute may go
/// past 1440 for stores that close after midnight.
model StoreHours {
  id           String  @id @default(cuid())
  darkStoreId  String  @map("dark_store_id")
  weekday      Int
  opensMinute  Int     @map("opens_minute")
  closesMinute Int     @map("closes_minute")
  isClosed     Boolean @default(false) @map("is_closed")

  darkStore DarkStore @relation(fields: [darkStoreId], references: [id], onDelete: Cascade)

  @@unique([darkStoreId, weekday])
  @@map("store_hours")
}

/// A delivery zone. The polygon is a PostGIS MultiPolygon in SRID 4326 and is written
/// and read with raw SQL (see src/zones.ts).
model Zone {
  id            String                                       @id @default(cuid())
  darkStoreId   String                                       @map("dark_store_id")
  /// Stable code, unique per store
  code          String
  nameEn        String                                       @map("name_en")
  nameAr        String                                       @map("name_ar")
  governorateId Int                                          @map("governorate_id")
  /// The union of the zone's assigned areas (store_areas), recomputed on every change; a zone
  /// with no assigned area keeps the outline drawn before (docs/ZONES.md)
  area          Unsupported("geometry(MultiPolygon, 4326)")?
  /// The outline drawn by hand before zones were built from areas, kept for one release
  legacyArea    Unsupported("geometry(MultiPolygon, 4326)")? @map("legacy_area")
  isActive      Boolean                                      @default(true) @map("is_active")
  createdAt     DateTime                                     @default(now()) @map("created_at")
  updatedAt     DateTime                                     @updatedAt @map("updated_at")

  darkStore   DarkStore   @relation(fields: [darkStoreId], references: [id], onDelete: Cascade)
  governorate Governorate @relation(fields: [governorateId], references: [id])
  orders      Order[]
  storeAreas  StoreArea[]

  @@unique([darkStoreId, code])
  @@index([area], type: Gist)
  @@map("zones")
}

// ─── Catalog ───────────────────────────────────────────────────────────────────

/// Merchants created by admin start approved; self sign ups wait for admin.
enum MerchantApproval {
  pending
  approved
  rejected

  @@map("merchant_approval")
}

model Merchant {
  id                    String           @id @default(cuid())
  name                  String
  /// myshop.myshopify.com, set when the Shopify app is installed
  shopifyShopDomain     String?          @unique @map("shopify_shop_domain")
  contactEmail          String?          @map("contact_email")
  contactPhone          String?          @map("contact_phone")
  isActive              Boolean          @default(true) @map("is_active")
  /// How often finance pays this merchant the COD collected after fees
  payoutSchedule        PayoutSchedule   @default(weekly) @map("payout_schedule")
  /// The merchant's own 60 minute delivery price shown at checkout; null means not offered
  expressPricePiastres  Int?             @map("express_price_piastres")
  approval              MerchantApproval @default(approved)
  rejectReason          String?          @map("reject_reason")
  /// Tax details printed on our invoices and sent to the e-invoice system
  legalName             String?          @map("legal_name")
  taxRegistrationNumber String?          @map("tax_registration_number")
  taxGovernorate        String?          @map("tax_governorate")
  taxRegionCity         String?          @map("tax_region_city")
  taxStreet             String?          @map("tax_street")
  taxBuildingNumber     String?          @map("tax_building_number")
  taxInvoices           TaxInvoice[]
  /// Where payouts are sent
  bankName              String?          @map("bank_name")
  bankAccountNumber     String?          @map("bank_account_number")
  iban                  String?
  beneficiaryName       String?          @map("beneficiary_name")
  /// Where statements, invoices and payout notices are emailed (empty: contactEmail)
  billingEmails         String[]         @default([]) @map("billing_emails")
  /// The language of those emails: en or ar
  emailLanguage         String           @default("ar") @map("email_language")
  /// Email kinds the merchant does not want (statement, payout_paid, invoice)
  emailOptOuts          String[]         @default([]) @map("email_opt_outs")
  /// The team member who looks after this merchant (docs/HR.md 5)
  accountManagerId      String?          @map("account_manager_id")
  accountManager        User?            @relation("merchant_account_manager", fields: [accountManagerId], references: [id], onDelete: Restrict)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  skus             Sku[]
  inboundManifests InboundManifest[]
  merchantReturns  MerchantReturn[]
  damageReports    DamageReport[]
  orders           Order[]
  users            User[]
  notifications    Notification[]

  ledgerAccounts LedgerAccount[]
  payouts        Payout[]

  shopifyShop ShopifyShop?

  ledgerLines LedgerLine[]
  alerts      Alert[]

  contract MerchantContract?
  cheques  Cheque[]

  crmCompanies       CrmCompany[]
  crmDeals           CrmDeal[]
  crmProposals       CrmProposal[]
  crmCommissionLines CrmCommissionLine[]

  paymentReminders MerchantPaymentReminder[]

  @@index([accountManagerId])
  @@map("merchants")
}

model Sku {
  id                     String   @id @default(cuid())
  merchantId             String   @map("merchant_id")
  /// The merchant's SKU code. Shopify variants are matched on this.
  sku                    String
  barcode                String?
  shopifyVariantId       String?  @unique @map("shopify_variant_id")
  shopifyProductId       String?  @map("shopify_product_id")
  /// The variant's inventory item, used to push stock levels
  shopifyInventoryItemId String?  @map("shopify_inventory_item_id")
  titleEn                String   @map("title_en")
  titleAr                String   @map("title_ar")
  /// Integer piastres, never a float
  pricePiastres          Int      @map("price_piastres")
  weightGrams            Int?     @map("weight_grams")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  merchant       Merchant                         @relation(fields: [merchantId], references: [id])
  binStock       BinStock[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  manifestLines  InboundManifestLine[]
  returnLines    MerchantReturnLine[]
  transferLines  TransferLine[]
  stockTargets   StockTarget[]
  damageReports  DamageReport[]
  orderItems     OrderItem[]
  countLines     StockCountLine[]
  contractPrices MerchantContractVersionProduct[]
  proposalPrices CrmProposalProduct[]

  shopifyStock ShopifyStockSync[]

  @@unique([merchantId, sku])
  @@index([barcode])
  @@map("skus")
}

// ─── Stock ─────────────────────────────────────────────────────────────────────

enum BinType {
  /// Inbound staging, not sellable until put away
  receiving
  /// Shelves pickers pick from. Only these count as on hand.
  pickable
  damaged
  held

  @@map("bin_type")
}

model Bin {
  id          String   @id @default(cuid())
  darkStoreId String   @map("dark_store_id")
  code        String
  type        BinType
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  darkStore     DarkStore       @relation(fields: [darkStoreId], references: [id], onDelete: Cascade)
  stock         BinStock[]
  movementsFrom StockMovement[] @relation("movement_from_bin")
  movementsTo   StockMovement[] @relation("movement_to_bin")
  counts        StockCount[]

  @@unique([darkStoreId, code])
  @@map("bins")
}

/// Units of a SKU in one bin. Changed only by the stock functions, together with a
/// stock_movements row, in one transaction.
model BinStock {
  binId     String   @map("bin_id")
  skuId     String   @map("sku_id")
  quantity  Int
  updatedAt DateTime @updatedAt @map("updated_at")

  bin Bin @relation(fields: [binId], references: [id], onDelete: Cascade)
  sku Sku @relation(fields: [skuId], references: [id])

  @@id([binId, skuId])
  @@index([skuId])
  @@map("bin_stock")
}

/// Per store and SKU. on_hand counts only units in pickable bins; reserved is held for
/// open orders. Available to sell = on_hand - reserved - stock buffer setting.
model StockLevel {
  darkStoreId String   @map("dark_store_id")
  skuId       String   @map("sku_id")
  onHand      Int      @default(0) @map("on_hand")
  reserved    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  darkStore DarkStore @relation(fields: [darkStoreId], references: [id], onDelete: Cascade)
  sku       Sku       @relation(fields: [skuId], references: [id])

  @@id([darkStoreId, skuId])
  @@index([skuId])
  @@map("stock_levels")
}

enum MovementType {
  /// Into a bin from outside (inbound manifest or opening stock)
  receive
  /// Between two bins of the same store (put away, damage, hold, release from hold)
  move
  reserve
  release
  /// Out of a pickable bin for an order; also consumes the reservation
  pick
  /// Count or correction, up (to_bin) or down (from_bin)
  adjust
  /// Units leaving the store for good, for example back to the merchant
  dispatch

  @@map("movement_type")
}

/// Append only. Every stock change is one row here.
model StockMovement {
  id             String       @id @default(cuid())
  darkStoreId    String       @map("dark_store_id")
  skuId          String       @map("sku_id")
  type           MovementType
  /// Always positive; direction comes from the type and the bins
  quantity       Int
  fromBinId      String?      @map("from_bin_id")
  toBinId        String?      @map("to_bin_id")
  reason         String?
  orderId        String?      @map("order_id")
  manifestId     String?      @map("manifest_id")
  returnId       String?      @map("return_id")
  transferId     String?      @map("transfer_id")
  actorUserId    String?      @map("actor_user_id")
  /// Makes a retried job or request apply the movement only once
  idempotencyKey String?      @unique @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at")

  darkStore DarkStore        @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  sku       Sku              @relation(fields: [skuId], references: [id], onDelete: Restrict)
  fromBin   Bin?             @relation("movement_from_bin", fields: [fromBinId], references: [id], onDelete: Restrict)
  toBin     Bin?             @relation("movement_to_bin", fields: [toBinId], references: [id], onDelete: Restrict)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  manifest  InboundManifest? @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  return    MerchantReturn?  @relation(fields: [returnId], references: [id], onDelete: Restrict)
  transfer  Transfer?        @relation(fields: [transferId], references: [id], onDelete: Restrict)
  damage    DamageReport?
  actor     User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([darkStoreId, skuId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

// ─── Stock counts ──────────────────────────────────────────────────────────────

enum CountStatus {
  /// Waiting for admin approval
  submitted
  approved
  rejected
  /// The bin changed between counting and approval; count it again
  stale

  @@map("count_status")
}

/// A count of one bin by store staff. Differences change stock only after admin approval.
model StockCount {
  id            String      @id @default(cuid())
  darkStoreId   String      @map("dark_store_id")
  binId         String      @map("bin_id")
  status        CountStatus @default(submitted)
  submittedById String      @map("submitted_by_id")
  reviewedById  String?     @map("reviewed_by_id")
  reviewedAt    DateTime?   @map("reviewed_at")
  reviewNote    String?     @map("review_note")
  createdAt     DateTime    @default(now()) @map("created_at")

  darkStore   DarkStore        @relation(fields: [darkStoreId], references: [id])
  bin         Bin              @relation(fields: [binId], references: [id])
  submittedBy User             @relation("count_submitted_by", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?            @relation("count_reviewed_by", fields: [reviewedById], references: [id], onDelete: Restrict)
  lines       StockCountLine[]

  @@index([status, createdAt])
  @@index([darkStoreId, createdAt])
  @@map("stock_counts")
}

model StockCountLine {
  id          String @id @default(cuid())
  countId     String @map("count_id")
  skuId       String @map("sku_id")
  /// What the system had in the bin when the count was submitted
  expectedQty Int    @map("expected_qty")
  countedQty  Int    @map("counted_qty")

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  sku   Sku        @relation(fields: [skuId], references: [id])

  @@unique([countId, skuId])
  @@map("stock_count_lines")
}

// ─── Notifications ─────────────────────────────────────────────────────────────

/// Messages for merchants, shown in the merchant panel. Other channels (email,
/// WhatsApp) can be added behind the Notifier interface without changing callers.
model Notification {
  id         String    @id @default(cuid())
  merchantId String    @map("merchant_id")
  type       String
  data       Json
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Inbound ───────────────────────────────────────────────────────────────────

enum ManifestStatus {
  /// Created by the merchant, on its way to the store
  expected
  receiving
  received
  cancelled

  @@map("manifest_status")
}

model InboundManifest {
  id          String         @id @default(cuid())
  darkStoreId String         @map("dark_store_id")
  merchantId  String         @map("merchant_id")
  /// Merchant or carrier reference printed on the delivery note
  reference   String
  status      ManifestStatus @default(expected)
  note        String?
  createdById String?        @map("created_by_id")
  expectedAt  DateTime?      @map("expected_at")
  receivedAt  DateTime?      @map("received_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  darkStore      DarkStore             @relation(fields: [darkStoreId], references: [id])
  merchant       Merchant              @relation(fields: [merchantId], references: [id])
  createdBy      User?                 @relation("manifest_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  lines          InboundManifestLine[]
  stockMovements StockMovement[]

  @@unique([merchantId, reference])
  @@index([darkStoreId, status])
  @@map("inbound_manifests")
}

model InboundManifestLine {
  id          String @id @default(cuid())
  manifestId  String @map("manifest_id")
  skuId       String @map("sku_id")
  expectedQty Int    @map("expected_qty")
  receivedQty Int    @default(0) @map("received_qty")

  manifest InboundManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  sku      Sku             @relation(fields: [skuId], references: [id])

  @@unique([manifestId, skuId])
  @@map("inbound_manifest_lines")
}

// ─── Outbound: stock back to the merchant ──────────────────────────────────────

enum ReturnStatus {
  requested
  picking
  ready
  collected
  cancelled

  @@map("return_status")
}

/// Which stock a return takes: sellable shelves, the damaged bin or the held bin
enum StockSource {
  sellable
  damaged
  held

  @@map("stock_source")
}

/// A merchant's request to take units out of a dark store. Sellable units are reserved at
/// once so orders cannot sell them; staff pick by scan and hand the parcel over.
model MerchantReturn {
  id             String       @id @default(cuid())
  reference      String
  darkStoreId    String       @map("dark_store_id")
  merchantId     String       @map("merchant_id")
  status         ReturnStatus @default(requested)
  note           String?
  createdById    String?      @map("created_by_id")
  readyAt        DateTime?    @map("ready_at")
  collectedAt    DateTime?    @map("collected_at")
  collectedBy    String?      @map("collected_by")
  handedOverById String?      @map("handed_over_by_id")
  cancelledAt    DateTime?    @map("cancelled_at")
  cancelReason   String?      @map("cancel_reason")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  darkStore      DarkStore            @relation(fields: [darkStoreId], references: [id])
  merchant       Merchant             @relation(fields: [merchantId], references: [id])
  createdBy      User?                @relation("return_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  handedOverBy   User?                @relation("return_handed_over_by", fields: [handedOverById], references: [id], onDelete: Restrict)
  lines          MerchantReturnLine[]
  stockMovements StockMovement[]

  @@unique([merchantId, reference])
  @@index([darkStoreId, status])
  @@map("merchant_returns")
}

model MerchantReturnLine {
  id        String      @id @default(cuid())
  returnId  String      @map("return_id")
  skuId     String      @map("sku_id")
  source    StockSource
  quantity  Int
  pickedQty Int         @default(0) @map("picked_qty")

  return MerchantReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  sku    Sku            @relation(fields: [skuId], references: [id])

  @@unique([returnId, skuId, source])
  @@map("merchant_return_lines")
}

// ─── Damage settlement ─────────────────────────────────────────────────────────

/// Why units were damaged. The company pays for store_handling and delivery; the merchant
/// bears arrived_damaged, customer and expired.
enum DamageCause {
  arrived_damaged
  store_handling
  delivery
  customer
  expired

  @@map("damage_cause")
}

enum DamageStatus {
  pending
  settled

  @@map("damage_status")
}

/// Units staff moved to the damaged bin, waiting for admin to settle who pays.
model DamageReport {
  id                   String       @id @default(cuid())
  darkStoreId          String       @map("dark_store_id")
  merchantId           String       @map("merchant_id")
  skuId                String       @map("sku_id")
  quantity             Int
  cause                DamageCause
  note                 String?
  riderId              String?      @map("rider_id")
  movementId           String       @unique @map("movement_id")
  status               DamageStatus @default(pending)
  reportedById         String       @map("reported_by_id")
  settledById          String?      @map("settled_by_id")
  settledAt            DateTime?    @map("settled_at")
  settleNote           String?      @map("settle_note")
  compensationPiastres Int          @default(0) @map("compensation_piastres")
  riderChargePiastres  Int          @default(0) @map("rider_charge_piastres")
  createdAt            DateTime     @default(now()) @map("created_at")

  darkStore  DarkStore     @relation(fields: [darkStoreId], references: [id])
  merchant   Merchant      @relation(fields: [merchantId], references: [id])
  sku        Sku           @relation(fields: [skuId], references: [id])
  rider      Rider?        @relation(fields: [riderId], references: [id])
  movement   StockMovement @relation(fields: [movementId], references: [id])
  reportedBy User          @relation("damage_reported_by", fields: [reportedById], references: [id])
  settledBy  User?         @relation("damage_settled_by", fields: [settledById], references: [id])

  @@index([status, createdAt])
  @@map("damage_reports")
}

/// A store's own refill levels for one product; without a row the store's default settings apply.
model StockTarget {
  darkStoreId String   @map("dark_store_id")
  skuId       String   @map("sku_id")
  minUnits    Int      @map("min_units")
  maxUnits    Int      @map("max_units")
  updatedAt   DateTime @updatedAt @map("updated_at")

  darkStore DarkStore @relation(fields: [darkStoreId], references: [id], onDelete: Cascade)
  sku       Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([darkStoreId, skuId])
  @@map("stock_targets")
}

// ─── Transfers between locations ──────────────────────────────────────────────

enum TransferStatus {
  draft
  approved
  picking
  in_transit
  received
  cancelled

  @@map("transfer_status")
}

enum TransferOrigin {
  manual
  refill

  @@map("transfer_origin")
}

/// One leg of moving stock between two locations. Store to store always goes through the
/// hub: the first leg ends at the hub and carries the final destination; when the hub closes
/// its receipt, the onward leg is created (or joins the open trip to that store).
model Transfer {
  id                 String         @id @default(cuid())
  reference          String         @unique
  fromId             String         @map("from_id")
  toId               String         @map("to_id")
  finalDestinationId String?        @map("final_destination_id")
  previousId         String?        @map("previous_id")
  status             TransferStatus
  origin             TransferOrigin @default(manual)
  /// Cairo day of the automatic refill run that made it (one trip per store per day)
  refillDay          String?        @map("refill_day")
  note               String?
  createdById        String?        @map("created_by_id")
  approvedById       String?        @map("approved_by_id")
  approvedAt         DateTime?      @map("approved_at")
  sentAt             DateTime?      @map("sent_at")
  receivedAt         DateTime?      @map("received_at")
  cancelledAt        DateTime?      @map("cancelled_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  from             DarkStore       @relation("transfer_from", fields: [fromId], references: [id])
  to               DarkStore       @relation("transfer_to", fields: [toId], references: [id])
  finalDestination DarkStore?      @relation("transfer_final", fields: [finalDestinationId], references: [id])
  previous         Transfer?       @relation("transfer_legs", fields: [previousId], references: [id])
  next             Transfer[]      @relation("transfer_legs")
  createdBy        User?           @relation("transfer_created_by", fields: [createdById], references: [id])
  approvedBy       User?           @relation("transfer_approved_by", fields: [approvedById], references: [id])
  lines            TransferLine[]
  stockMovements   StockMovement[]

  @@index([fromId, status])
  @@index([toId, status])
  @@map("transfers")
}

model TransferLine {
  id          String @id @default(cuid())
  transferId  String @map("transfer_id")
  skuId       String @map("sku_id")
  quantity    Int
  pickedQty   Int    @default(0) @map("picked_qty")
  receivedQty Int    @default(0) @map("received_qty")

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sku      Sku      @relation(fields: [skuId], references: [id])

  @@unique([transferId, skuId])
  @@map("transfer_lines")
}

// ─── Orders and delivery ───────────────────────────────────────────────────────

enum OrderStatus {
  new
  accepted
  picking
  packed
  out_for_delivery
  /// A delivery attempt failed and another is allowed: waiting for the goods and a decision
  attempt_failed
  delivered
  cancelled
  failed
  moved_to_standard

  @@map("order_status")
}

enum OrderSource {
  manual
  shopify

  @@map("order_source")
}

enum PaymentMethod {
  prepaid
  cod

  @@map("payment_method")
}

model Order {
  id                        String        @id @default(cuid())
  /// Human friendly number shown to staff and customers
  number                    String        @unique
  merchantId                String        @map("merchant_id")
  darkStoreId               String        @map("dark_store_id")
  shopifyOrderId            String?       @map("shopify_order_id")
  shopifyFulfillmentOrderId String?       @unique @map("shopify_fulfillment_order_id")
  source                    OrderSource   @default(manual)
  status                    OrderStatus   @default(new)
  zoneId                    String?       @map("zone_id")
  customerName              String        @map("customer_name")
  /// Normalized Egyptian mobile
  customerPhone             String        @map("customer_phone")
  addressText               String        @map("address_text")
  customerNote              String?       @map("customer_note")
  /// The phone is not a valid Egyptian mobile; staff should check it before dispatch
  phoneFlagged              Boolean       @default(false) @map("phone_flagged")
  /// Code the customer gives the rider to confirm delivery
  deliveryOtp               String        @map("delivery_otp")
  /// Unguessable key of the customer's public tracking page /t/<token>
  trackingToken             String        @unique @map("tracking_token")
  latitude                  Float?
  longitude                 Float?
  paymentMethod             PaymentMethod @map("payment_method")
  subtotalPiastres          Int           @map("subtotal_piastres")
  deliveryFeePiastres       Int           @default(0) @map("delivery_fee_piastres")
  /// Cash the rider must collect; 0 for prepaid orders
  codAmountPiastres         Int           @default(0) @map("cod_amount_piastres")
  placedAt                  DateTime      @map("placed_at")
  /// The promise to the customer: placed_at plus sla.promise_minutes
  slaDueAt                  DateTime?     @map("sla_due_at")
  /// When the SLA clock starts; later than placed_at for orders queued until the store opens
  slaStartsAt               DateTime?     @map("sla_starts_at")
  /// Shopify fulfillment created when the order left with a rider
  shopifyFulfillmentId      String?       @map("shopify_fulfillment_id")
  acceptedAt                DateTime?     @map("accepted_at")
  pickingStartedAt          DateTime?     @map("picking_started_at")
  pickedAt                  DateTime?     @map("picked_at")
  packedAt                  DateTime?     @map("packed_at")
  outForDeliveryAt          DateTime?     @map("out_for_delivery_at")
  deliveredAt               DateTime?     @map("delivered_at")
  /// When it reached cancelled, failed or moved_to_standard
  closedAt                  DateTime?     @map("closed_at")
  closedReason              String?       @map("closed_reason")
  /// The stage that is currently late (accept, pick, pack, handover, ride), if any
  lateStage                 String?       @map("late_stage")
  /// While attempt_failed: the order ends as failed if nobody retries it by then
  retryHoldUntil            DateTime?     @map("retry_hold_until")
  packPhotoId               String?       @map("pack_photo_id")
  createdById               String?       @map("created_by_id")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")
  /// The person across every merchant, linked by the customer jobs from the phone
  customerId                String?       @map("customer_id")
  /// The area the delivery decision found (resolveDelivery), when it found one
  geoAreaId                 String?       @map("geo_area_id")
  /// What decided the store: point, learned, chosen (area or zone picked), text
  resolvedBy                String?       @map("resolved_by")
  /// Where latitude and longitude came from: pin, shopify, geocoder, learned (null: no real point)
  locationSource            String?       @map("location_source")

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  geoArea        GeoArea?        @relation(fields: [geoAreaId], references: [id], onDelete: SetNull)
  deliveredPoint DeliveredPoint?
  merchant       Merchant        @relation(fields: [merchantId], references: [id])
  darkStore      DarkStore       @relation(fields: [darkStoreId], references: [id])
  zone           Zone?           @relation(fields: [zoneId], references: [id])
  packPhoto      Photo?          @relation("order_pack_photo", fields: [packPhotoId], references: [id])
  createdBy      User?           @relation("order_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  alerts         Alert[]
  items          OrderItem[]
  events         OrderEvent[]
  deliveries     Delivery[]
  stockMovements StockMovement[]

  ledgerEntries LedgerEntry[]

  shopifyOutbox ShopifyOutbox[]

  rating OrderRating?

  notes OrderNote[]

  @@index([darkStoreId, status, slaDueAt])
  @@index([merchantId, placedAt])
  @@index([status, placedAt])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                String @id @default(cuid())
  orderId           String @map("order_id")
  skuId             String @map("sku_id")
  quantity          Int
  unitPricePiastres Int    @map("unit_price_piastres")
  pickedQty         Int    @default(0) @map("picked_qty")
  /// Units cancelled because the store did not have them (at intake or at pick)
  cancelledQty      Int    @default(0) @map("cancelled_qty")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id])

  @@unique([orderId, skuId])
  @@map("order_items")
}

/// Append only history of everything that happened to an order.
model OrderEvent {
  id          String       @id @default(cuid())
  orderId     String       @map("order_id")
  type        String
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus? @map("to_status")
  actorUserId String?      @map("actor_user_id")
  data        Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Rider {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  darkStoreId    String    @map("dark_store_id")
  /// Printed on the rider's badge; scanned at hand over
  badgeCode      String    @unique @map("badge_code")
  vehicle        String?
  isAvailable    Boolean   @default(true) @map("is_available")
  /// Latest phone position while carrying orders (no history is kept)
  lastLat        Float?    @map("last_lat")
  lastLng        Float?    @map("last_lng")
  lastLocationAt DateTime? @map("last_location_at")
  /// Frozen (missed the cash deposit deadline): takes no orders and cannot withdraw until
  /// Accounting unfreezes them; the history is in rider_freezes
  frozenAt       DateTime? @map("frozen_at")
  /// deposit_deadline or deposit_rejected
  frozenReason   String?   @map("frozen_reason")
  /// Who froze them (null: the deadline job)
  frozenById     String?   @map("frozen_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  darkStore  DarkStore  @relation(fields: [darkStoreId], references: [id])
  deliveries Delivery[]

  ledgerAccounts LedgerAccount[]
  cashHandovers  CashHandover[]
  damageReports  DamageReport[]

  ledgerLines LedgerLine[]
  withdrawals RiderWithdrawal[]

  basataDeposits BasataDeposit[]
  cashDeductions RiderCashDeduction[]
  freezes        RiderFreeze[]

  @@map("riders")
}

enum DeliveryStatus {
  assigned
  picked_up
  delivered
  failed

  @@map("delivery_status")
}

model Delivery {
  id                   String         @id @default(cuid())
  orderId              String         @map("order_id")
  riderId              String         @map("rider_id")
  status               DeliveryStatus @default(assigned)
  /// Orders batched into one trip share a trip id
  tripId               String?        @map("trip_id")
  assignedAt           DateTime       @default(now()) @map("assigned_at")
  pickedUpAt           DateTime?      @map("picked_up_at")
  deliveredAt          DateTime?      @map("delivered_at")
  failedAt             DateTime?      @map("failed_at")
  failedReason         String?        @map("failed_reason")
  /// Times the rider called the customer from the app on this attempt
  callAttempts         Int            @default(0) @map("call_attempts")
  /// Photo at the door when the customer did not answer
  failedPhotoId        String?        @map("failed_photo_id")
  /// When staff took the goods of a failed attempt back at the store
  returnedAt           DateTime?      @map("returned_at")
  proofPhotoId         String?        @map("proof_photo_id")
  otpVerified          Boolean        @default(false) @map("otp_verified")
  /// What the rider had to collect when the order left the store
  codExpectedPiastres  Int            @default(0) @map("cod_expected_piastres")
  codCollectedPiastres Int?           @map("cod_collected_piastres")
  /// The rider's phone position when the delivery was marked done
  deliveredLat         Float?         @map("delivered_lat")
  deliveredLng         Float?         @map("delivered_lng")

  order       Order  @relation(fields: [orderId], references: [id])
  rider       Rider  @relation(fields: [riderId], references: [id])
  proofPhoto  Photo? @relation("delivery_proof_photo", fields: [proofPhotoId], references: [id])
  failedPhoto Photo? @relation("delivery_failed_photo", fields: [failedPhotoId], references: [id])

  @@index([riderId, status])
  @@index([orderId])
  @@index([assignedAt])
  @@map("deliveries")
}

/// A note on an order, append only. "team" notes are internal (admin, operations and the
/// order's store staff); "merchant" notes are a thread shared with the merchant's users.
model OrderNote {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  /// team or merchant
  audience  String
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  order  Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author User  @relation("order_note_author", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([orderId, audience, createdAt])
  @@map("order_notes")
}

/// A merchant who asked for rates through the contact form of the public website.
model SiteLead {
  id             String   @id @default(cuid())
  name           String
  /// +20 and 10 digits when it is a valid Egyptian mobile, otherwise kept as typed
  phone          String
  phoneValid     Boolean  @map("phone_valid")
  website        String?
  /// under_300, 300_1000, 1000_5000 or over_5000 orders a month
  ordersBand     String   @map("orders_band")
  /// The site language the visitor used (en or ar)
  locale         String
  /// The form's key for one submission, so a double tap creates one lead
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  /// The CRM company (and its deal) the submission opened; follow up lives there (docs/SALES.md)
  crmCompany CrmCompany?

  @@index([createdAt])
  @@map("site_leads")
}

/// The customer's 1 to 5 star rating, given once from the tracking page after delivery
model OrderRating {
  id        String   @id @default(cuid())
  orderId   String   @unique @map("order_id")
  stars     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([createdAt])
  @@map("order_ratings")
}

// ─── Photos and alerts ─────────────────────────────────────────────────────────

enum PhotoKind {
  pack
  delivery
  receipt
  /// The receipt a Basata branch gives a rider who deposited cash
  basata_receipt

  @@map("photo_kind")
}

/// Small JPEG photos (pack and delivery proof), stored in the database so any host works.
model Photo {
  id          String    @id @default(cuid())
  kind        PhotoKind
  contentType String    @map("content_type")
  data        Bytes
  sizeBytes   Int       @map("size_bytes")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy        User?            @relation("photo_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  packedFor        Order[]          @relation("order_pack_photo")
  deliveries       Delivery[]       @relation("delivery_proof_photo")
  failedDeliveries Delivery[]       @relation("delivery_failed_photo")
  financeReceipts  FinanceReceipt[]
  cheques          Cheque[]

  pettyCash     PettyCashExpense[]
  expenseClaims ExpenseClaim[]

  basataDeposits BasataDeposit[]

  @@map("photos")
}

/// Things admin should look at: late stages, items missing at pick, COD differences.
model Alert {
  id           String    @id @default(cuid())
  type         String
  darkStoreId  String?   @map("dark_store_id")
  orderId      String?   @map("order_id")
  /// For late alerts, which stage was late; makes the SLA check safe to run twice
  stage        String?
  data         Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")
  /// The merchant an alert is about: it goes to the merchant's account manager
  merchantId   String?   @map("merchant_id")
  /// Makes alerts not tied to an order safe to raise twice (document_expiring:<id>:<day>)
  key          String?   @unique

  darkStore  DarkStore? @relation(fields: [darkStoreId], references: [id])
  merchant   Merchant?  @relation(fields: [merchantId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])
  resolvedBy User?      @relation("alert_resolved_by", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([orderId, type, stage])
  @@index([resolvedAt, createdAt])
  @@index([createdAt])
  @@map("alerts")
}

// ─── System ────────────────────────────────────────────────────────────────────

/// Every configurable business value (SLA minutes, capacity, buffers...). scope is
/// "global" or a dark store id for a per store override.
model Setting {
  key         String
  scope       String   @default("global")
  value       Json
  description String?
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@id([key, scope])
  @@map("settings")
}

/// Append only record of who changed what, with the state before and after.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

// ─── Finance ───────────────────────────────────────────────────────────────────

enum PayoutSchedule {
  daily
  twice_weekly
  weekly

  @@map("payout_schedule")
}

/// What a ledger account represents. Asset accounts (cash, bank) normally have a debit
/// balance; what we owe (merchant, rider bonus, VAT) and income normally have a credit balance.
enum LedgerAccountType {
  /// What we owe the merchant: COD collected for them minus our fees
  merchant
  /// Cash on delivery a rider is carrying
  rider_cash
  /// Delivery bonuses owed to a rider
  rider_bonus
  /// The cash box of a dark store
  store_cash
  /// Company bank account
  bank
  /// Fee income
  revenue
  /// VAT charged on our fees, owed to the tax authority
  vat_payable
  /// Cost of rider delivery bonuses
  rider_bonus_expense
  /// Cash shortages written off, and cash surpluses
  cash_difference
  /// What the company pays for units damaged in its care
  damage_expense
  /// A company cash box that is not a dark store's (head office safe, petty cash)
  cash_box
  /// Other things we own (deposits paid, advances)
  other_asset
  /// Other things we owe (loans, accrued bills)
  other_liability
  /// Owner capital and drawings
  equity
  /// Income other than our fees (interest, sale of old equipment)
  other_income
  /// Running costs by category (rent, salaries, fuel, bank charges)
  expense
  /// Money advanced to a team member, recovered from their salary
  staff_advance
  /// What we owe a supplier for bills not yet paid
  supplier
  /// A merchant's security deposit we hold (paid back when the contract ends)
  merchant_deposit
  /// What a rider owes the company (cash shortages kept on them, damage charges, penalties);
  /// taken from their next withdrawal
  rider_dues

  @@map("ledger_account_type")
}

/// The five accounting categories; the first digit of an account code.
enum AccountCategory {
  asset
  liability
  equity
  revenue
  expense

  @@map("account_category")
}

/// One wallet or book account. The key is stable, for example "merchant:<id>" or "revenue".
model LedgerAccount {
  id            String            @id @default(cuid())
  key           String            @unique
  type          LedgerAccountType
  /// Chart of accounts number: 1101 for a company account, 2100-0001 for a party's wallet.
  /// Given automatically from the group's sequence.
  code          String            @unique
  category      AccountCategory
  /// The group (1100 banks, 5400 operating expenses...) the code was taken from
  groupCode     Int               @map("group_code")
  /// Party and store accounts have no name; they show their owner's name
  nameEn        String?           @map("name_en")
  nameAr        String?           @map("name_ar")
  bankName      String?           @map("bank_name")
  accountNumber String?           @map("account_number")
  iban          String?
  note          String?
  /// An expense category store staff may pick for petty cash
  petty         Boolean           @default(false)
  /// An expense category employees may claim back (paid from their own pocket)
  claimable     Boolean           @default(false)
  /// The currency a bank account is held in (EGP, USD, EUR); ledger amounts stay in EGP
  currency      String            @default("EGP")
  isActive      Boolean           @default(true) @map("is_active")
  merchantId    String?           @map("merchant_id")
  riderId       String?           @map("rider_id")
  darkStoreId   String?           @map("dark_store_id")
  /// The team member a staff advance wallet belongs to
  userId        String?           @map("user_id")
  /// The supplier a payable wallet belongs to
  supplierId    String?           @map("supplier_id")
  createdById   String?           @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  merchant         Merchant?           @relation(fields: [merchantId], references: [id])
  rider            Rider?              @relation(fields: [riderId], references: [id])
  darkStore        DarkStore?          @relation(fields: [darkStoreId], references: [id])
  user             User?               @relation("ledger_account_user", fields: [userId], references: [id], onDelete: Restrict)
  supplier         Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines            LedgerLine[]
  suppliersDefault Supplier[]          @relation("supplier_default_expense")
  bills            Bill[]
  prepayments      Prepayment[]
  bankStatements   BankStatement[]
  bankLines        BankStatementLine[] @relation("bank_line_account")
  budgets          Budget[]            @relation("budget_account")
  chequesBank      Cheque[]            @relation("cheque_bank")
  chequesIncome    Cheque[]            @relation("cheque_income")

  pettyCash     PettyCashExpense[]
  expenseClaims ExpenseClaim[]      @relation("expense_claim_account")
  claimsPaid    ExpenseClaim[]      @relation("expense_claim_paid_from")
  purchaseLines PurchaseOrderLine[]
  loansIn       Loan[]              @relation("loan_money_account")
  loansOwed     Loan[]              @relation("loan_liability_account")

  basataSettlements BasataSettlement[]

  @@index([type])
  @@index([groupCode])
  @@map("ledger_accounts")
}

/// One money event (append only). Its lines always add up to zero; the database checks it.
model LedgerEntry {
  id             String   @id @default(cuid())
  /// Gapless serial number shown as JV-000001
  number         Int      @unique
  /// cod_collected, order_fee, cod_fee, failed_fee, receiving_fee, storage_fee, rider_bonus,
  /// cash_handover, cash_difference, bank_deposit, merchant_payout, merchant_receipt,
  /// rider_bonus_payout, adjustment
  kind           String
  memo           String?
  occurredAt     DateTime @map("occurred_at")
  orderId        String?  @map("order_id")
  /// Same key twice means the same event: the second post is ignored
  idempotencyKey String   @unique @map("idempotency_key")
  data           Json?
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  order            Order?            @relation(fields: [orderId], references: [id])
  createdBy        User?             @relation("ledger_entry_created_by", fields: [createdById], references: [id])
  lines            LedgerLine[]
  receipts         FinanceReceipt[]
  requests         FinanceRequest[]
  bills            Bill[]
  prepayments      Prepayment[]
  fixedAssets      FixedAsset[]
  taxInvoices      TaxInvoice[]
  assetsDisposed   FixedAsset[]      @relation("asset_disposal")
  chequesBooked    Cheque[]          @relation("cheque_book_entry")
  chequesCleared   Cheque[]          @relation("cheque_clear_entry")
  chequesUndone    Cheque[]          @relation("cheque_reverse_entry")
  crmCommissions   CrmCommission[]
  riderWithdrawals RiderWithdrawal[]

  pettyCash         PettyCashExpense[] @relation("petty_cash_entry")
  pettyCashReversal PettyCashExpense[] @relation("petty_cash_reversal")
  expenseClaims     ExpenseClaim[]
  loans             Loan[]
  loanInstalments   LoanInstalment[]

  basataDeposits    BasataDeposit[]
  basataSettlements BasataSettlement[]
  cashDeductions    RiderCashDeduction[]

  @@index([kind, occurredAt])
  @@index([orderId])
  @@map("ledger_entries")
}

/// One side of an entry. Debit is positive, credit is negative, in piastres.
model LedgerLine {
  id             String   @id @default(cuid())
  entryId        String   @map("entry_id")
  accountId      String   @map("account_id")
  amountPiastres Int      @map("amount_piastres")
  occurredAt     DateTime @map("occurred_at")
  /// Where and for whom the line counts, for profit per store, merchant and rider
  darkStoreId    String?  @map("dark_store_id")
  merchantId     String?  @map("merchant_id")
  riderId        String?  @map("rider_id")
  /// The team member a salary or advance line is for
  userId         String?  @map("user_id")
  /// The user's own analytic tag (a campaign, a project), one per line at most
  costTagId      String?  @map("cost_tag_id")
  /// A line on a bank account in another currency: the amount in its cents (signed like the
  /// line) and the rate used (EGP for one unit × 1,000,000)
  foreignCents   Int?     @map("foreign_cents")
  fxRateMicro    BigInt?  @map("fx_rate_micro")

  entry     LedgerEntry        @relation(fields: [entryId], references: [id])
  account   LedgerAccount      @relation(fields: [accountId], references: [id])
  darkStore DarkStore?         @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  merchant  Merchant?          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  rider     Rider?             @relation(fields: [riderId], references: [id], onDelete: Restrict)
  user      User?              @relation("ledger_line_user", fields: [userId], references: [id], onDelete: Restrict)
  costTag   CostTag?           @relation(fields: [costTagId], references: [id], onDelete: Restrict)
  bankLine  BankStatementLine?
  /// Part of a bank line proven by several ledger lines
  bankMatch BankLineMatch?

  @@index([accountId, occurredAt])
  @@index([darkStoreId, occurredAt])
  @@index([merchantId, occurredAt])
  @@index([riderId, occurredAt])
  @@index([costTagId, occurredAt])
  @@map("ledger_lines")
}

enum CashHandoverStatus {
  /// Counted cash matched what the rider carried
  balanced
  /// There is a difference waiting for finance or admin
  pending
  /// The difference was written off as a company loss (or kept as surplus)
  written_off
  /// The difference stays on the rider's wallet to be recovered
  charged_to_rider

  @@map("cash_handover_status")
}

/// A rider handing collected cash to a dark store, counted by staff.
model CashHandover {
  id                 String             @id @default(cuid())
  /// Gapless serial number shown as CH-000001
  number             Int                @unique
  riderId            String             @map("rider_id")
  darkStoreId        String             @map("dark_store_id")
  expectedPiastres   Int                @map("expected_piastres")
  countedPiastres    Int                @map("counted_piastres")
  /// expected minus counted: positive means cash is short
  differencePiastres Int                @map("difference_piastres")
  status             CashHandoverStatus
  note               String?
  receivedById       String             @map("received_by_id")
  reviewedById       String?            @map("reviewed_by_id")
  reviewedAt         DateTime?          @map("reviewed_at")
  reviewNote         String?            @map("review_note")
  idempotencyKey     String             @unique @map("idempotency_key")
  createdAt          DateTime           @default(now()) @map("created_at")

  rider      Rider     @relation(fields: [riderId], references: [id])
  darkStore  DarkStore @relation(fields: [darkStoreId], references: [id])
  receivedBy User      @relation("handover_received_by", fields: [receivedById], references: [id])
  reviewedBy User?     @relation("handover_reviewed_by", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([riderId, createdAt])
  @@map("cash_handovers")
}

enum PayoutStatus {
  draft
  paid
  cancelled

  @@map("payout_status")
}

enum RiderWithdrawalStatus {
  requested
  approved
  paid
  rejected
  cancelled

  @@map("rider_withdrawal_status")
}

enum RiderWithdrawalMethod {
  store_cash
  instapay
  mobile_wallet
  bank

  @@map("rider_withdrawal_method")
}

/// A rider asks for earnings that finished their hold (RW-000001, gapless). What they owe
/// is deducted in the same entry; nothing moves until Accounting (or the store manager for
/// cash at the store) marks it paid.
model RiderWithdrawal {
  id                String                @id @default(cuid())
  number            Int                   @unique
  riderId           String                @map("rider_id")
  darkStoreId       String                @map("dark_store_id")
  /// What the rider receives
  amountPiastres    Int                   @map("amount_piastres")
  /// What is taken back from the wallet for what the rider owes
  deductionPiastres Int                   @default(0) @map("deduction_piastres")
  /// { dues, advance } in piastres, as shown to the rider
  deductions        Json
  method            RiderWithdrawalMethod
  /// instapay: handle; mobile_wallet: provider and number; bank: bank, iban, holder
  details           Json
  status            RiderWithdrawalStatus @default(requested)
  idempotencyKey    String                @unique @map("idempotency_key")
  approvedById      String?               @map("approved_by_id")
  approvedAt        DateTime?             @map("approved_at")
  paidById          String?               @map("paid_by_id")
  paidAt            DateTime?             @map("paid_at")
  /// The bank or cash box it was paid from
  paidFromAccountId String?               @map("paid_from_account_id")
  reference         String?
  entryId           String?               @map("entry_id")
  rejectedById      String?               @map("rejected_by_id")
  rejectedAt        DateTime?             @map("rejected_at")
  rejectReason      String?               @map("reject_reason")
  cancelledAt       DateTime?             @map("cancelled_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  rider      Rider        @relation(fields: [riderId], references: [id])
  darkStore  DarkStore    @relation(fields: [darkStoreId], references: [id])
  approvedBy User?        @relation("rider_withdrawal_approved_by", fields: [approvedById], references: [id])
  paidBy     User?        @relation("rider_withdrawal_paid_by", fields: [paidById], references: [id])
  rejectedBy User?        @relation("rider_withdrawal_rejected_by", fields: [rejectedById], references: [id])
  entry      LedgerEntry? @relation(fields: [entryId], references: [id])

  @@index([riderId, status])
  @@index([status, createdAt])
  @@map("rider_withdrawals")
}

/// Money we owe a merchant up to a cutoff, prepared by finance and marked paid by hand.
model Payout {
  id             String       @id @default(cuid())
  /// Gapless serial number shown as PAY-000001
  number         Int          @unique
  merchantId     String       @map("merchant_id")
  cutoffAt       DateTime     @map("cutoff_at")
  amountPiastres Int          @map("amount_piastres")
  status         PayoutStatus @default(draft)
  reference      String?
  note           String?
  createdById    String       @map("created_by_id")
  paidById       String?      @map("paid_by_id")
  paidAt         DateTime?    @map("paid_at")
  /// The second person who approved a payout above finance.approval_threshold_piastres
  approvedById   String?      @map("approved_by_id")
  approvedAt     DateTime?    @map("approved_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  merchant   Merchant         @relation(fields: [merchantId], references: [id])
  createdBy  User             @relation("payout_created_by", fields: [createdById], references: [id])
  paidBy     User?            @relation("payout_paid_by", fields: [paidById], references: [id])
  approvedBy User?            @relation("payout_approved_by", fields: [approvedById], references: [id])
  receipts   FinanceReceipt[]
  cheques    Cheque[]

  @@index([merchantId, status])
  @@map("payouts")
}

// ─── Shopify ───────────────────────────────────────────────────────────────────

enum ShopifyShopStatus {
  /// Linked by admin, the merchant has not installed the app yet
  pending
  active
  uninstalled

  @@map("shopify_shop_status")
}

/// A merchant's Shopify store and our access to it. The token is encrypted at rest.
model ShopifyShop {
  id                    String            @id @default(cuid())
  /// The Shopify app this store installed: null is the main app (SHOPIFY_API_KEY); a custom
  /// distribution app made for one merchant otherwise.
  appId                 String?           @map("app_id")
  merchantId            String            @unique @map("merchant_id")
  shopDomain            String            @unique @map("shop_domain")
  status                ShopifyShopStatus @default(pending)
  accessTokenEnc        String?           @map("access_token_enc")
  /// Expiring offline tokens (required for public apps): the access token lasts about an hour
  /// and is renewed with the refresh token, which lasts 90 days. Null on a non expiring token.
  accessTokenExpiresAt  DateTime?         @map("access_token_expires_at")
  refreshTokenEnc       String?           @map("refresh_token_enc")
  refreshTokenExpiresAt DateTime?         @map("refresh_token_expires_at")
  scopes                String?
  installedAt           DateTime?         @map("installed_at")
  uninstalledAt         DateTime?         @map("uninstalled_at")
  /// The carrier service that answers checkout rates for this shop
  carrierServiceId      String?           @map("carrier_service_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  /// Store profile from Shopify (name, plan, currency, created), refreshed with each data sync
  profile      Json?
  dataSyncedAt DateTime? @map("data_synced_at")

  merchant  Merchant          @relation(fields: [merchantId], references: [id])
  locations ShopifyLocation[]
  outbox    ShopifyOutbox[]
  logs      ShopifyLog[]
  dataSyncs ShopDataSync[]
  app       ShopifyApp?       @relation(fields: [appId], references: [id], onDelete: Restrict)

  @@map("shopify_shops")
}

/// One fulfillment service (and its Shopify location) per merchant store and dark store.
/// Its id is part of the callback address Shopify calls.
model ShopifyLocation {
  id                   String    @id @default(cuid())
  shopId               String    @map("shop_id")
  darkStoreId          String    @map("dark_store_id")
  fulfillmentServiceId String    @map("fulfillment_service_id")
  locationId           String    @unique @map("location_id")
  isActive             Boolean   @default(true) @map("is_active")
  /// When the Shopify location's address was set to the dark store's address
  addressSyncedAt      DateTime? @map("address_synced_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  shop      ShopifyShop        @relation(fields: [shopId], references: [id])
  darkStore DarkStore          @relation(fields: [darkStoreId], references: [id])
  stock     ShopifyStockSync[]

  @@unique([shopId, darkStoreId])
  @@map("shopify_locations")
}

/// What Shopify was last told about one product at one location.
model ShopifyStockSync {
  locationId    String    @map("location_id")
  skuId         String    @map("sku_id")
  activated     Boolean   @default(false)
  lastPushedQty Int?      @map("last_pushed_qty")
  pushedAt      DateTime? @map("pushed_at")
  lastError     String?   @map("last_error")

  location ShopifyLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sku      Sku             @relation(fields: [skuId], references: [id])

  @@id([locationId, skuId])
  @@map("shopify_stock_sync")
}

/// Calls to Shopify that must happen, written in the same transaction as the change that
/// needs them and retried with growing delays until they succeed.
model ShopifyOutbox {
  id             String    @id @default(cuid())
  shopId         String    @map("shop_id")
  orderId        String?   @map("order_id")
  /// fulfill, delivered, failed, cancel_items
  kind           String
  payload        Json?
  idempotencyKey String    @unique @map("idempotency_key")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  doneAt         DateTime? @map("done_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")

  shop  ShopifyShop @relation(fields: [shopId], references: [id])
  order Order?      @relation(fields: [orderId], references: [id])

  @@index([doneAt, nextAttemptAt])
  @@map("shopify_outbox")
}

/// A readable trail of what came from and went to Shopify, for troubleshooting.
model ShopifyLog {
  id        String   @id @default(cuid())
  shopId    String?  @map("shop_id")
  direction String
  kind      String
  ok        Boolean
  message   String?
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  shop ShopifyShop? @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt])
  @@map("shopify_logs")
}

/// Checkout addresses already turned into map points; null coordinates mean not found
// ─── Area engine (address to zone without a paid lookup) ──────────────────────

/// One named area of Greater Cairo: governorate (1), city or district (2), neighbourhood (3),
/// compound or landmark (4), street (5). Names and spellings are stored already cleaned
/// (normalizeAddressText). Each area sits inside its parent, so matching narrows level by level.
model GeoArea {
  id           String                                      @id @default(cuid())
  /// Where it came from and its id there: gb:<id>, osm:<type>/<id>, admin:<cuid>
  ref          String                                      @unique
  level        Int
  parentId     String?                                     @map("parent_id")
  nameEn       String                                      @map("name_en")
  nameAr       String                                      @map("name_ar")
  aliases      String[]
  source       String
  isActive     Boolean                                     @default(true) @map("is_active")
  /// A duplicate merged into another area by the clean up (then inactive)
  mergedIntoId String?                                     @map("merged_into_id")
  geom         Unsupported("geometry(MultiPolygon, 4326)")
  createdAt    DateTime                                    @default(now()) @map("created_at")
  updatedAt    DateTime                                    @updatedAt @map("updated_at")

  parent      GeoArea?        @relation("geo_area_tree", fields: [parentId], references: [id])
  children    GeoArea[]       @relation("geo_area_tree")
  mergedInto  GeoArea?        @relation("geo_area_merged", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  merged      GeoArea[]       @relation("geo_area_merged")
  suggestions GeoSuggestion[]
  customers   Customer[]
  storeArea   StoreArea?
  orders      Order[]

  @@index([level])
  @@index([parentId])
  @@index([geom], type: Gist)
  @@map("geo_areas")
}

/// Which store serves an area (docs/ZONES.md). An area is served by its own row or, without
/// one, by its nearest ancestor's row; a row with no store marks the area as not served.
model StoreArea {
  geoAreaId   String   @id @map("geo_area_id")
  darkStoreId String?  @map("dark_store_id")
  zoneId      String?  @map("zone_id")
  /// Set by the move from drawn outlines when the area was split between stores
  needsReview Boolean  @default(false) @map("needs_review")
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  area      GeoArea    @relation(fields: [geoAreaId], references: [id], onDelete: Cascade)
  darkStore DarkStore? @relation(fields: [darkStoreId], references: [id], onDelete: Cascade)
  zone      Zone?      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("store_area_created_by", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([zoneId])
  @@index([darkStoreId])
  @@map("store_areas")
}

/// Where a rider stood when an order was delivered, keyed by its address text. Two deliveries
/// of the same text within 150 m make a trusted point for that address.
model DeliveredPoint {
  orderId    String   @id @map("order_id")
  addressKey String   @map("address_key")
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([addressKey])
  @@map("delivered_points")
}

/// Words Google placed in an area the engine did not recognise. Admin approves them as a new
/// name of that area (or rejects them), so the engine learns and Google is needed less.
model GeoSuggestion {
  id            String    @id @default(cuid())
  phrase        String
  areaId        String    @map("area_id")
  sampleAddress String    @map("sample_address")
  seen          Int       @default(1)
  status        String    @default("pending")
  decidedById   String?   @map("decided_by_id")
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  area GeoArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([phrase, areaId])
  @@index([status, seen])
  @@map("geo_suggestions")
}

model GeocodeCache {
  addressKey String   @id @map("address_key")
  latitude   Float?
  longitude  Float?
  /// How the point was found: engine, google, osm
  method     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("geocode_cache")
}

enum TicketStatus {
  /// Waiting for the person it is assigned to
  open
  /// The assignee answered; waiting for the person who asked
  answered
  /// Done
  closed

  @@map("ticket_status")
}

enum TicketPriority {
  normal
  urgent

  @@map("ticket_priority")
}

/// A question or task from one team member to another, mirrored in Slack when connected.
model Ticket {
  id             String         @id @default(cuid())
  /// Gapless serial number shown as TCK-000001
  number         Int            @unique
  title          String
  priority       TicketPriority @default(normal)
  status         TicketStatus   @default(open)
  createdById    String         @map("created_by_id")
  assigneeId     String         @map("assignee_id")
  /// Optional record the ticket is about, for example order / <id>
  relatedType    String?        @map("related_type")
  relatedId      String?        @map("related_id")
  /// The answer is due by then (settings ticket.*_answer_minutes)
  dueAt          DateTime       @map("due_at")
  /// The assignee opened it in Shiply, acknowledged it in Slack or replied
  readAt         DateTime?      @map("read_at")
  answeredAt     DateTime?      @map("answered_at")
  closedAt       DateTime?      @map("closed_at")
  /// Reminders already sent, so the job sends each once
  readReminderAt DateTime?      @map("read_reminder_at")
  lateNoticeAt   DateTime?      @map("late_notice_at")
  /// The Slack conversation and thread the ticket lives in
  slackChannel   String?        @map("slack_channel")
  slackThreadTs  String?        @map("slack_thread_ts")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  createdBy User            @relation("ticket_created_by", fields: [createdById], references: [id])
  assignee  User            @relation("ticket_assignee", fields: [assigneeId], references: [id])
  messages  TicketMessage[]

  @@unique([slackChannel, slackThreadTs])
  @@index([assigneeId, status])
  @@index([createdById, status])
  @@index([status, dueAt])
  @@map("tickets")
}

/// One message on a ticket, written in Shiply or in the Slack thread (append only).
model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  /// Null when written in Slack by someone not linked to a Shiply user
  authorId   String?  @map("author_id")
  authorName String   @map("author_name")
  /// app or slack
  source     String
  body       String
  /// The Slack message, so a Slack event delivered twice is kept once
  slackTs    String?  @map("slack_ts")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id])

  @@unique([ticketId, slackTs])
  @@index([ticketId, createdAt])
  @@index([createdAt])
  @@map("ticket_messages")
}

/// One data export from a merchant's Shopify store (bulk operation): products, inventory or orders.
model ShopDataSync {
  id              String    @id @default(cuid())
  shopId          String    @map("shop_id")
  /// products, inventory, orders
  kind            String
  /// running, done, failed
  status          String    @default("running")
  bulkOperationId String?   @map("bulk_operation_id")
  /// Only records changed since then (null: everything)
  since           DateTime?
  objectCount     Int       @default(0) @map("object_count")
  /// Fields Shopify refused and the export left out (for example order addresses)
  limited         String?
  /// An orders export run with read_all_orders granted (every order, not only the last 60 days)
  allOrders       Boolean   @default(false) @map("all_orders")
  error           String?
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  shop ShopifyShop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, kind, startedAt])
  @@map("shop_data_syncs")
}

/// A product as it is in the merchant's Shopify store (every product, not only what we stock).
model ShopProduct {
  id             String    @id @default(cuid())
  shopId         String    @map("shop_id")
  merchantId     String    @map("merchant_id")
  shopifyId      String    @unique @map("shopify_id")
  title          String
  handle         String?
  /// ACTIVE, DRAFT, ARCHIVED, UNLISTED
  status         String
  vendor         String?
  productType    String?   @map("product_type")
  /// Shopify standard product taxonomy, for example "Apparel & Accessories > Clothing > Dresses"
  categoryId     String?   @map("category_id")
  categoryName   String?   @map("category_name")
  /// Top level of the taxonomy (or the product type), used to compare merchants
  categoryTop    String?   @map("category_top")
  tags           String[]
  imageUrl       String?   @map("image_url")
  mediaCount     Int       @default(0) @map("media_count")
  totalInventory Int       @default(0) @map("total_inventory")
  createdAtShop  DateTime? @map("created_at_shop")
  updatedAtShop  DateTime? @map("updated_at_shop")
  publishedAt    DateTime? @map("published_at")
  raw            Json
  syncedAt       DateTime  @default(now()) @updatedAt @map("synced_at")

  variants ShopVariant[]

  @@index([merchantId, status])
  @@index([categoryTop])
  @@map("shop_products")
}

model ShopVariant {
  id                String    @id @default(cuid())
  shopId            String    @map("shop_id")
  productShopifyId  String    @map("product_shopify_id")
  shopifyId         String    @unique @map("shopify_id")
  inventoryItemId   String?   @unique @map("inventory_item_id")
  title             String
  sku               String?
  barcode           String?
  pricePiastres     Int       @default(0) @map("price_piastres")
  compareAtPiastres Int?      @map("compare_at_piastres")
  costPiastres      Int?      @map("cost_piastres")
  weightGrams       Int?      @map("weight_grams")
  inventoryQuantity Int       @default(0) @map("inventory_quantity")
  options           Json?
  createdAtShop     DateTime? @map("created_at_shop")
  updatedAtShop     DateTime? @map("updated_at_shop")
  raw               Json

  product ShopProduct @relation(fields: [productShopifyId], references: [shopifyId], onDelete: Cascade)

  @@index([shopId, sku])
  @@map("shop_variants")
}

/// Stock of one item at one of the merchant's own Shopify locations (their warehouses and ours).
model ShopInventoryLevel {
  id              String   @id @default(cuid())
  shopId          String   @map("shop_id")
  inventoryItemId String   @map("inventory_item_id")
  locationId      String   @map("location_id")
  locationName    String   @map("location_name")
  /// Our dark store fulfillment service, not the merchant's own warehouse
  ours            Boolean  @default(false)
  available       Int      @default(0)
  onHand          Int      @default(0) @map("on_hand")
  committed       Int      @default(0)
  incoming        Int      @default(0)
  syncedAt        DateTime @default(now()) @updatedAt @map("synced_at")

  @@unique([inventoryItemId, locationId])
  @@index([shopId])
  @@map("shop_inventory_levels")
}

/// A merchant's Shopify order (all channels, not only 60 minute ones). No customer names,
/// phones, emails or street addresses are kept.
model ShopOrder {
  id                String    @id @default(cuid())
  shopId            String    @map("shop_id")
  merchantId        String    @map("merchant_id")
  shopifyId         String    @unique @map("shopify_id")
  name              String
  createdAtShop     DateTime  @map("created_at_shop")
  processedAt       DateTime? @map("processed_at")
  updatedAtShop     DateTime? @map("updated_at_shop")
  cancelledAt       DateTime? @map("cancelled_at")
  financialStatus   String?   @map("financial_status")
  fulfillmentStatus String?   @map("fulfillment_status")
  currency          String
  subtotalPiastres  Int       @default(0) @map("subtotal_piastres")
  discountsPiastres Int       @default(0) @map("discounts_piastres")
  shippingPiastres  Int       @default(0) @map("shipping_piastres")
  taxPiastres       Int       @default(0) @map("tax_piastres")
  totalPiastres     Int       @default(0) @map("total_piastres")
  refundedPiastres  Int       @default(0) @map("refunded_piastres")
  units             Int       @default(0)
  sourceName        String?   @map("source_name")
  province          String?
  city              String?
  country           String?
  tags              String[]
  test              Boolean   @default(false)
  raw               Json
  /// The person behind the order across every merchant, when the order names a phone or email
  customerId        String?   @map("customer_id")
  customerShopifyId String?   @map("customer_shopify_id")
  /// The delivery point: the customer's pin (_shiplynow_pin) or Shopify's point of the address
  latitude          Float?
  longitude         Float?
  /// pin or shopify
  pointSource       String?   @map("point_source")
  /// Payment gateways as Shopify names them ("Cash on Delivery (COD)", "Shopify Payments")
  paymentGateways   String[]  @default([]) @map("payment_gateways")
  /// From the gateways: cod, card or other (null when none is named)
  paymentMethod     String?   @map("payment_method")
  /// The shipping line chosen at checkout; SN60:<store code> is our 60 minute rate
  shippingCode      String?   @map("shipping_code")
  shippingTitle     String?   @map("shipping_title")
  /// The customer chose our 60 minute delivery (shipping code SN60:...)
  express           Boolean   @default(false)
  discountCodes     String[]  @default([]) @map("discount_codes")
  /// CUSTOMER, DECLINED, FRAUD, INVENTORY, OTHER, STAFF
  cancelReason      String?   @map("cancel_reason")
  /// The order's custom attributes as { key: value } (our _shiplynow_zone, _area, _pin)
  customAttributes  Json?     @map("custom_attributes")

  lines    ShopOrderLine[]
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAtShop])
  @@index([customerId])
  @@index([customerShopifyId])
  @@map("shop_orders")
}

model ShopOrderLine {
  id                String  @id @default(cuid())
  orderShopifyId    String  @map("order_shopify_id")
  shopifyId         String  @unique @map("shopify_id")
  productShopifyId  String? @map("product_shopify_id")
  variantShopifyId  String? @map("variant_shopify_id")
  sku               String?
  title             String
  vendor            String?
  quantity          Int
  /// Still on the order after removals and refunds
  currentQuantity   Int     @map("current_quantity")
  unitPricePiastres Int     @map("unit_price_piastres")
  discountPiastres  Int     @default(0) @map("discount_piastres")
  totalPiastres     Int     @map("total_piastres")

  order ShopOrder @relation(fields: [orderShopifyId], references: [shopifyId], onDelete: Cascade)

  @@index([productShopifyId])
  @@map("shop_order_lines")
}

/// One person across every merchant and our own deliveries, matched by Egyptian mobile first,
/// then by email. Admin only; every profile view is audited.
model Customer {
  id          String    @id @default(cuid())
  /// +20 followed by 10 digits
  phone       String?   @unique
  /// Lower case
  email       String?   @unique
  name        String    @default("")
  governorate String?
  city        String?
  /// The latest delivery address seen
  address     String?
  /// The latest delivery point: our own orders, or a Shopify order's pin or map point
  latitude    Float?
  longitude   Float?
  /// The district (geo_areas level 2) the customer lives in, from the point or the address
  districtId  String?   @map("district_id")
  /// When the district was last worked out; done again after the customer changes
  locatedAt   DateTime? @map("located_at")
  firstSeenAt DateTime  @map("first_seen_at")
  lastSeenAt  DateTime  @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  district      GeoArea?        @relation(fields: [districtId], references: [id], onDelete: SetNull)
  shopCustomers ShopCustomer[]
  shopOrders    ShopOrder[]
  orders        Order[]
  aliases       CustomerAlias[]

  @@index([districtId])
  @@map("customers")
}

/// Other phones and emails of a customer, kept when admin merges two profiles of one person
/// so new orders with either still find the same profile.
model CustomerAlias {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  /// phone or email
  kind       String
  value      String
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([kind, value])
  @@index([customerId])
  @@map("customer_aliases")
}

/// A customer record in one merchant's Shopify store.
model ShopCustomer {
  id                  String    @id @default(cuid())
  shopId              String    @map("shop_id")
  merchantId          String    @map("merchant_id")
  shopifyId           String    @unique @map("shopify_id")
  customerId          String?   @map("customer_id")
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  email               String?
  phone               String?
  state               String?
  ordersCount         Int       @default(0) @map("orders_count")
  amountSpentPiastres Int       @default(0) @map("amount_spent_piastres")
  emailMarketing      String?   @map("email_marketing")
  smsMarketing        String?   @map("sms_marketing")
  /// The customer's language in the store (for example ar or en)
  locale              String?
  province            String?
  city                String?
  tags                String[]
  createdAtShop       DateTime? @map("created_at_shop")
  updatedAtShop       DateTime? @map("updated_at_shop")
  raw                 Json
  syncedAt            DateTime  @default(now()) @updatedAt @map("synced_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([merchantId])
  @@map("shop_customers")
}

/// A Shopify app other than the main one: a custom distribution app made in the Partner
/// Dashboard for one merchant (no App Store review). Its client secret is stored sealed.
model ShopifyApp {
  id              String   @id @default(cuid())
  name            String
  clientId        String   @unique @map("client_id")
  clientSecretEnc String   @map("client_secret_enc")
  createdAt       DateTime @default(now()) @map("created_at")

  shops ShopifyShop[]

  @@map("shopify_apps")
}

// ─── Accounting controls ───────────────────────────────────────────────────────

/// The books are closed through closed_through (a Cairo day): nothing may be posted before
/// locked_before, which a database trigger enforces too.
model BooksLock {
  id            String   @id @default("books")
  closedThrough DateTime @map("closed_through") @db.Date
  lockedBefore  DateTime @map("locked_before")
  updatedById   String   @map("updated_by_id")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  updatedBy User @relation(fields: [updatedById], references: [id])

  @@map("books_lock")
}

enum FinanceRequestStatus {
  pending
  approved
  rejected
  cancelled

  @@map("finance_request_status")
}

/// An expense or drawing above the approval limit, waiting for a second person.
model FinanceRequest {
  id             String               @id @default(cuid())
  /// expense or drawings
  kind           String
  amountPiastres Int                  @map("amount_piastres")
  /// The movement as it was entered, posted as is once approved
  payload        Json
  status         FinanceRequestStatus @default(pending)
  requestedById  String               @map("requested_by_id")
  decidedById    String?              @map("decided_by_id")
  decidedAt      DateTime?            @map("decided_at")
  decisionNote   String?              @map("decision_note")
  entryId        String?              @map("entry_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  requestedBy User             @relation("finance_request_by", fields: [requestedById], references: [id])
  decidedBy   User?            @relation("finance_request_decided_by", fields: [decidedById], references: [id])
  entry       LedgerEntry?     @relation(fields: [entryId], references: [id])
  receipts    FinanceReceipt[]

  pettyCash PettyCashExpense[]

  @@index([status, createdAt])
  @@map("finance_requests")
}

/// A receipt or transfer slip photo attached to one entry, payout or request.
model FinanceReceipt {
  id          String   @id @default(cuid())
  photoId     String   @map("photo_id")
  entryId     String?  @map("entry_id")
  payoutId    String?  @map("payout_id")
  requestId   String?  @map("request_id")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  photo     Photo           @relation(fields: [photoId], references: [id])
  entry     LedgerEntry?    @relation(fields: [entryId], references: [id], onDelete: Restrict)
  payout    Payout?         @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  request   FinanceRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  createdBy User            @relation(fields: [createdById], references: [id])

  @@index([entryId])
  @@index([payoutId])
  @@index([requestId])
  @@map("finance_receipts")
}

/// Someone we buy from: rent, internet, packaging, fuel.
model Supplier {
  id                      String   @id @default(cuid())
  name                    String   @unique
  taxId                   String?  @map("tax_id")
  phone                   String?
  email                   String?
  /// Withholding tax deducted from each payment, basis points of the amount before VAT
  whtBp                   Int      @default(0) @map("wht_bp")
  defaultExpenseAccountId String?  @map("default_expense_account_id")
  /// A rider supply office: riders linked to it (HR file, outsourced through it) earn it a
  /// commission on their pay per delivered order, billed monthly (CLAUDE.md "Rider offices")
  isRiderOffice           Boolean  @default(false) @map("is_rider_office")
  /// The office's commission, basis points of the rider pay (2000 = 20%)
  commissionBp            Int      @default(0) @map("commission_bp")
  isActive                Boolean  @default(true) @map("is_active")
  createdById             String   @map("created_by_id")
  createdAt               DateTime @default(now()) @map("created_at")

  defaultExpenseAccount LedgerAccount?       @relation("supplier_default_expense", fields: [defaultExpenseAccountId], references: [id])
  createdBy             User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  accounts              LedgerAccount[]
  bills                 Bill[]
  staff                 Employee[]           @relation("staffing_supplier")
  cheques               Cheque[]
  purchaseOrders        PurchaseOrder[]
  loans                 Loan[]
  riderCashDeductions   RiderCashDeduction[]

  @@map("suppliers")
}

enum BillStatus {
  open
  paid
  cancelled

  @@map("bill_status")
}

/// A supplier's bill, owed until paid (in one or several payments).
model Bill {
  id               String     @id @default(cuid())
  /// Gapless serial number shown as BILL-000001
  number           Int        @unique
  supplierId       String     @map("supplier_id")
  /// The supplier's own invoice number
  reference        String
  billDate         DateTime   @map("bill_date") @db.Date
  dueDate          DateTime   @map("due_date") @db.Date
  expenseAccountId String     @map("expense_account_id")
  darkStoreId      String?    @map("dark_store_id")
  netPiastres      Int        @map("net_piastres")
  vatPiastres      Int        @default(0) @map("vat_piastres")
  totalPiastres    Int        @map("total_piastres")
  whtBp            Int        @default(0) @map("wht_bp")
  paidPiastres     Int        @default(0) @map("paid_piastres")
  status           BillStatus @default(open)
  memo             String?
  entryId          String?    @map("entry_id")
  /// The person the bill is for (an outsourced worker's month)
  userId           String?    @map("user_id")
  /// EGP, or the currency the supplier billed in (USD...)
  currency         String     @default("EGP")
  /// EGP for one unit of the currency × 1,000,000
  fxRateMicro      BigInt?    @map("fx_rate_micro")
  /// The bill in its own currency, in cents
  foreignTotal     Int?       @map("foreign_total")
  foreignPaid      Int        @default(0) @map("foreign_paid")
  /// The purchase order the bill was made from (its lines decide the accounts)
  purchaseOrderId  String?    @map("purchase_order_id")
  /// A rider office's monthly commission bill: the Cairo month it clears (YYYY-MM)
  officeMonth      String?    @map("office_month")
  createdById      String     @map("created_by_id")
  createdAt        DateTime   @default(now()) @map("created_at")

  person         User?          @relation("bill_person", fields: [userId], references: [id], onDelete: Restrict)
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  expenseAccount LedgerAccount  @relation(fields: [expenseAccountId], references: [id], onDelete: Restrict)
  darkStore      DarkStore?     @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  entry          LedgerEntry?   @relation(fields: [entryId], references: [id], onDelete: Restrict)
  createdBy      User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  cheques        Cheque[]
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@unique([supplierId, officeMonth])
  @@index([status, dueDate])
  @@index([userId])
  @@map("bills")
}

/// An expense that repeats monthly, prepared on its day (through the second person rule).
model RecurringEntry {
  id             String   @id @default(cuid())
  name           String
  payload        Json
  amountPiastres Int      @map("amount_piastres")
  dayOfMonth     Int      @map("day_of_month")
  /// YYYY-MM
  startMonth     String   @map("start_month")
  endMonth       String?  @map("end_month")
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("recurring_entries")
}

/// Paid ahead and moved to expense month by month.
model Prepayment {
  id               String   @id @default(cuid())
  name             String
  expenseAccountId String   @map("expense_account_id")
  darkStoreId      String?  @map("dark_store_id")
  totalPiastres    Int      @map("total_piastres")
  months           Int
  /// YYYY-MM
  startMonth       String   @map("start_month")
  entryId          String   @map("entry_id")
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  expenseAccount LedgerAccount @relation(fields: [expenseAccountId], references: [id], onDelete: Restrict)
  darkStore      DarkStore?    @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  entry          LedgerEntry   @relation(fields: [entryId], references: [id], onDelete: Restrict)
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("prepayments")
}

/// Equipment bought once and depreciated straight line every month.
model FixedAsset {
  id              String    @id @default(cuid())
  name            String
  costPiastres    Int       @map("cost_piastres")
  salvagePiastres Int       @default(0) @map("salvage_piastres")
  lifeMonths      Int       @map("life_months")
  /// YYYY-MM, the first month of depreciation
  startMonth      String    @map("start_month")
  darkStoreId     String?   @map("dark_store_id")
  entryId         String    @map("entry_id")
  /// Sold or scrapped: no depreciation from that month on
  disposedAt      DateTime? @map("disposed_at")
  disposalEntryId String?   @map("disposal_entry_id")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  darkStore     DarkStore?   @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  entry         LedgerEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  disposalEntry LedgerEntry? @relation("asset_disposal", fields: [disposalEntryId], references: [id], onDelete: Restrict)
  createdBy     User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("fixed_assets")
}

/// A bank statement uploaded from the bank's Excel or CSV file.
model BankStatement {
  id          String   @id @default(cuid())
  /// Shown as BS-000001
  number      Int      @unique
  accountId   String   @map("account_id")
  fileName    String   @map("file_name")
  fromDay     DateTime @map("from_day") @db.Date
  toDay       DateTime @map("to_day") @db.Date
  lines       Int      @default(0)
  /// Lines already uploaded in an earlier statement
  skipped     Int      @default(0)
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account   LedgerAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  rows      BankStatementLine[]

  @@map("bank_statements")
}

enum BankLineStatus {
  unmatched
  matched
  ignored

  @@map("bank_line_status")
}

/// One line of a bank statement, matched to the ledger line it proves.
model BankStatementLine {
  id              String         @id @default(cuid())
  statementId     String         @map("statement_id")
  accountId       String         @map("account_id")
  lineNo          Int            @map("line_no")
  day             DateTime       @db.Date
  description     String
  reference       String?
  /// Money in positive, money out negative
  amountPiastres  Int            @map("amount_piastres")
  balancePiastres Int?           @map("balance_piastres")
  fingerprint     String
  status          BankLineStatus @default(unmatched)
  ledgerLineId    String?        @unique @map("ledger_line_id")
  note            String?
  decidedById     String?        @map("decided_by_id")
  decidedAt       DateTime?      @map("decided_at")

  statement    BankStatement   @relation(fields: [statementId], references: [id], onDelete: Restrict)
  account      LedgerAccount   @relation("bank_line_account", fields: [accountId], references: [id], onDelete: Restrict)
  ledgerLine   LedgerLine?     @relation(fields: [ledgerLineId], references: [id], onDelete: Restrict)
  decidedBy    User?           @relation("bank_line_decided_by", fields: [decidedById], references: [id])
  /// The other ledger lines when several lines add up to this bank line (the first is ledgerLineId)
  extraMatches BankLineMatch[]

  @@unique([accountId, fingerprint])
  @@index([accountId, status, day])
  @@map("bank_statement_lines")
}

/// A further ledger line proving a bank line, when several ledger lines add up to it exactly
/// (a deposit of several handovers). The first ledger line stays on bank_statement_lines.
model BankLineMatch {
  id           String   @id @default(cuid())
  bankLineId   String   @map("bank_line_id")
  ledgerLineId String   @unique @map("ledger_line_id")
  createdAt    DateTime @default(now()) @map("created_at")

  bankLine   BankStatementLine @relation(fields: [bankLineId], references: [id], onDelete: Cascade)
  ledgerLine LedgerLine        @relation(fields: [ledgerLineId], references: [id], onDelete: Restrict)

  @@index([bankLineId])
  @@map("bank_line_matches")
}

/// What we plan to earn or spend per account and month, for a store or company wide.
model Budget {
  id             String   @id @default(cuid())
  /// YYYY-MM
  month          String
  accountId      String   @map("account_id")
  darkStoreId    String?  @map("dark_store_id")
  amountPiastres Int      @map("amount_piastres")
  updatedById    String   @map("updated_by_id")
  updatedAt      DateTime @default(now()) @map("updated_at")

  account   LedgerAccount @relation("budget_account", fields: [accountId], references: [id], onDelete: Restrict)
  darkStore DarkStore?    @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  updatedBy User          @relation("budget_updated_by", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("budgets")
}

enum EmploymentType {
  employee
  outsourced

  @@map("employment_type")
}

/// How a person is paid: a monthly salary (the salary run) or per delivered order (riders,
/// through the rider wallet; never on the salary run, no tax or insurance)
enum PayBasis {
  monthly_salary
  per_delivery

  @@map("pay_basis")
}

/// Our own details as the tax authority knows them (one row, id "company").
model CompanyProfile {
  id                    String    @id @default("company")
  legalNameEn           String    @default("") @map("legal_name_en")
  legalNameAr           String    @default("") @map("legal_name_ar")
  taxRegistrationNumber String    @default("") @map("tax_registration_number")
  activityCode          String    @default("") @map("activity_code")
  branchId              String    @default("0") @map("branch_id")
  governorate           String    @default("")
  regionCity            String    @default("") @map("region_city")
  street                String    @default("")
  buildingNumber        String    @default("") @map("building_number")
  /// Item codes registered on the e-invoice portal, per fee kind
  itemCodes             Json      @default("{}") @map("item_codes")
  etaEnabled            Boolean   @default(false) @map("eta_enabled")
  signerKeyHash         String?   @map("signer_key_hash")
  signerKeyCreatedAt    DateTime? @map("signer_key_created_at")
  updatedById           String?   @map("updated_by_id")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  @@map("company_profile")
}

enum TaxDocumentType {
  invoice
  credit_note
  /// DN-000001: charges a merchant more after an invoice (migration 20261231170000)
  debit_note

  @@map("tax_document_type")
}

enum EtaStatus {
  not_sent
  signed
  submitted
  valid
  invalid
  rejected

  @@map("eta_status")
}

/// A tax invoice to a merchant for our fees, or a credit note against one.
model TaxInvoice {
  id              String          @id @default(cuid())
  type            TaxDocumentType
  /// INV-000001 or CN-000001, gapless per type
  number          Int
  merchantId      String          @map("merchant_id")
  /// YYYY-MM for a monthly invoice
  periodMonth     String?         @map("period_month")
  issuedAt        DateTime        @default(now()) @map("issued_at")
  originalId      String?         @map("original_id")
  reason          String?
  netPiastres     Int             @map("net_piastres")
  vatPiastres     Int             @map("vat_piastres")
  totalPiastres   Int             @map("total_piastres")
  entryId         String?         @map("entry_id")
  etaStatus       EtaStatus       @default(not_sent) @map("eta_status")
  etaUuid         String?         @map("eta_uuid")
  etaLongId       String?         @map("eta_long_id")
  etaSubmissionId String?         @map("eta_submission_id")
  etaError        Json?           @map("eta_error")
  etaCheckedAt    DateTime?       @map("eta_checked_at")
  document        Json?
  canonical       String?
  signature       String?
  createdById     String          @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  merchant    Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  original    TaxInvoice?      @relation("credit_notes", fields: [originalId], references: [id], onDelete: Restrict)
  creditNotes TaxInvoice[]     @relation("credit_notes")
  entry       LedgerEntry?     @relation(fields: [entryId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("tax_invoice_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  lines       TaxInvoiceLine[]

  @@unique([type, number])
  @@index([etaStatus])
  @@map("tax_invoices")
}

model TaxInvoiceLine {
  id            String @id @default(cuid())
  invoiceId     String @map("invoice_id")
  lineNo        Int    @map("line_no")
  kind          String
  descriptionEn String @map("description_en")
  descriptionAr String @map("description_ar")
  quantity      Int
  netPiastres   Int    @map("net_piastres")
  vatPiastres   Int    @map("vat_piastres")

  invoice TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNo], map: "tax_invoice_lines_invoice_line_key")
  @@map("tax_invoice_lines")
}

// ─── HR (docs/HR.md) ───────────────────────────────────────────────────────────

enum EmployeeStatus {
  active
  on_leave
  suspended
  left

  @@map("employee_status")
}

/// outsourced follows employees.employment, which HR sets
enum ContractType {
  permanent
  fixed_term
  part_time
  outsourced

  @@map("contract_type")
}

/// One file per person who works for us (team members and riders), linked 1:1 to their user.
/// The display name and sign in mobile stay on users; the home store of store staff and
/// riders follows users.dark_store_id. HR owns employment, contract and salary package;
/// Accounting only reads them to run payroll.
model Employee {
  id                    String         @id @default(cuid())
  /// Shown as EMP-0001
  number                Int            @unique @default(autoincrement())
  userId                String         @unique @map("user_id")
  nameEn                String         @map("name_en")
  nameAr                String?        @map("name_ar")
  /// 14 digit national ID (salary tax forms read it from here)
  nationalId            String?        @map("national_id")
  nationalIdExpiresOn   DateTime?      @map("national_id_expires_on") @db.Date
  birthDate             DateTime?      @map("birth_date") @db.Date
  address               String?
  emergencyName         String?        @map("emergency_name")
  emergencyPhone        String?        @map("emergency_phone")
  /// Free title shown when the person has no position (or to refine it)
  jobTitle              String?        @map("job_title")
  departmentId          String?        @map("department_id")
  positionId            String?        @map("position_id")
  gradeId               String?        @map("grade_id")
  /// Set by hand; when empty the manager is the head of the department chain
  managerId             String?        @map("manager_id")
  homeStoreId           String?        @map("home_store_id")
  hireDate              DateTime?      @map("hire_date") @db.Date
  /// employee: on our payroll; outsourced: hired through an outsourcing company (a supplier)
  employment            EmploymentType @default(employee)
  /// monthly_salary: on the salary run; per_delivery: riders paid per delivered order
  payBasis              PayBasis       @default(monthly_salary) @map("pay_basis")
  staffingSupplierId    String?        @map("staffing_supplier_id")
  contractType          ContractType   @default(permanent) @map("contract_type")
  contractEndsOn        DateTime?      @map("contract_ends_on") @db.Date
  probationEndsOn       DateTime?      @map("probation_ends_on") @db.Date
  /// Social insurance number (insurance forms read it from here)
  socialInsuranceNumber String?        @map("social_insurance_number")
  /// Where the salary is paid; read and changed only with the salaries switch
  bankName              String?        @map("bank_name")
  bankAccountNumber     String?        @map("bank_account_number")
  iban                  String?
  bankAccountHolder     String?        @map("bank_account_holder")
  status                EmployeeStatus @default(active)
  leftOn                DateTime?      @map("left_on") @db.Date
  leftReason            String?        @map("left_reason")
  /// The shift the weekly roster is generated from (HR step 2); none: no roster
  defaultShiftId        String?        @map("default_shift_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  manager          Employee?              @relation("employee_manager", fields: [managerId], references: [id], onDelete: SetNull)
  reports          Employee[]             @relation("employee_manager")
  homeStore        DarkStore?             @relation(fields: [homeStoreId], references: [id], onDelete: Restrict)
  department       Department?            @relation("department_members", fields: [departmentId], references: [id], onDelete: Restrict)
  position         JobPosition?           @relation(fields: [positionId], references: [id], onDelete: Restrict)
  grade            Grade?                 @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  staffingSupplier Supplier?              @relation("staffing_supplier", fields: [staffingSupplierId], references: [id], onDelete: Restrict)
  headOf           Department[]           @relation("department_head")
  documents        EmployeeDocument[]
  photo            EmployeePhoto?
  salaryPackages   SalaryPackage[]
  checklists       EmployeeChecklist[]
  defaultShift     Shift?                 @relation(fields: [defaultShiftId], references: [id], onDelete: SetNull)
  rosterDays       RosterDay[]
  punches          Punch[]
  attendanceDays   AttendanceDay[]
  leaveRequests    LeaveRequest[]
  leaveDays        LeaveRequestDay[]
  leaveAdjustments LeaveAdjustment[]
  violations       Violation[]
  suggestions      ViolationSuggestion[]
  corrections      AttendanceCorrection[]
  exits            EmployeeExit[]
  expenseClaims    ExpenseClaim[]
  reminders        DocumentReminder[]
  hireDraft        HireDraft?

  @@index([homeStoreId])
  @@index([status])
  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

/// The square photo of a person (JPEG made on the phone), apart so lists never load it.
model EmployeePhoto {
  employeeId  String   @id @map("employee_id")
  contentType String   @map("content_type")
  data        Bytes
  sizeBytes   Int      @map("size_bytes")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_photos")
}

/// The organisation tree: a department may sit under another, has a head and optionally the
/// store its costs belong to.
model Department {
  id             String   @id @default(cuid())
  code           String   @unique
  nameEn         String   @map("name_en")
  nameAr         String   @map("name_ar")
  parentId       String?  @map("parent_id")
  headEmployeeId String?  @map("head_employee_id")
  costStoreId    String?  @map("cost_store_id")
  sort           Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parent    Department?   @relation("department_tree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[]  @relation("department_tree")
  head      Employee?     @relation("department_head", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  costStore DarkStore?    @relation(fields: [costStoreId], references: [id], onDelete: Restrict)
  members   Employee[]    @relation("department_members")
  positions JobPosition[]

  @@index([parentId])
  @@map("departments")
}

/// Grades (levels) in order: rank 1 is the most junior. A salary band is optional.
model Grade {
  id              String   @id @default(cuid())
  code            String   @unique
  nameEn          String   @map("name_en")
  nameAr          String   @map("name_ar")
  rank            Int      @unique
  bandMinPiastres Int?     @map("band_min_piastres")
  bandMaxPiastres Int?     @map("band_max_piastres")
  /// Yearly annual leave days of this grade (HR phase 3); a position may override it
  annualLeaveDays Int?     @map("annual_leave_days")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employees   Employee[]
  positionsLo JobPosition[] @relation("position_min_grade")
  positionsHi JobPosition[] @relation("position_max_grade")

  @@map("grades")
}

/// A job position: title, department, the grades it may hold and how many people are planned.
model JobPosition {
  id               String   @id @default(cuid())
  code             String   @unique
  titleEn          String   @map("title_en")
  titleAr          String   @map("title_ar")
  departmentId     String   @map("department_id")
  minGradeId       String?  @map("min_grade_id")
  maxGradeId       String?  @map("max_grade_id")
  headcountPlanned Int      @default(0) @map("headcount_planned")
  /// Yearly annual leave days of this position, over the grade's (HR phase 3)
  annualLeaveDays  Int?     @map("annual_leave_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  minGrade           Grade?              @relation("position_min_grade", fields: [minGradeId], references: [id], onDelete: Restrict)
  maxGrade           Grade?              @relation("position_max_grade", fields: [maxGradeId], references: [id], onDelete: Restrict)
  employees          Employee[]
  checklistTemplates ChecklistTemplate[]

  @@index([departmentId])
  @@map("job_positions")
}

/// What HR keeps on a file (ID copy, contract...): expiry, who must have it, formats, size.
/// Required when `required` is on and the person matches every non empty list.
model EmployeeDocumentType {
  id                    String   @id @default(cuid())
  code                  String   @unique
  nameEn                String   @map("name_en")
  nameAr                String   @map("name_ar")
  hasExpiry             Boolean  @default(false) @map("has_expiry")
  required              Boolean  @default(false)
  requiredEmployment    String[] @default([]) @map("required_employment")
  requiredDepartmentIds String[] @default([]) @map("required_department_ids")
  requiredPositionIds   String[] @default([]) @map("required_position_ids")
  allowedTypes          String[] @default(["image/jpeg", "image/png", "image/webp", "application/pdf"]) @map("allowed_types")
  maxBytes              Int      @default(3000000) @map("max_bytes")
  /// Only HR use and the person may open it
  confidential          Boolean  @default(false)
  /// The person may upload it from My HR (waits for HR to verify)
  selfUpload            Boolean  @default(true) @map("self_upload")
  /// Several separate documents of this type (certificates); otherwise a new upload is a new version
  multiple              Boolean  @default(false)
  /// Days before expiry to alert; empty means hr.document_alert_days
  alertDays             Int?     @map("alert_days")
  sort                  Int      @default(0)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  documents      EmployeeDocument[]
  checklistTasks ChecklistTemplateTask[]

  @@map("employee_document_types")
}

enum EmployeeDocumentStatus {
  pending
  verified
  rejected

  @@map("employee_document_status")
}

/// A scanned document of an employee file (photo or PDF), kept in the database like proof
/// photos but in its own table so only HR and the person can read it. A new version keeps the
/// old ones (previous_id); only the current one counts.
model EmployeeDocument {
  id           String                 @id @default(cuid())
  employeeId   String                 @map("employee_id")
  typeId       String                 @map("type_id")
  title        String?
  contentType  String                 @map("content_type")
  data         Bytes
  sizeBytes    Int                    @map("size_bytes")
  issuedOn     DateTime?              @map("issued_on") @db.Date
  expiresOn    DateTime?              @map("expires_on") @db.Date
  version      Int                    @default(1)
  previousId   String?                @unique @map("previous_id")
  isCurrent    Boolean                @default(true) @map("is_current")
  status       EmployeeDocumentStatus @default(pending)
  reviewNote   String?                @map("review_note")
  reviewedById String?                @map("reviewed_by_id")
  reviewedAt   DateTime?              @map("reviewed_at")
  /// Uploaded by the person from My HR
  selfUploaded Boolean                @default(false) @map("self_uploaded")
  uploadedById String                 @map("uploaded_by_id")
  createdAt    DateTime               @default(now()) @map("created_at")

  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       EmployeeDocumentType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  previous   EmployeeDocument?    @relation("document_versions", fields: [previousId], references: [id], onDelete: SetNull)
  next       EmployeeDocument?    @relation("document_versions")
  uploadedBy User                 @relation("employee_document_uploaded_by", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy User?                @relation("employee_document_reviewed_by", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([expiresOn])
  @@index([typeId])
  @@map("employee_documents")
}

/// A salary package from a day on: basic salary plus allowances. Later packages never change
/// earlier rows, so the list is the history; payroll reads the one in force.
model SalaryPackage {
  id                  String   @id @default(cuid())
  employeeId          String   @map("employee_id")
  effectiveFrom       DateTime @map("effective_from") @db.Date
  basicPiastres       Int      @map("basic_piastres")
  /// The wage social insurance is counted on; empty means the gross itself
  insuredWagePiastres Int?     @map("insured_wage_piastres")
  note                String?
  createdById         String   @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")

  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy  User              @relation("salary_package_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  allowances SalaryAllowance[]

  @@unique([employeeId, effectiveFrom])
  @@map("salary_packages")
}

enum AllowanceKind {
  housing
  transport
  phone
  other

  @@map("allowance_kind")
}

model SalaryAllowance {
  id             String        @id @default(cuid())
  packageId      String        @map("package_id")
  kind           AllowanceKind
  label          String?
  amountPiastres Int           @map("amount_piastres")

  package SalaryPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("salary_allowances")
}

enum ChecklistKind {
  onboarding
  offboarding

  @@map("checklist_kind")
}

/// Onboarding or offboarding tasks for a position (no position: the default for everyone).
model ChecklistTemplate {
  id         String        @id @default(cuid())
  code       String        @unique
  kind       ChecklistKind
  nameEn     String        @map("name_en")
  nameAr     String        @map("name_ar")
  positionId String?       @map("position_id")
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  position   JobPosition?            @relation(fields: [positionId], references: [id], onDelete: Restrict)
  tasks      ChecklistTemplateTask[]
  checklists EmployeeChecklist[]

  @@map("checklist_templates")
}

model ChecklistTemplateTask {
  id             String  @id @default(cuid())
  templateId     String  @map("template_id")
  titleEn        String  @map("title_en")
  titleAr        String  @map("title_ar")
  /// hr, manager, employee, it, finance, store
  ownerRole      String  @map("owner_role")
  /// Days after the start (hire or last day); negative is before it
  dueDays        Int     @default(0) @map("due_days")
  /// Done by itself once a verified document of this type is on the file
  documentTypeId String? @map("document_type_id")
  sort           Int     @default(0)

  template     ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documentType EmployeeDocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("checklist_template_tasks")
}

enum ChecklistStatus {
  open
  done
  cancelled

  @@map("checklist_status")
}

/// A checklist started for one person, copied from a template so later template edits never
/// change it.
model EmployeeChecklist {
  id          String          @id @default(cuid())
  employeeId  String          @map("employee_id")
  templateId  String?         @map("template_id")
  kind        ChecklistKind
  nameEn      String          @map("name_en")
  nameAr      String          @map("name_ar")
  startsOn    DateTime        @map("starts_on") @db.Date
  status      ChecklistStatus @default(open)
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  employee  Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template  ChecklistTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User                    @relation("employee_checklist_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  tasks     EmployeeChecklistTask[]

  @@index([employeeId])
  @@map("employee_checklists")
}

model EmployeeChecklistTask {
  id             String    @id @default(cuid())
  checklistId    String    @map("checklist_id")
  titleEn        String    @map("title_en")
  titleAr        String    @map("title_ar")
  ownerRole      String    @map("owner_role")
  dueOn          DateTime  @map("due_on") @db.Date
  documentTypeId String?   @map("document_type_id")
  sort           Int       @default(0)
  doneAt         DateTime? @map("done_at")
  doneById       String?   @map("done_by_id")
  note           String?

  checklist EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  doneBy    User?             @relation("employee_checklist_task_done_by", fields: [doneById], references: [id], onDelete: Restrict)

  @@index([checklistId])
  @@map("employee_checklist_tasks")
}

// ─── Attendance (docs/HR.md 2) ─────────────────────────────────────────────────

enum PunchKind {
  in
  out

  @@map("punch_kind")
}

/// app: the person's phone (location checked); manual: a manager with a reason; auto: the
/// day close clocked out a person who forgot, at the shift end.
enum PunchSource {
  app
  manual
  auto

  @@map("punch_source")
}

enum AttendanceStatus {
  present
  late
  left_early
  absent
  on_leave
  day_off
  holiday

  @@map("attendance_status")
}

/// A shift template. Minutes from midnight (Cairo); an end at or before the start runs past
/// midnight, which only an overnight shift allows.
model Shift {
  id           String   @id @default(cuid())
  nameEn       String   @map("name_en")
  nameAr       String?  @map("name_ar")
  startMinute  Int      @map("start_minute")
  endMinute    Int      @map("end_minute")
  breakMinutes Int      @default(0) @map("break_minutes")
  /// Working weekdays, 0 = Sunday; the other days of the roster are days off
  weekdays     Int[]
  overnight    Boolean  @default(false)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employees  Employee[]
  rosterDays RosterDay[]

  @@map("shifts")
}

/// One person's plan for one Cairo day: a shift (its times copied, so the past keeps its plan)
/// or a day off (no shift). Generated from the default shift; edited rows are kept.
model RosterDay {
  id           String   @id @default(cuid())
  employeeId   String   @map("employee_id")
  day          DateTime @db.Date
  /// Where the person works that day (their store; null: the office)
  darkStoreId  String?  @map("dark_store_id")
  shiftId      String?  @map("shift_id")
  startMinute  Int?     @map("start_minute")
  endMinute    Int?     @map("end_minute")
  breakMinutes Int?     @map("break_minutes")
  /// Changed by hand: generating the roster again leaves it alone
  edited       Boolean  @default(false)
  updatedById  String?  @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  darkStore DarkStore? @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  shift     Shift?     @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([employeeId, day])
  @@index([darkStoreId, day])
  @@map("roster_days")
}

/// Official holidays (Cairo days): nobody is absent on them.
model Holiday {
  id          String   @id @default(cuid())
  day         DateTime @unique @db.Date
  nameEn      String   @map("name_en")
  nameAr      String   @map("name_ar")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

/// A clock in or out. Never deleted (a database trigger refuses it): a wrong punch is voided
/// with a reason, and the day is computed again.
model Punch {
  id          String      @id @default(cuid())
  employeeId  String      @map("employee_id")
  kind        PunchKind
  at          DateTime
  latitude    Float?
  longitude   Float?
  /// The phone's accuracy and the distance to the place checked, in metres
  accuracyM   Int?        @map("accuracy_m")
  distanceM   Int?        @map("distance_m")
  /// The store checked against (null: the office, or a manual punch)
  darkStoreId String?     @map("dark_store_id")
  device      String?
  source      PunchSource
  reason      String?
  byUserId    String?     @map("by_user_id")
  voidedAt    DateTime?   @map("voided_at")
  voidedById  String?     @map("voided_by_id")
  voidReason  String?     @map("void_reason")
  createdAt   DateTime    @default(now()) @map("created_at")

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  darkStore DarkStore? @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)

  @@index([employeeId, at])
  @@map("punches")
}

/// One closed attendance day per person and Cairo day, built from the roster and the punches
/// by the daily close, and built again whenever a punch or the status is corrected.
model AttendanceDay {
  id               String            @id @default(cuid())
  employeeId       String            @map("employee_id")
  day              DateTime          @db.Date
  darkStoreId      String?           @map("dark_store_id")
  shiftId          String?           @map("shift_id")
  plannedStart     DateTime?         @map("planned_start")
  plannedEnd       DateTime?         @map("planned_end")
  /// The status shown: the manager's status when set, else the computed one
  status           AttendanceStatus
  computedStatus   AttendanceStatus  @map("computed_status")
  overrideStatus   AttendanceStatus? @map("override_status")
  firstIn          DateTime?         @map("first_in")
  lastOut          DateTime?         @map("last_out")
  lateMinutes      Int               @default(0) @map("late_minutes")
  earlyMinutes     Int               @default(0) @map("early_minutes")
  overtimeMinutes  Int               @default(0) @map("overtime_minutes")
  workedMinutes    Int               @default(0) @map("worked_minutes")
  flags            String[]
  correctedById    String?           @map("corrected_by_id")
  correctionReason String?           @map("correction_reason")
  correctedAt      DateTime?         @map("corrected_at")
  closedAt         DateTime          @default(now()) @map("closed_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  darkStore DarkStore? @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)

  @@unique([employeeId, day])
  @@index([darkStoreId, day])
  @@index([day])
  @@index([closedAt])
  @@map("attendance_days")
}

// ─── Push notifications ────────────────────────────────────────────────────────

/// One browser or installed app that receives web push notifications for a person. Removed when
/// the push service says it is gone (404 or 410), or when the person removes the device.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  endpoint      String    @unique
  p256dh        String
  auth          String
  /// The device's language when it last subscribed or opened the app (en, ar)
  lang          String    @default("en")
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSuccessAt DateTime? @map("last_success_at")
  /// Failed sends in a row (reset by a success)
  failures      Int       @default(0)
  lastFailureAt DateTime? @map("last_failure_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// A notification type a person switched off or on again; a missing row means on.
model NotificationPreference {
  userId    String   @map("user_id")
  type      String
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

/// Events already notified, so a job that runs twice (or two API instances) sends each once.
/// Kept for two days, longer than the dispatcher ever looks back.
model PushSent {
  key        String   @id
  recipients Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("push_sent")
}

/// The one time fresh start that wiped the demo activity (src/fresh-start.ts). A row here
/// stops it from running again and stops the seed and the demo loader from adding samples.
model FreshStart {
  id            String   @id @default("fresh_start")
  ranAt         DateTime @default(now()) @map("ran_at")
  keptMerchants String[] @default([]) @map("kept_merchants")
  /// Rows per table before and after
  counts        Json

  @@map("fresh_starts")
}

// ─── cash controls ──────────────────────────────────────────────────────────────

/// A small expense store staff paid from their store's cash box (PC-000001), with a receipt
/// photo. Posted at once, or waiting for finance (a finance_requests row) above the petty cash
/// limit or when the box would fall below its float. Finance may reverse a posted one.
model PettyCashExpense {
  id               String    @id @default(cuid())
  /// Gapless serial number shown as PC-000001
  number           Int       @unique
  darkStoreId      String    @map("dark_store_id")
  expenseAccountId String    @map("expense_account_id")
  amountPiastres   Int       @map("amount_piastres")
  note             String
  photoId          String    @map("photo_id")
  /// The posted entry (at once, or once finance approved)
  entryId          String?   @unique @map("entry_id")
  /// The request waiting for a second person, when it needed one
  requestId        String?   @unique @map("request_id")
  idempotencyKey   String    @unique @map("idempotency_key")
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  reversalEntryId  String?   @unique @map("reversal_entry_id")
  reversedById     String?   @map("reversed_by_id")
  reversedAt       DateTime? @map("reversed_at")
  reverseReason    String?   @map("reverse_reason")
  /// The cost tag of the expense line, when the person chose one
  costTagId        String?   @map("cost_tag_id")

  darkStore      DarkStore       @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  expenseAccount LedgerAccount   @relation(fields: [expenseAccountId], references: [id], onDelete: Restrict)
  photo          Photo           @relation(fields: [photoId], references: [id], onDelete: Restrict)
  entry          LedgerEntry?    @relation("petty_cash_entry", fields: [entryId], references: [id], onDelete: Restrict)
  reversalEntry  LedgerEntry?    @relation("petty_cash_reversal", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  request        FinanceRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("petty_cash_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  reversedBy     User?           @relation("petty_cash_reversed_by", fields: [reversedById], references: [id], onDelete: Restrict)
  costTag        CostTag?        @relation(fields: [costTagId], references: [id], onDelete: Restrict)

  @@index([darkStoreId, createdAt])
  @@map("petty_cash_expenses")
}

/// A month end checklist item finance marked done by hand, with a note (audited).
model MonthEndMark {
  id         String   @id @default(cuid())
  /// YYYY-MM
  month      String
  item       String
  note       String
  markedById String   @map("marked_by_id")
  markedAt   DateTime @default(now()) @map("marked_at")

  markedBy User @relation(fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([month, item])
  @@map("month_end_marks")
}

// ─── Cheques and merchant contracts ───────────────────────────────────────────

enum ChequeDirection {
  /// A cheque given to us (a merchant, a supplier paying back, anyone paying us)
  received
  /// A cheque we wrote (a bill, a payout, a deposit paid back)
  issued

  @@map("cheque_direction")
}

/// What a cheque pays for, which decides what it is booked against.
enum ChequePurpose {
  /// Received: the merchant pays what they owe us (merchant wallet)
  merchant
  /// Received: a merchant's security deposit (deposit wallet)
  deposit
  /// Received: a supplier paying us back (supplier wallet)
  supplier
  /// Received: other income (an account of group 4200)
  other_income
  /// Issued: payment of a supplier bill
  bill
  /// Issued: a merchant payout
  payout
  /// Issued: a merchant's security deposit paid back
  deposit_refund

  @@map("cheque_purpose")
}

enum ChequeStatus {
  /// Waiting for a second person before it is booked
  awaiting_approval
  received
  issued
  /// A received cheque handed to our bank for collection
  deposited
  cleared
  bounced
  cancelled

  @@map("cheque_status")
}

/// The cheques register: every cheque received or issued, post dated or not.
model Cheque {
  id              String          @id @default(cuid())
  /// Gapless register number shown as CHQ-000001
  number          Int             @unique
  direction       ChequeDirection
  purpose         ChequePurpose
  status          ChequeStatus
  /// The number printed on the cheque
  chequeNumber    String          @map("cheque_number")
  /// The bank the cheque is drawn on
  bankName        String          @map("bank_name")
  /// Who wrote it (received) or who it is made out to (issued)
  partyName       String          @map("party_name")
  amountPiastres  Int             @map("amount_piastres")
  issueDate       DateTime        @map("issue_date") @db.Date
  /// Not to be cashed before this day (post dated cheques)
  dueDate         DateTime        @map("due_date") @db.Date
  merchantId      String?         @map("merchant_id")
  supplierId      String?         @map("supplier_id")
  billId          String?         @map("bill_id")
  payoutId        String?         @map("payout_id")
  incomeAccountId String?         @map("income_account_id")
  /// Our bank: the one an issued cheque is drawn on, or a received one was deposited into
  bankAccountId   String?         @map("bank_account_id")
  photoId         String?         @map("photo_id")
  note            String?
  bookEntryId     String?         @map("book_entry_id")
  clearEntryId    String?         @map("clear_entry_id")
  reverseEntryId  String?         @map("reverse_entry_id")
  depositedAt     DateTime?       @map("deposited_at")
  clearedAt       DateTime?       @map("cleared_at")
  bouncedAt       DateTime?       @map("bounced_at")
  bounceReason    String?         @map("bounce_reason")
  cancelledAt     DateTime?       @map("cancelled_at")
  cancelNote      String?         @map("cancel_note")
  idempotencyKey  String          @unique @map("idempotency_key")
  createdById     String          @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  merchant      Merchant?      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  bill          Bill?          @relation(fields: [billId], references: [id], onDelete: Restrict)
  payout        Payout?        @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  incomeAccount LedgerAccount? @relation("cheque_income", fields: [incomeAccountId], references: [id], onDelete: Restrict)
  bankAccount   LedgerAccount? @relation("cheque_bank", fields: [bankAccountId], references: [id], onDelete: Restrict)
  photo         Photo?         @relation(fields: [photoId], references: [id], onDelete: Restrict)
  bookEntry     LedgerEntry?   @relation("cheque_book_entry", fields: [bookEntryId], references: [id], onDelete: Restrict)
  clearEntry    LedgerEntry?   @relation("cheque_clear_entry", fields: [clearEntryId], references: [id], onDelete: Restrict)
  reverseEntry  LedgerEntry?   @relation("cheque_reverse_entry", fields: [reverseEntryId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("cheque_created_by", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, dueDate])
  @@index([merchantId])
  @@map("cheques")
}

/// A merchant's contract (merchant contracts v2): one per merchant, numbered CTR-000001
/// (gapless), made of versions. The version in force on a day holds every price, tier,
/// payment term and promise of the deal; charges read it for the day of their event.
model MerchantContract {
  id          String   @id @default(cuid())
  merchantId  String   @unique @map("merchant_id")
  number      Int      @unique
  /// null: made by the migration from the earlier contract and fee settings
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  merchant  Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  createdBy User?                     @relation("contract_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  versions  MerchantContractVersion[]
  files     MerchantContractFile[]

  @@map("merchant_contracts")
}

enum ContractVersionStatus {
  /// Being written; changes nothing until activated
  draft
  /// Activated: in force from effective_from until a later version takes effect
  active
  /// A later version was activated after it
  superseded

  @@map("contract_version_status")
}

/// One version of a merchant's contract. Prices left empty are the standard price (the
/// global fee setting). Once activated a version is never changed.
model MerchantContractVersion {
  id                          String                @id @default(cuid())
  contractId                  String                @map("contract_id")
  version                     Int
  status                      ContractVersionStatus @default(draft)
  /// The Cairo day it takes effect (planned on a draft, fixed when activated)
  effectiveFrom               DateTime?             @map("effective_from") @db.Date
  // Prices (null: the standard price; 0 is an explicit price)
  /// Shipping fee per delivered order (often all inclusive, the other fees then 0)
  shippingFeePiastres         Int?                  @map("shipping_fee_piastres")
  orderFixedPiastres          Int?                  @map("order_fixed_piastres")
  orderPercentBp              Int?                  @map("order_percent_bp")
  codPercentBp                Int?                  @map("cod_percent_bp")
  failedDeliveryPiastres      Int?                  @map("failed_delivery_piastres")
  receivingPerUnitPiastres    Int?                  @map("receiving_per_unit_piastres")
  storagePerUnitMonthPiastres Int?                  @map("storage_per_unit_month_piastres")
  returnPerUnitPiastres       Int?                  @map("return_per_unit_piastres")
  /// Packaging charged per delivered order (null: fee.packaging_charge_piastres, 0 by default)
  packagingChargePiastres     Int?                  @map("packaging_charge_piastres")
  /// A failed attempt costs this share of the shipment charges when no fixed fee is set
  failedDeliveryPercentBp     Int?                  @map("failed_delivery_percent_bp")
  // Payment terms
  /// The agreed schedule, set on the merchant when the version takes effect (null: theirs)
  payoutSchedule              PayoutSchedule?       @map("payout_schedule")
  /// When the agreed schedule was set on the merchant
  scheduleAppliedAt           DateTime?             @map("schedule_applied_at")
  /// Payouts wait until we owe at least this (null: finance.payout_minimum_piastres)
  minimumPayoutPiastres       Int?                  @map("minimum_payout_piastres")
  /// Fees booked for a month are topped up to this at month end (null: no minimum)
  minimumMonthlyFeePiastres   Int?                  @map("minimum_monthly_fee_piastres")
  /// The security deposit agreed; what we really hold is the deposit wallet's balance
  securityDepositPiastres     Int?                  @map("security_deposit_piastres")
  /// Shipments are refused while the merchant owes us more than this (null: no limit)
  creditLimitPiastres         Int?                  @map("credit_limit_piastres")
  // Service promises
  /// Informative (null: sla.promise_minutes)
  promiseMinutes              Int?                  @map("promise_minutes")
  /// Delivery attempts included; the merchant's orders use it (null: delivery.max_attempts)
  deliveryAttempts            Int?                  @map("delivery_attempts")
  /// Informative: the stores agreed
  storeIds                    String[]              @default([]) @map("store_ids")
  coverageNote                String?               @map("coverage_note")
  /// Special terms, shown to the merchant and printed
  terms                       String?
  /// For the team only
  internalNote                String?               @map("internal_note")
  // Dates
  startDate                   DateTime              @map("start_date") @db.Date
  endDate                     DateTime?             @map("end_date") @db.Date
  /// Days of notice either side gives to end the contract
  noticeDays                  Int                   @map("notice_days")
  /// Where it came from: migration, a proposal (PRO-000001), or empty (typed)
  source                      String?
  createdById                 String?               @map("created_by_id")
  activatedById               String?               @map("activated_by_id")
  activatedAt                 DateTime?             @map("activated_at")
  supersededAt                DateTime?             @map("superseded_at")
  idempotencyKey              String?               @unique @map("idempotency_key")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")

  contract    MerchantContract                 @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdBy   User?                            @relation("contract_version_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy User?                            @relation("contract_version_activated_by", fields: [activatedById], references: [id], onDelete: Restrict)
  tiers       MerchantContractVersionTier[]
  products    MerchantContractVersionProduct[]
  files       MerchantContractFile[]

  @@unique([contractId, version])
  @@index([contractId, status, effectiveFrom])
  @@map("merchant_contract_versions")
}

/// From the nth delivered order of a Cairo month, the values set here replace the version's
/// prices (null: the version's). The order that crosses into a band and every later one pay
/// the band's price; other charges use the band the next delivered order would fall in.
model MerchantContractVersionTier {
  id                          String @id @default(cuid())
  versionId                   String @map("version_id")
  fromOrder                   Int    @map("from_order")
  shippingFeePiastres         Int?   @map("shipping_fee_piastres")
  fixedFeePiastres            Int?   @map("fixed_fee_piastres")
  percentBp                   Int?   @map("percent_bp")
  codPercentBp                Int?   @map("cod_percent_bp")
  failedDeliveryPiastres      Int?   @map("failed_delivery_piastres")
  receivingPerUnitPiastres    Int?   @map("receiving_per_unit_piastres")
  storagePerUnitMonthPiastres Int?   @map("storage_per_unit_month_piastres")
  returnPerUnitPiastres       Int?   @map("return_per_unit_piastres")
  packagingChargePiastres     Int?   @map("packaging_charge_piastres")

  version MerchantContractVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, fromOrder])
  @@map("merchant_contract_version_tiers")
}

/// A product's price on a contract version, charged per delivered unit (no tiers). Frozen
/// with its version once activated.
model MerchantContractVersionProduct {
  id            String @id @default(cuid())
  versionId     String @map("version_id")
  skuId         String @map("sku_id")
  pricePiastres Int    @map("price_piastres")

  version MerchantContractVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sku     Sku                     @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([versionId, skuId])
  @@index([skuId])
  @@map("merchant_contract_version_products")
}

/// Signed contract files (PDF, JPG or PNG, at most 5 MB), kept in Postgres like other files.
model MerchantContractFile {
  id           String   @id @default(cuid())
  contractId   String   @map("contract_id")
  /// The version it signs (null: the contract as a whole)
  versionId    String?  @map("version_id")
  fileName     String   @map("file_name")
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  data         Bytes
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  contract   MerchantContract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  version    MerchantContractVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  uploadedBy User?                    @relation("contract_file_uploaded_by", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@map("merchant_contract_files")
}

// ─── Email ─────────────────────────────────────────────────────────────────────

enum EmailStatus {
  /// Waiting to be sent (or to be tried again at next_attempt_at)
  pending
  sent
  /// Gave up after the last try; finance can send it again
  failed

  @@map("email_status")
}

/// Emails to merchants, written in the same transaction as the event (a payout paid, an
/// invoice issued) and sent by the API job. One row per idempotency key, so nothing is sent twice.
model EmailOutbox {
  id             String      @id @default(cuid())
  /// statement, payout_paid, invoice
  kind           String
  merchantId     String?     @map("merchant_id")
  toEmails       String[]    @map("to_emails")
  language       String
  subject        String
  html           String
  text           String
  /// [{ filename, contentType, content (base64) }]
  attachments    Json?
  idempotencyKey String      @unique @map("idempotency_key")
  status         EmailStatus @default(pending)
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now()) @map("next_attempt_at")
  sentAt         DateTime?   @map("sent_at")
  lastError      String?     @map("last_error")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([merchantId, createdAt])
  @@index([createdAt])
  @@map("email_outbox")
}

// ─── Packaging (our own consumables, never merchant stock) ─────────────────────

/// A bag, box, label or roll of tape we buy and use when packing orders.
model PackagingItem {
  id               String   @id @default(cuid())
  code             String   @unique
  nameEn           String   @map("name_en")
  nameAr           String   @map("name_ar")
  unit             String   @default("piece")
  /// The last price paid for one unit; values units found in a count
  unitCostPiastres Int      @default(0) @map("unit_cost_piastres")
  /// A box size staff may choose at packing
  isBox            Boolean  @default(false) @map("is_box")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  levels    PackagingLevel[]
  movements PackagingMovement[]
  recipes   PackagingRecipe[]
  poLines   PurchaseOrderLine[]

  @@map("packaging_items")
}

/// Units and their value (average cost) per store; changed only with a packaging movement.
model PackagingLevel {
  id            String   @id @default(cuid())
  darkStoreId   String   @map("dark_store_id")
  itemId        String   @map("item_id")
  onHand        Int      @default(0) @map("on_hand")
  valuePiastres Int      @default(0) @map("value_piastres")
  updatedAt     DateTime @updatedAt @map("updated_at")

  darkStore DarkStore     @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  item      PackagingItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([darkStoreId, itemId])
  @@map("packaging_levels")
}

enum PackagingMovementType {
  receive
  consume
  adjust
  count

  @@map("packaging_movement_type")
}

/// Every change to packaging stock (append only), with the value it moved.
model PackagingMovement {
  id              String                @id @default(cuid())
  darkStoreId     String                @map("dark_store_id")
  itemId          String                @map("item_id")
  type            PackagingMovementType
  /// Signed: received units are positive, used units negative
  quantity        Int
  valuePiastres   Int                   @map("value_piastres")
  orderId         String?               @map("order_id")
  purchaseOrderId String?               @map("purchase_order_id")
  entryId         String?               @map("entry_id")
  reason          String?
  idempotencyKey  String                @unique @map("idempotency_key")
  createdById     String?               @map("created_by_id")
  createdAt       DateTime              @default(now()) @map("created_at")

  item PackagingItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([darkStoreId, itemId, createdAt])
  @@index([orderId])
  @@map("packaging_movements")
}

/// What one order uses: for a merchant at a store, a merchant, a store, or everyone (both empty).
model PackagingRecipe {
  id          String   @id @default(cuid())
  darkStoreId String?  @map("dark_store_id")
  merchantId  String?  @map("merchant_id")
  itemId      String   @map("item_id")
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")

  item PackagingItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([darkStoreId, merchantId])
  @@map("packaging_recipes")
}

// ─── Purchase orders ───────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  requested
  approved
  ordered
  received
  billed
  closed
  rejected
  cancelled

  @@map("purchase_order_status")
}

/// What we ask a supplier for: approved, ordered, received (in parts), billed, closed.
model PurchaseOrder {
  id            String              @id @default(cuid())
  /// Gapless serial number shown as PO-000001
  number        Int                 @unique
  supplierId    String              @map("supplier_id")
  darkStoreId   String?             @map("dark_store_id")
  status        PurchaseOrderStatus @default(requested)
  /// Lines added up, before VAT
  totalPiastres Int                 @map("total_piastres")
  note          String?
  /// The supplier's quote (a receipt photo)
  quotePhotoId  String?             @map("quote_photo_id")
  requestedById String              @map("requested_by_id")
  decidedById   String?             @map("decided_by_id")
  decidedAt     DateTime?           @map("decided_at")
  decisionNote  String?             @map("decision_note")
  orderedAt     DateTime?           @map("ordered_at")
  closedAt      DateTime?           @map("closed_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  supplier    Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  darkStore   DarkStore?             @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  requestedBy User                   @relation("purchase_order_requested_by", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?                  @relation("purchase_order_decided_by", fields: [decidedById], references: [id], onDelete: Restrict)
  lines       PurchaseOrderLine[]
  bills       Bill[]
  receipts    PurchaseOrderReceipt[]

  @@index([status, createdAt])
  @@map("purchase_orders")
}

/// One thing ordered: a packaging item (received into packaging stock) or a cost line.
model PurchaseOrderLine {
  id                String  @id @default(cuid())
  purchaseOrderId   String  @map("purchase_order_id")
  lineNo            Int     @map("line_no")
  packagingItemId   String? @map("packaging_item_id")
  /// For a line that is not packaging: the expense it is booked to when billed
  expenseAccountId  String? @map("expense_account_id")
  description       String
  quantity          Int
  unitPricePiastres Int     @map("unit_price_piastres")
  receivedQty       Int     @default(0) @map("received_qty")
  billedQty         Int     @default(0) @map("billed_qty")

  purchaseOrder  PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  packagingItem  PackagingItem? @relation(fields: [packagingItemId], references: [id], onDelete: Restrict)
  expenseAccount LedgerAccount? @relation(fields: [expenseAccountId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, lineNo])
  @@map("purchase_order_lines")
}

/// One delivery received against a purchase order (it may come in parts).
model PurchaseOrderReceipt {
  id              String   @id @default(cuid())
  purchaseOrderId String   @map("purchase_order_id")
  /// [{ lineId, quantity }]
  lines           Json
  /// What the packaging part was worth at the ordered prices (booked to packaging stock)
  valuePiastres   Int      @map("value_piastres")
  entryId         String?  @map("entry_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_receipts")
}

// ─── Sales CRM (docs/SALES.md) ────────────────────────────────────────────────

enum CrmSource {
  website_form
  signup
  manual
  referral
  event
  other

  @@map("crm_source")
}

enum CrmStage {
  new
  contacted
  meeting
  proposal
  negotiation
  won
  lost

  @@map("crm_stage")
}

enum CrmActivityType {
  call
  meeting
  whatsapp
  email
  note
  task

  @@map("crm_activity_type")
}

/// A brand we sell to. Leads from the website form and sign ups open one by themselves.
model CrmCompany {
  id                    String    @id @default(cuid())
  brandName             String    @map("brand_name")
  website               String?
  shopDomain            String?   @map("shop_domain")
  category              String?
  city                  String?
  expectedMonthlyOrders Int?      @map("expected_monthly_orders")
  source                CrmSource
  note                  String?
  /// The rep who looks after the company (null: the sales managers' queue)
  ownerId               String?   @map("owner_id")
  /// The merchant once the company signed up or was won
  merchantId            String?   @map("merchant_id")
  /// The website form submission that opened it
  siteLeadId            String?   @unique @map("site_lead_id")
  idempotencyKey        String?   @unique @map("idempotency_key")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  owner      User?         @relation("crm_company_owner", fields: [ownerId], references: [id], onDelete: Restrict)
  merchant   Merchant?     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  siteLead   SiteLead?     @relation(fields: [siteLeadId], references: [id], onDelete: Restrict)
  contacts   CrmContact[]
  deals      CrmDeal[]
  activities CrmActivity[]

  @@index([ownerId])
  @@index([merchantId])
  @@index([brandName])
  @@map("crm_companies")
}

/// A person at a company. A phone that is not a valid Egyptian mobile is kept as typed.
model CrmContact {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  name       String
  role       String?
  phone      String?
  phoneValid Boolean  @default(false) @map("phone_valid")
  email      String?
  whatsapp   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company CrmCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("crm_contacts")
}

/// A sales opportunity walking the pipeline (DEAL-000001, gapless).
model CrmDeal {
  id                         String    @id @default(cuid())
  number                     Int       @unique
  companyId                  String    @map("company_id")
  title                      String?
  ownerId                    String?   @map("owner_id")
  /// When the current owner got it (pushes "this deal is yours")
  ownerAssignedAt            DateTime? @map("owner_assigned_at")
  ownerAssignedById          String?   @map("owner_assigned_by_id")
  /// Given by the round robin (sales.auto_assign), so the next lead goes to the next rep
  autoAssigned               Boolean   @default(false) @map("auto_assigned")
  stage                      CrmStage  @default(new)
  expectedMonthlyOrders      Int?      @map("expected_monthly_orders")
  expectedMonthlyFeePiastres Int?      @map("expected_monthly_fee_piastres")
  expectedCloseDate          DateTime? @map("expected_close_date") @db.Date
  /// A code of crm_lost_reasons, or "other" with lost_note
  lostReason                 String?   @map("lost_reason")
  lostNote                   String?   @map("lost_note")
  stageChangedAt             DateTime  @default(now()) @map("stage_changed_at")
  wonAt                      DateTime? @map("won_at")
  lostAt                     DateTime? @map("lost_at")
  merchantId                 String?   @map("merchant_id")
  /// The owner when the deal was won: commission and targets count for them (part 2)
  wonById                    String?   @map("won_by_id")
  /// Commission terms taken from the settings when the deal was won
  commissionBp               Int?      @map("commission_bp")
  commissionMonths           Int?      @map("commission_months")
  /// Distinct months with a delivered order the merchant needs before its fees count (at the win)
  qualifyMonths              Int?      @map("qualify_months")
  idempotencyKey             String?   @unique @map("idempotency_key")
  createdById                String?   @map("created_by_id")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  company         CrmCompany            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner           User?                 @relation("crm_deal_owner", fields: [ownerId], references: [id], onDelete: Restrict)
  wonBy           User?                 @relation("crm_deal_won_by", fields: [wonById], references: [id], onDelete: Restrict)
  merchant        Merchant?             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  history         CrmDealStageHistory[]
  activities      CrmActivity[]
  proposals       CrmProposal[]
  commissionLines CrmCommissionLine[]

  @@index([ownerId, stage])
  @@index([stage, stageChangedAt])
  @@index([companyId])
  @@index([wonById, wonAt])
  @@map("crm_deals")
}

/// Every stage a deal entered (append only).
model CrmDealStageHistory {
  id          String    @id @default(cuid())
  dealId      String    @map("deal_id")
  fromStage   CrmStage? @map("from_stage")
  toStage     CrmStage  @map("to_stage")
  changedById String?   @map("changed_by_id")
  changedAt   DateTime  @default(now()) @map("changed_at")
  lostReason  String?   @map("lost_reason")
  note        String?

  deal      CrmDeal @relation(fields: [dealId], references: [id], onDelete: Restrict)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([dealId, changedAt])
  @@map("crm_deal_stage_history")
}

/// A call, meeting, message, note or task. Open with a due date it is a planned next step.
model CrmActivity {
  id             String          @id @default(cuid())
  companyId      String          @map("company_id")
  dealId         String?         @map("deal_id")
  type           CrmActivityType
  subject        String
  notes          String?
  dueAt          DateTime?       @map("due_at")
  doneAt         DateTime?       @map("done_at")
  outcome        String?
  ownerId        String          @map("owner_id")
  createdById    String?         @map("created_by_id")
  /// Set by the reminder job when the owner was told it is due (sent once)
  dueNotifiedAt  DateTime?       @map("due_notified_at")
  idempotencyKey String?         @unique @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company   CrmCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deal      CrmDeal?   @relation(fields: [dealId], references: [id], onDelete: Restrict)
  owner     User       @relation("crm_activity_owner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy User?      @relation("crm_activity_created_by", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([ownerId, doneAt, dueAt])
  @@index([dealId, doneAt])
  @@index([companyId])
  @@index([doneAt, dueAt])
  @@map("crm_activities")
}

/// The reasons a deal can be lost (sales managers edit the list; "other" needs a note).
model CrmLostReason {
  code      String   @id
  labelEn   String   @map("label_en")
  labelAr   String   @map("label_ar")
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crm_lost_reasons")
}

// ─── Sales CRM part 2: proposals, targets, commission (docs/SALES.md) ───────────────

enum CrmProposalStatus {
  draft
  sent
  viewed
  accepted
  declined
  expired
  superseded

  @@map("crm_proposal_status")
}

enum CrmCommissionStatus {
  /// Worked out by the monthly job; the sales manager approves or adjusts it
  draft
  approved
  /// Paid in the salary run (employees) or as a direct bonus (outsourced people)
  paid
  /// Nothing to pay (target missed, no target set, or nothing earned): settled without approval
  closed

  @@map("crm_commission_status")
}

/// Our rates and terms offered to a brand (PRO-000001, gapless), one version per row of a deal.
model CrmProposal {
  id                          String            @id @default(cuid())
  number                      Int               @unique
  dealId                      String            @map("deal_id")
  version                     Int
  status                      CrmProposalStatus @default(draft)
  shippingFeePiastres         Int               @default(0) @map("shipping_fee_piastres")
  packagingChargePiastres     Int               @default(0) @map("packaging_charge_piastres")
  /// A failed attempt costs this share of the shipment charges (null: the fixed fee)
  failedDeliveryPercentBp     Int?              @map("failed_delivery_percent_bp")
  orderFixedPiastres          Int               @map("order_fixed_piastres")
  orderPercentBp              Int               @map("order_percent_bp")
  codPercentBp                Int               @map("cod_percent_bp")
  failedDeliveryPiastres      Int               @map("failed_delivery_piastres")
  receivingPerUnitPiastres    Int               @map("receiving_per_unit_piastres")
  storagePerUnitMonthPiastres Int               @map("storage_per_unit_month_piastres")
  returnPerUnitPiastres       Int               @map("return_per_unit_piastres")
  /// The example month on the proposal page
  expectedMonthlyOrders       Int?              @map("expected_monthly_orders")
  averageOrderPiastres        Int?              @map("average_order_piastres")
  minimumMonthlyFeePiastres   Int?              @map("minimum_monthly_fee_piastres")
  securityDepositPiastres     Int?              @map("security_deposit_piastres")
  creditLimitPiastres         Int?              @map("credit_limit_piastres")
  /// The contract starts on this day (null: the day the rep confirms)
  contractStartDate           DateTime?         @map("contract_start_date") @db.Date
  /// Months the contract runs (null: no end date)
  contractMonths              Int?              @map("contract_months")
  noticeDays                  Int               @map("notice_days")
  terms                       String?
  /// Payment terms and promises carried into the contract (null: standard)
  payoutSchedule              PayoutSchedule?   @map("payout_schedule")
  minimumPayoutPiastres       Int?              @map("minimum_payout_piastres")
  promiseMinutes              Int?              @map("promise_minutes")
  deliveryAttempts            Int?              @map("delivery_attempts")
  /// The largest discount against the fee settings, in basis points
  maxDiscountBp               Int               @default(0) @map("max_discount_bp")
  /// A discount past sales.max_discount_bp: a sales manager approves before it is sent
  needsApproval               Boolean           @default(false) @map("needs_approval")
  approvalRequestedAt         DateTime?         @map("approval_requested_at")
  approvedById                String?           @map("approved_by_id")
  approvedAt                  DateTime?         @map("approved_at")
  /// The public link /p/<token>, made when it is sent
  token                       String?           @unique
  sentAt                      DateTime?         @map("sent_at")
  sentById                    String?           @map("sent_by_id")
  validUntil                  DateTime?         @map("valid_until") @db.Date
  viewedAt                    DateTime?         @map("viewed_at")
  acceptedAt                  DateTime?         @map("accepted_at")
  declinedAt                  DateTime?         @map("declined_at")
  signerName                  String?           @map("signer_name")
  signerTitle                 String?           @map("signer_title")
  declineReason               String?           @map("decline_reason")
  /// When it expired or a newer version replaced it
  closedAt                    DateTime?         @map("closed_at")
  /// The rep confirmed the acceptance: the merchant, its owner login and contract exist
  confirmedAt                 DateTime?         @map("confirmed_at")
  confirmedById               String?           @map("confirmed_by_id")
  merchantId                  String?           @map("merchant_id")
  createdById                 String            @map("created_by_id")
  idempotencyKey              String?           @unique @map("idempotency_key")
  createdAt                   DateTime          @default(now()) @map("created_at")
  updatedAt                   DateTime          @updatedAt @map("updated_at")

  deal        CrmDeal              @relation(fields: [dealId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("crm_proposal_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?                @relation("crm_proposal_approved_by", fields: [approvedById], references: [id], onDelete: Restrict)
  sentBy      User?                @relation("crm_proposal_sent_by", fields: [sentById], references: [id], onDelete: Restrict)
  confirmedBy User?                @relation("crm_proposal_confirmed_by", fields: [confirmedById], references: [id], onDelete: Restrict)
  merchant    Merchant?            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  tiers       CrmProposalTier[]
  products    CrmProposalProduct[]

  @@unique([dealId, version])
  @@index([status])
  @@map("crm_proposals")
}

/// Volume tiers offered on every fee, as merchant_contract_version_tiers.
model CrmProposalTier {
  id                          String @id @default(cuid())
  proposalId                  String @map("proposal_id")
  fromOrder                   Int    @map("from_order")
  shippingFeePiastres         Int?   @map("shipping_fee_piastres")
  fixedFeePiastres            Int?   @map("fixed_fee_piastres")
  percentBp                   Int?   @map("percent_bp")
  codPercentBp                Int?   @map("cod_percent_bp")
  failedDeliveryPiastres      Int?   @map("failed_delivery_piastres")
  receivingPerUnitPiastres    Int?   @map("receiving_per_unit_piastres")
  storagePerUnitMonthPiastres Int?   @map("storage_per_unit_month_piastres")
  returnPerUnitPiastres       Int?   @map("return_per_unit_piastres")
  packagingChargePiastres     Int?   @map("packaging_charge_piastres")

  proposal CrmProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, fromOrder])
  @@map("crm_proposal_tiers")
}

/// A per product price offered on a proposal: a product picked from the merchant's list, or a
/// free row (SKU and name). On confirm it maps to the merchant's product by SKU
/// (matched_sku_id); a row without one stays as a note listed for the rep.
model CrmProposalProduct {
  id            String    @id @default(cuid())
  proposalId    String    @map("proposal_id")
  position      Int
  skuId         String?   @map("sku_id")
  sku           String
  name          String
  pricePiastres Int       @map("price_piastres")
  /// Set when the proposal is confirmed: the product it became, or null (unmatched)
  matchedSkuId  String?   @map("matched_sku_id")
  confirmedAt   DateTime? @map("confirmed_at")

  proposal CrmProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  product  Sku?        @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@unique([proposalId, position])
  @@map("crm_proposal_products")
}

/// A rep's targets for a Cairo month (YYYY-MM), set by the sales managers.
model CrmTarget {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  month              String
  dealsWon           Int      @map("deals_won")
  orders             Int
  feeRevenuePiastres Int      @map("fee_revenue_piastres")
  updatedById        String   @map("updated_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user      User @relation("crm_target_user", fields: [userId], references: [id], onDelete: Restrict)
  updatedBy User @relation("crm_target_updated_by", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([userId, month])
  @@map("crm_targets")
}

/// A rep's commission for a Cairo month (one per rep and month, key commission:<rep>:<month>).
model CrmCommission {
  id               String              @id @default(cuid())
  userId           String              @map("user_id")
  month            String
  status           CrmCommissionStatus @default(draft)
  /// Fees of the month counted for the rep: qualified merchants inside their commission months
  revenuePiastres  Int                 @default(0) @map("revenue_piastres")
  /// The rep's fees target for the month (null: none set)
  targetPiastres   Int?                @map("target_piastres")
  /// hit (counted fees at or above a target above 0), missed or no_target
  outcome          String              @default("hit")
  /// What the lines add up to (0 unless the target was hit)
  computedPiastres Int                 @map("computed_piastres")
  /// What is paid: the computed amount, or the manager's adjustment
  amountPiastres   Int                 @map("amount_piastres")
  adjustReason     String?             @map("adjust_reason")
  adjustedById     String?             @map("adjusted_by_id")
  adjustedAt       DateTime?           @map("adjusted_at")
  approvedById     String?             @map("approved_by_id")
  approvedAt       DateTime?           @map("approved_at")
  /// payroll (employees, taxed in the salary run) or bonus (outsourced, paid directly)
  paidVia          String?             @map("paid_via")
  paidEntryId      String?             @map("paid_entry_id")
  paidAt           DateTime?           @map("paid_at")
  idempotencyKey   String              @unique @map("idempotency_key")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user       User                @relation("crm_commission_user", fields: [userId], references: [id], onDelete: Restrict)
  adjustedBy User?               @relation("crm_commission_adjusted_by", fields: [adjustedById], references: [id], onDelete: Restrict)
  approvedBy User?               @relation("crm_commission_approved_by", fields: [approvedById], references: [id], onDelete: Restrict)
  paidEntry  LedgerEntry?        @relation(fields: [paidEntryId], references: [id], onDelete: Restrict)
  lines      CrmCommissionLine[]

  @@unique([userId, month])
  @@index([status, month])
  @@map("crm_commissions")
}

/// One won merchant's fees in the month and the commission on them.
model CrmCommissionLine {
  id             String  @id @default(cuid())
  commissionId   String  @map("commission_id")
  dealId         String  @map("deal_id")
  merchantId     String  @map("merchant_id")
  /// 1 is the month the deal was won
  monthIndex     Int     @map("month_index")
  /// false: still pending (not active for enough months), its fees are not counted
  qualified      Boolean @default(true)
  /// Distinct Cairo months with a delivered order since the win, up to the month's end
  activeMonths   Int     @default(0) @map("active_months")
  /// The month it qualified in (YYYY-MM)
  qualifiedMonth String? @map("qualified_month")
  feesPiastres   Int     @map("fees_piastres")
  rateBp         Int     @map("rate_bp")
  /// The share of the fees when the target was hit, else 0
  amountPiastres Int     @map("amount_piastres")

  commission CrmCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  deal       CrmDeal       @relation(fields: [dealId], references: [id], onDelete: Restrict)
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([commissionId, dealId])
  @@map("crm_commission_lines")
}

/// A one time link for a new account's owner to choose a password (stored hashed).
model UserSetupToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User  @relation("user_setup_token_user", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("user_setup_token_created_by", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_setup_tokens")
}

// ─── HR phase 3: leave, violations, corrections (docs/HR.md "Phase 3 as built") ──

/// annual: the days come off the annual balance; own: the type keeps its own yearly
/// allowance; none: no balance (unpaid leave)
enum LeaveBalanceKind {
  annual
  own
  none

  @@map("leave_balance_kind")
}

/// A kind of leave HR manages (annual, casual, sick, unpaid, maternity...).
model LeaveType {
  id                String           @id @default(cuid())
  code              String           @unique
  nameEn            String           @map("name_en")
  nameAr            String           @map("name_ar")
  paid              Boolean          @default(true)
  balance           LeaveBalanceKind @default(annual)
  /// own: the yearly allowance; annual: an optional yearly cap inside the annual balance
  yearlyDays        Decimal?         @map("yearly_days") @db.Decimal(6, 2)
  /// The allowance (own) or the cap (annual) is the setting hr.casual_leave_days
  casualAllowance   Boolean          @default(false) @map("casual_allowance")
  /// A document is needed when a request is longer than this many days (0: always; null: never)
  documentAboveDays Int?             @map("document_above_days")
  maxDaysPerRequest Int?             @map("max_days_per_request")
  noticeDays        Int              @default(0) @map("notice_days")
  /// Employees may ask for it themselves from My HR (otherwise HR asks for them)
  selfRequest       Boolean          @default(true) @map("self_request")
  isActive          Boolean          @default(true) @map("is_active")
  sort              Int              @default(0)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  requests    LeaveRequest[]
  adjustments LeaveAdjustment[]

  @@map("leave_types")
}

enum LeaveRequestStatus {
  pending_manager
  pending_hr
  approved
  rejected
  cancelled

  @@map("leave_request_status")
}

/// A leave request (LV-000001): the person's manager approves first, then HR.
model LeaveRequest {
  id                  String             @id @default(cuid())
  number              Int                @unique @default(autoincrement())
  employeeId          String             @map("employee_id")
  typeId              String             @map("type_id")
  fromDay             DateTime           @map("from_day") @db.Date
  toDay               DateTime           @map("to_day") @db.Date
  halfDay             Boolean            @default(false) @map("half_day")
  /// Working days asked for (weekends, days off and holidays not counted)
  days                Decimal            @db.Decimal(6, 2)
  note                String?
  status              LeaveRequestStatus
  /// The manager in force when asked (null: straight to HR)
  managerEmployeeId   String?            @map("manager_employee_id")
  requestedById       String             @map("requested_by_id")
  /// HR asked for the person (on their behalf)
  onBehalf            Boolean            @default(false) @map("on_behalf")
  /// HR allowed it above the balance (the days beyond it are unpaid) or further back
  overrideBalance     Boolean            @default(false) @map("override_balance")
  overrideBackdate    Boolean            @default(false) @map("override_backdate")
  documentContentType String?            @map("document_content_type")
  documentData        Bytes?             @map("document_data")
  documentName        String?            @map("document_name")
  managerDecidedById  String?            @map("manager_decided_by_id")
  managerDecidedAt    DateTime?          @map("manager_decided_at")
  hrDecidedById       String?            @map("hr_decided_by_id")
  hrDecidedAt         DateTime?          @map("hr_decided_at")
  rejectedById        String?            @map("rejected_by_id")
  rejectedAt          DateTime?          @map("rejected_at")
  rejectReason        String?            @map("reject_reason")
  cancelledById       String?            @map("cancelled_by_id")
  cancelledAt         DateTime?          @map("cancelled_at")
  cancelReason        String?            @map("cancel_reason")
  idempotencyKey      String?            @unique @map("idempotency_key")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type     LeaveType         @relation(fields: [typeId], references: [id], onDelete: Restrict)
  dayRows  LeaveRequestDay[]

  @@index([employeeId, fromDay])
  @@index([status])
  @@map("leave_requests")
}

/// One working day of a leave request (a half day is 0.5). Paid is fixed when HR approves:
/// unpaid types and days beyond the balance are unpaid and reach the payroll run once.
model LeaveRequestDay {
  id                String   @id @default(cuid())
  requestId         String   @map("request_id")
  employeeId        String   @map("employee_id")
  day               DateTime @db.Date
  fraction          Decimal  @db.Decimal(3, 2)
  paid              Boolean  @default(true)
  /// The salary run that took this unpaid day (once only) and how much it took
  payrollEntryId    String?  @map("payroll_entry_id")
  deductionPiastres Int?     @map("deduction_piastres")

  request  LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([requestId, day])
  @@index([employeeId, day])
  @@map("leave_request_days")
}

/// A change HR makes to a balance with a reason (never edited: a correction is another row).
/// No type: the annual balance.
model LeaveAdjustment {
  id          String   @id @default(cuid())
  employeeId  String   @map("employee_id")
  typeId      String?  @map("type_id")
  /// The leave year it changes (the calendar year the leave year starts in)
  year        Int
  days        Decimal  @db.Decimal(6, 2)
  reason      String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type     LeaveType? @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([employeeId, year])
  @@map("leave_adjustments")
}

enum ViolationCategory {
  attendance
  conduct
  cash
  damage
  safety

  @@map("violation_category")
}

enum PenaltyKind {
  verbal_warning
  written_warning
  deduction_days
  deduction_amount
  suspension_days
  termination_review

  @@map("penalty_kind")
}

/// A violation HR manages, with its escalation ladder.
model ViolationType {
  id        String            @id @default(cuid())
  code      String            @unique
  nameEn    String            @map("name_en")
  nameAr    String            @map("name_ar")
  category  ViolationCategory
  isActive  Boolean           @default(true) @map("is_active")
  sort      Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  steps       ViolationStep[]
  violations  Violation[]
  suggestions ViolationSuggestion[]

  @@map("violation_types")
}

/// The penalty of the nth violation of a type inside hr.violation_period_days.
model ViolationStep {
  id             String      @id @default(cuid())
  typeId         String      @map("type_id")
  step           Int
  penalty        PenaltyKind
  /// deduction_days and suspension_days (0.25 allowed)
  days           Decimal?    @db.Decimal(6, 2)
  /// deduction_amount; null: the amount is entered when recording (a cash shortage)
  amountPiastres Int?        @map("amount_piastres")

  type ViolationType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([typeId, step])
  @@map("violation_steps")
}

enum ViolationStatus {
  recorded
  appealed
  final
  cancelled

  @@map("violation_status")
}

/// A violation recorded for a person (VIO-000001), with the penalty of its ladder step.
model Violation {
  id                  String          @id @default(cuid())
  number              Int             @unique @default(autoincrement())
  employeeId          String          @map("employee_id")
  typeId              String          @map("type_id")
  occurredOn          DateTime        @map("occurred_on") @db.Date
  description         String
  /// The step the ladder gave, and the one applied (HR may change it with a reason)
  suggestedStep       Int             @map("suggested_step")
  step                Int
  stepReason          String?         @map("step_reason")
  penalty             PenaltyKind
  days                Decimal?        @db.Decimal(6, 2)
  amountPiastres      Int?            @map("amount_piastres")
  status              ViolationStatus @default(recorded)
  recordedById        String          @map("recorded_by_id")
  recordedAt          DateTime        @default(now()) @map("recorded_at")
  appealReason        String?         @map("appeal_reason")
  appealedAt          DateTime?       @map("appealed_at")
  /// upheld or cancelled by HR manage (never the person who recorded it)
  decision            String?
  decisionNote        String?         @map("decision_note")
  decidedById         String?         @map("decided_by_id")
  decidedAt           DateTime?       @map("decided_at")
  finalAt             DateTime?       @map("final_at")
  evidenceContentType String?         @map("evidence_content_type")
  evidenceData        Bytes?          @map("evidence_data")
  evidenceName        String?         @map("evidence_name")
  /// The salary run that took the deduction (once only) and how much it took
  payrollEntryId      String?         @map("payroll_entry_id")
  deductionPiastres   Int?            @map("deduction_piastres")
  idempotencyKey      String?         @unique @map("idempotency_key")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type       ViolationType        @relation(fields: [typeId], references: [id], onDelete: Restrict)
  suggestion ViolationSuggestion?

  @@index([employeeId, typeId, occurredOn])
  @@index([status])
  @@map("violations")
}

/// A violation the attendance close suggests (late past the grace, or absent without leave):
/// one per person and day; HR confirms it onto the ladder or dismisses it.
model ViolationSuggestion {
  id          String    @id @default(cuid())
  employeeId  String    @map("employee_id")
  day         DateTime  @db.Date
  /// late or absent
  kind        String
  lateMinutes Int       @default(0) @map("late_minutes")
  typeId      String?   @map("type_id")
  /// open, confirmed, dismissed
  status      String    @default("open")
  violationId String?   @unique @map("violation_id")
  decidedById String?   @map("decided_by_id")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  employee  Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type      ViolationType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  violation Violation?     @relation(fields: [violationId], references: [id], onDelete: SetNull)

  @@unique([employeeId, day])
  @@index([status])
  @@map("violation_suggestions")
}

enum CorrectionStatus {
  pending_manager
  pending_hr
  applied
  rejected
  cancelled

  @@map("correction_status")
}

/// A person asks to fix a day (COR-000001): their manager approves, then HR applies it
/// through the attendance corrections (manual punches).
model AttendanceCorrection {
  id                 String           @id @default(cuid())
  number             Int              @unique @default(autoincrement())
  employeeId         String           @map("employee_id")
  day                DateTime         @db.Date
  problem            String
  proposedIn         DateTime?        @map("proposed_in")
  proposedOut        DateTime?        @map("proposed_out")
  status             CorrectionStatus
  managerEmployeeId  String?          @map("manager_employee_id")
  requestedById      String           @map("requested_by_id")
  managerDecidedById String?          @map("manager_decided_by_id")
  managerDecidedAt   DateTime?        @map("manager_decided_at")
  hrDecidedById      String?          @map("hr_decided_by_id")
  hrDecidedAt        DateTime?        @map("hr_decided_at")
  rejectedById       String?          @map("rejected_by_id")
  rejectedAt         DateTime?        @map("rejected_at")
  rejectReason       String?          @map("reject_reason")
  cancelledAt        DateTime?        @map("cancelled_at")
  /// The punches HR added when applying it
  punchIds           String[]         @default([]) @map("punch_ids")
  idempotencyKey     String?          @unique @map("idempotency_key")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, day])
  @@index([status])
  @@map("attendance_corrections")
}

// ─── HR phase 2: guided flows (docs/HR.md "Phase 2 as built") ──────────────────

enum HireDraftStatus {
  open
  done
  discarded

  @@map("hire_draft_status")
}

/// A new hire being filled in step by step (the wizard saves between steps, so HR can come
/// back). Creating it makes the account, the file and the rest in one transaction.
model HireDraft {
  id             String          @id @default(cuid())
  status         HireDraftStatus @default(open)
  /// The step HR stopped at (person, job, pay, documents, access, review)
  step           String          @default("person")
  /// What the steps hold so far (packages/shared hireDraftDataSchema)
  data           Json            @default("{}")
  createdById    String          @map("created_by_id")
  /// The file made from it
  employeeId     String?         @unique @map("employee_id")
  /// The key of the create call, so a retry answers the same file
  idempotencyKey String?         @unique @map("idempotency_key")
  /// Created without the pay step (no salaries switch): an HR manager with salaries adds it
  payPending     Boolean         @default(false) @map("pay_pending")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  createdBy User            @relation("hire_draft_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  employee  Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  files     HireDraftFile[]

  @@index([status])
  @@map("hire_drafts")
}

/// A photo or document added to a draft before the file exists; copied to the file on create.
model HireDraftFile {
  id          String    @id @default(cuid())
  draftId     String    @map("draft_id")
  /// photo or document
  kind        String
  typeId      String?   @map("type_id")
  title       String?
  issuedOn    DateTime? @map("issued_on") @db.Date
  expiresOn   DateTime? @map("expires_on") @db.Date
  contentType String    @map("content_type")
  data        Bytes
  sizeBytes   Int       @map("size_bytes")
  createdAt   DateTime  @default(now()) @map("created_at")

  draft HireDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@map("hire_draft_files")
}

/// A person leaving through the leaving wizard: the last day, the reason, the notice check, the
/// settlement figures handed to payroll and when the account is disabled.
model EmployeeExit {
  id             String    @id @default(cuid())
  employeeId     String    @map("employee_id")
  lastDay        DateTime  @map("last_day") @db.Date
  /// resignation, termination, end_of_contract, other
  reason         String
  note           String?
  noticeGivenOn  DateTime? @map("notice_given_on") @db.Date
  /// hr.notice_days when it was recorded
  noticeDays     Int       @map("notice_days")
  /// Days the notice falls short of noticeDays (0: enough)
  noticeShortBy  Int       @default(0) @map("notice_short_by")
  /// Company items ticked as returned (titles of the offboarding tasks)
  itemsReturned  String[]  @default([]) @map("items_returned")
  /// The settlement figures at confirmation (money read only with the salaries switch)
  settlement     Json
  /// The end of the last day (Cairo): the job disables the account then
  disableAt      DateTime  @map("disable_at")
  disabledAt     DateTime? @map("disabled_at")
  /// The person came back before the account was disabled: nothing was disabled
  cancelledAt    DateTime? @map("cancelled_at")
  createdById    String    @map("created_by_id")
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")

  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("employee_exit_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  reassignments Reassignment[]

  @@index([employeeId])
  @@index([disabledAt, disableAt])
  @@map("employee_exits")
}

/// Something a leaver looked after (people they managed, a department they headed, merchants,
/// deals, companies) that was unassigned and needs a new owner, or got one in the wizard.
model Reassignment {
  id           String    @id @default(cuid())
  exitId       String    @map("exit_id")
  /// manager_of, department_head, account_manager, deal_owner, company_owner
  kind         String
  entityId     String    @map("entity_id")
  label        String
  /// The new owner (an employee for manager_of and department_head, else a user)
  newOwnerId   String?   @map("new_owner_id")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  exit EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)

  @@unique([exitId, kind, entityId])
  @@index([resolvedAt])
  @@map("reassignments")
}

/// HR asked a person to send a missing or expiring document (once per type and Cairo day):
/// a push notification and a notice in My HR.
model DocumentReminder {
  id          String   @id @default(cuid())
  employeeId  String   @map("employee_id")
  typeId      String   @map("type_id")
  day         DateTime @db.Date
  /// The state the document was in (missing, rejected, expiring, expired)
  state       String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User     @relation("document_reminder_created_by", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([employeeId, typeId, day])
  @@index([createdAt])
  @@map("document_reminders")
}

// ─── Accounting UX phase A: list views and the chatter ──────────────────────────

/// A saved view of a list (search, filters, grouping, sorting), per person and list.
model UserListFavorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// The list's id (payouts, bills, journal...)
  listKey   String   @map("list_key")
  name      String
  /// The list state as search params (serializeListState)
  query     String
  /// Opens instead of the list's own default
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listKey, name])
  @@index([userId, listKey])
  @@map("user_list_favorites")
}

/// The columns a person chose to see in a list.
model UserListPrefs {
  userId    String   @map("user_id")
  listKey   String   @map("list_key")
  columns   String[]
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, listKey])
  @@map("user_list_prefs")
}

/// A note written on a record's chatter (append only: a trigger refuses UPDATE and DELETE).
model RecordNote {
  id         String   @id @default(cuid())
  /// The audit entity type (payout, bill, ledger_entry...)
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  authorId   String   @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@map("record_notes")
}

/// "Remind me": a scheduled activity on a record for one person, due on a Cairo day.
model RecordActivity {
  id          String    @id @default(cuid())
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  /// The record's number or name when it was scheduled, for lists of activities
  label       String
  /// The record's page
  href        String
  assigneeId  String    @map("assignee_id")
  createdById String    @map("created_by_id")
  dueOn       DateTime  @map("due_on") @db.Date
  note        String
  doneAt      DateTime? @map("done_at")
  doneById    String?   @map("done_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  assignee  User @relation("record_activity_assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy User @relation("record_activity_created_by", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([assigneeId, doneAt, dueOn])
  @@map("record_activities")
}

enum ExpenseClaimStatus {
  /// Waiting for the claimant's manager in force
  pending_manager
  /// Approved by the manager (or the person has none): waiting for accounting to pay
  pending_accounting
  paid
  rejected
  cancelled

  @@map("expense_claim_status")
}

/// A work cost an employee paid from their own pocket and claims back (EC-000001). Their
/// manager in force approves, accounting pays it from a bank or cash box.
model ExpenseClaim {
  id                 String             @id @default(cuid())
  /// Gapless serial number shown as EC-000001
  number             Int                @unique
  employeeId         String             @map("employee_id")
  /// The claimant's account (the person paid back)
  userId             String             @map("user_id")
  /// The store the cost belongs to; none is a company wide cost
  darkStoreId        String?            @map("dark_store_id")
  /// An expense category finance marked claimable
  expenseAccountId   String             @map("expense_account_id")
  amountPiastres     Int                @map("amount_piastres")
  /// VAT shown on the receipt (a tax invoice with the seller's tax number), claimed back as
  /// input VAT when paid; null or 0: none. Always less than the amount (paid back in full)
  vatPiastres        Int?               @map("vat_piastres")
  /// The Cairo day the person paid
  paidOn             DateTime           @map("paid_on") @db.Date
  note               String
  /// The receipt photo (kind receipt), required
  photoId            String             @map("photo_id")
  status             ExpenseClaimStatus @default(pending_manager)
  /// The manager in force when the claim was made (null: straight to accounting)
  managerEmployeeId  String?            @map("manager_employee_id")
  managerDecidedById String?            @map("manager_decided_by_id")
  managerDecidedAt   DateTime?          @map("manager_decided_at")
  paidById           String?            @map("paid_by_id")
  paidAt             DateTime?          @map("paid_at")
  /// The bank or cash box it was paid from
  paidFromAccountId  String?            @map("paid_from_account_id")
  reference          String?
  entryId            String?            @unique @map("entry_id")
  rejectedById       String?            @map("rejected_by_id")
  rejectedAt         DateTime?          @map("rejected_at")
  rejectReason       String?            @map("reject_reason")
  /// manager or accounting
  rejectedStep       String?            @map("rejected_step")
  cancelledAt        DateTime?          @map("cancelled_at")
  idempotencyKey     String             @unique @map("idempotency_key")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user             User           @relation("expense_claim_user", fields: [userId], references: [id], onDelete: Restrict)
  darkStore        DarkStore?     @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  expenseAccount   LedgerAccount  @relation("expense_claim_account", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  photo            Photo          @relation(fields: [photoId], references: [id], onDelete: Restrict)
  managerDecidedBy User?          @relation("expense_claim_manager_decided_by", fields: [managerDecidedById], references: [id], onDelete: Restrict)
  paidBy           User?          @relation("expense_claim_paid_by", fields: [paidById], references: [id], onDelete: Restrict)
  paidFrom         LedgerAccount? @relation("expense_claim_paid_from", fields: [paidFromAccountId], references: [id], onDelete: Restrict)
  rejectedBy       User?          @relation("expense_claim_rejected_by", fields: [rejectedById], references: [id], onDelete: Restrict)
  entry            LedgerEntry?   @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([managerEmployeeId, status])
  @@map("expense_claims")
}

// ─── Loans, cost tags and stored units (migration 20261231180000_loans_tags_fx) ─────

/// The user's own analytic tags (a campaign, a new branch project), set on expense lines,
/// journal lines, bills and petty cash beside the store, merchant and rider tags.
model CostTag {
  id          String   @id @default(cuid())
  nameEn      String   @unique @map("name_en")
  nameAr      String   @map("name_ar")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  lines     LedgerLine[]
  pettyCash PettyCashExpense[]

  @@map("cost_tags")
}

enum LoanLender {
  /// A bank or another company, kept as a supplier
  supplier
  /// The owner lending the company money
  owner

  @@map("loan_lender")
}

enum LoanMethod {
  /// Equal monthly instalments; interest on the balance still owed
  declining
  /// Interest on the whole amount for every month, principal in equal parts
  flat

  @@map("loan_method")
}

enum LoanStatus {
  active
  repaid

  @@map("loan_status")
}

/// Money the company borrowed (LN-000001, gapless). Owed in its own account under 2700 and
/// repaid by the schedule's monthly instalments (principal and interest).
model Loan {
  id                 String     @id @default(cuid())
  number             Int        @unique
  lender             LoanLender
  supplierId         String?    @map("supplier_id")
  /// The owner's name when the owner lends
  lenderName         String?    @map("lender_name")
  principalPiastres  Int        @map("principal_piastres")
  /// The bank or cash box the money came into
  moneyAccountId     String     @map("money_account_id")
  /// What we owe on this loan (2701, 2702...)
  liabilityAccountId String     @unique @map("liability_account_id")
  startDay           DateTime   @map("start_day") @db.Date
  annualRateBp       Int        @map("annual_rate_bp")
  method             LoanMethod
  months             Int
  firstPaymentDay    DateTime   @map("first_payment_day") @db.Date
  reference          String
  memo               String?
  status             LoanStatus @default(active)
  /// The entry that received the money
  entryId            String     @unique @map("entry_id")
  createdById        String     @map("created_by_id")
  createdAt          DateTime   @default(now()) @map("created_at")

  supplier         Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  moneyAccount     LedgerAccount    @relation("loan_money_account", fields: [moneyAccountId], references: [id], onDelete: Restrict)
  liabilityAccount LedgerAccount    @relation("loan_liability_account", fields: [liabilityAccountId], references: [id], onDelete: Restrict)
  entry            LedgerEntry      @relation(fields: [entryId], references: [id], onDelete: Restrict)
  instalments      LoanInstalment[]

  @@map("loans")
}

/// One line of a loan's schedule, fixed when the loan is recorded. Paid once (its entry).
model LoanInstalment {
  id                 String    @id @default(cuid())
  loanId             String    @map("loan_id")
  seq                Int
  dueDay             DateTime  @map("due_day") @db.Date
  instalmentPiastres Int       @map("instalment_piastres")
  interestPiastres   Int       @map("interest_piastres")
  principalPiastres  Int       @map("principal_piastres")
  /// What is still owed after this instalment
  remainingPiastres  Int       @map("remaining_piastres")
  paidAt             DateTime? @map("paid_at")
  entryId            String?   @unique @map("entry_id")

  loan  Loan         @relation(fields: [loanId], references: [id], onDelete: Restrict)
  entry LedgerEntry? @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([loanId, seq])
  @@index([dueDay])
  @@map("loan_instalments")
}

/// Units each merchant had in each store at the end of a Cairo day (every bin), written by
/// the storage charge job for every merchant whether or not they pay storage. Merchant profit
/// shares a store's rent by these unit days.
model StockUnitDay {
  darkStoreId String   @map("dark_store_id")
  merchantId  String   @map("merchant_id")
  day         DateTime @db.Date
  units       Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([darkStoreId, merchantId, day])
  @@index([day])
  @@map("stock_unit_days")
}

/// A Cairo day the storage charge job has done (charged, or skipped inside closed books).
model StorageDay {
  day       DateTime @id @db.Date
  charged   Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("storage_days")
}

// ─── Payment reminders to merchants who owe us (migration 20261231170000) ──────

/// One payment reminder sent to a merchant whose wallet is in debit: by the daily job or by
/// finance (Send reminder now). Counted per debit period: the moment the wallet last turned
/// to debit, so a merchant who paid and owes again starts from the first reminder.
model MerchantPaymentReminder {
  id             String   @id @default(cuid())
  merchantId     String   @map("merchant_id")
  /// When the wallet last turned to debit (the debit period this reminder belongs to)
  periodStart    DateTime @map("period_start")
  /// 1, 2, 3... within the debit period
  number         Int
  /// What the merchant owed when it was sent
  amountPiastres Int      @map("amount_piastres")
  /// Sent by hand from the receivables page (false: the daily job)
  manual         Boolean  @default(false)
  sentById       String?  @map("sent_by_id")
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, periodStart])
  @@map("merchant_payment_reminders")
}

// ─── Basata cash deposits (migration 20261231200000_basata_deposits) ─────────────

enum BasataDepositStatus {
  pending
  approved
  rejected

  @@map("basata_deposit_status")
}

/// A rider deposited the cash they collected at a Basata branch (BD-000001, gapless). Finance
/// checks the receipt photo and approves (Dr Money at Basata, Cr 1300 rider cash) or rejects
/// it. Basata's daily transfer to the bank settles approved deposits.
model BasataDeposit {
  id                String              @id @default(cuid())
  number            Int                 @unique
  riderId           String              @map("rider_id")
  /// The rider's store when the deposit was sent (scope and the store's settings)
  darkStoreId       String              @map("dark_store_id")
  amountPiastres    Int                 @map("amount_piastres")
  /// Basata's reference number on the receipt; never used twice
  reference         String              @unique
  /// When the rider says they deposited (never in the future)
  depositedAt       DateTime            @map("deposited_at")
  /// The receipt photo (kind basata_receipt), required
  photoId           String              @map("photo_id")
  status            BasataDepositStatus @default(pending)
  /// The Cairo day whose deposit deadline it counts for (the first deadline after it was sent)
  deadlineDay       DateTime            @map("deadline_day") @db.Date
  decidedById       String?             @map("decided_by_id")
  decidedAt         DateTime?           @map("decided_at")
  rejectReason      String?             @map("reject_reason")
  entryId           String?             @unique @map("entry_id")
  /// On approval: the part taken from the rider's cash (1300)
  heldPiastres      Int?                @map("held_piastres")
  /// On approval: the part given back for an earlier deadline deduction
  givenBackPiastres Int                 @default(0) @map("given_back_piastres")
  settlementId      String?             @map("settlement_id")
  idempotencyKey    String              @unique @map("idempotency_key")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  rider      Rider                @relation(fields: [riderId], references: [id], onDelete: Restrict)
  darkStore  DarkStore            @relation(fields: [darkStoreId], references: [id], onDelete: Restrict)
  photo      Photo                @relation(fields: [photoId], references: [id], onDelete: Restrict)
  decidedBy  User?                @relation("basata_deposit_decided_by", fields: [decidedById], references: [id], onDelete: Restrict)
  entry      LedgerEntry?         @relation(fields: [entryId], references: [id], onDelete: Restrict)
  settlement BasataSettlement?    @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  deductions RiderCashDeduction[]

  @@index([riderId, status])
  @@index([status, createdAt])
  @@index([settlementId])
  @@map("basata_deposits")
}

/// Basata's transfer of approved deposits to our bank, less its fee (BT-000001, gapless):
/// Dr bank (amount received), Dr Basata fees (the difference), Cr Money at Basata.
model BasataSettlement {
  id               String   @id @default(cuid())
  number           Int      @unique
  bankAccountId    String   @map("bank_account_id")
  /// The Cairo day the money reached the bank
  receivedOn       DateTime @map("received_on") @db.Date
  amountPiastres   Int      @map("amount_piastres")
  depositsPiastres Int      @map("deposits_piastres")
  feePiastres      Int      @map("fee_piastres")
  reference        String?
  entryId          String   @unique @map("entry_id")
  createdById      String   @map("created_by_id")
  idempotencyKey   String   @unique @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at")

  bankAccount LedgerAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  entry       LedgerEntry     @relation(fields: [entryId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("basata_settlement_created_by", fields: [createdById], references: [id], onDelete: Restrict)
  deposits    BasataDeposit[]

  @@map("basata_settlements")
}

/// Cash a rider still held at a deposit deadline (or a deposit refused after it), taken from
/// them: to their rider office's wallet (2500) or their rider dues (1350). A deposit approved
/// later gives it back (given_back_piastres), oldest first. One row per key.
model RiderCashDeduction {
  id                String   @id @default(cuid())
  riderId           String   @map("rider_id")
  /// deadline or rejected
  kind              String
  /// The Cairo day of the deadline
  day               DateTime @db.Date
  /// For kind rejected: the deposit that was refused
  depositId         String?  @map("deposit_id")
  /// What the rider held at the deadline (or the refused amount)
  heldPiastres      Int      @map("held_piastres")
  /// What was taken (never more than the rider still held when it was booked; may be 0)
  amountPiastres    Int      @map("amount_piastres")
  /// The rider office charged; null: the rider's own dues (1350)
  supplierId        String?  @map("supplier_id")
  entryId           String?  @unique @map("entry_id")
  givenBackPiastres Int      @default(0) @map("given_back_piastres")
  /// basata_deadline:<rider>:<day> or basata_rejected:<deposit>
  key               String   @unique
  createdAt         DateTime @default(now()) @map("created_at")

  rider    Rider          @relation(fields: [riderId], references: [id], onDelete: Restrict)
  deposit  BasataDeposit? @relation(fields: [depositId], references: [id], onDelete: Restrict)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  entry    LedgerEntry?   @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([riderId, createdAt])
  @@map("rider_cash_deductions")
}

/// Every time a rider was frozen and unfrozen (only Accounting unfreezes, with a reason).
model RiderFreeze {
  id             String    @id @default(cuid())
  riderId        String    @map("rider_id")
  /// deposit_deadline or deposit_rejected
  reason         String
  /// The Cairo day of the deadline that froze them
  day            DateTime? @db.Date
  amountPiastres Int       @default(0) @map("amount_piastres")
  frozenAt       DateTime  @map("frozen_at")
  frozenById     String?   @map("frozen_by_id")
  unfrozenAt     DateTime? @map("unfrozen_at")
  unfrozenById   String?   @map("unfrozen_by_id")
  unfreezeReason String?   @map("unfreeze_reason")

  rider      Rider @relation(fields: [riderId], references: [id], onDelete: Restrict)
  frozenBy   User? @relation("rider_freeze_frozen_by", fields: [frozenById], references: [id], onDelete: Restrict)
  unfrozenBy User? @relation("rider_freeze_unfrozen_by", fields: [unfrozenById], references: [id], onDelete: Restrict)

  @@index([riderId, frozenAt])
  @@map("rider_freezes")
}

/// The deposit deadline job, once per Cairo day (skipped: the deadline was switched off).
model CashDeadlineRun {
  day             DateTime @id @db.Date
  deadlineAt      DateTime @map("deadline_at")
  skipped         Boolean  @default(false)
  frozen          Int      @default(0)
  chargedPiastres Int      @default(0) @map("charged_piastres")
  ranAt           DateTime @default(now()) @map("ran_at")

  @@map("cash_deadline_runs")
}
