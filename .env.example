# Copy to .env and fill in. Never commit .env.

# Database (local docker compose defaults)
DATABASE_URL=postgresql://shiply:shiply@localhost:5432/shiplynow
# Used by the API test suite; it is migrated and wiped on every run
TEST_DATABASE_URL=postgresql://shiply:shiply@localhost:5432/shiplynow_test
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true behind HTTPS (staging, production)
COOKIE_SECURE=false

# Optional: Google Geocoding API key for address lookups in /coverage.
# Without it, coverage by map point still works.
GOOGLE_MAPS_API_KEY=
# Local testing without a Google key: GEOCODER=osm uses OpenStreetMap (never in production)
GEOCODER=google
# Where admin's area map import asks OpenStreetMap (the free public service by default)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Web (Next.js). JWT_ACCESS_SECRET above must also be visible to the web app.
API_URL=http://localhost:4000

# Seed: first admin user
SEED_ADMIN_EMAIL=admin@shiplynow.local
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Shiply Admin
# Password for the demo store staff and riders (falls back to SEED_ADMIN_PASSWORD)
SEED_DEMO_PASSWORD=change-me-demo
# Parcel network demo people (agents, hub staff, couriers, merchants); set to off to skip them
SEED_NETWORK_DEMO=
# all = the network serves every governorate (default: the Cairo and Giza launch)
SEED_COVERAGE=
# Demo month: true loads one month of simulated orders, stock, cash and finance (pnpm db:demo,
# or once at container start after the seed). It runs once; a later run does nothing.
# Never set it on a database with real merchants.
DEMO_LOAD=false
# Fresh start (docs/DEPLOY.md): set to WIPE-DEMO-2026-11-07 for ONE deploy to wipe all demo
# activity and sample people and merchants (keeps places, settings, HR structure, chart of
# accounts, admins and Nabta), then remove it. Runs once per database; any other value does nothing.
FRESH_START=

# Shopify app (Dev Dashboard > Shiply Now > Settings). The client ID is not secret;
# the client secret signs Shopify's requests and protects stored shop tokens. Without
# both, the Shopify connection stays off.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10

# Slack app for tickets (optional; without them tickets stay inside Shiply). See docs/SLACK.md
# E-invoice (Egyptian Tax Authority): the API client made on the ETA portal (ERP system
# registration). Empty means invoices are kept and signed but nothing is sent.
ETA_ENV=preprod
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Web push notifications for phones and browsers (optional; without all three nothing is sent and
# the Notifications page hides the switch). Make a key pair once with:
#   npx web-push generate-vapid-keys
# The public key is not secret; keep the private key secret. Changing the pair means every
# device must turn notifications on again. See docs/DEPLOY.md
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push services may contact about our messages, for example mailto:ops@your-domain.com
VAPID_SUBJECT=

# Email to merchants: statements after payouts, payout notices, monthly tax invoices (optional;
# without SMTP_HOST and SMTP_FROM nothing is sent, the outbox waits and the screens say email is
# not set up). Any SMTP service works (Amazon SES, Mailgun, Brevo, Google Workspace...).
# Port 587 uses STARTTLS, 465 uses TLS. Keep SMTP_PASS secret. See docs/DEPLOY.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender, for example: Shiply Now <billing@your-domain.com>
SMTP_FROM=

# Text messages and WhatsApp for Shiply (delivery codes, packaging codes, sign in codes,
# parcel updates): each queued message is POSTed as JSON { channel, to, body, id } to this
# address of your SMS gateway, with the token as a bearer token. Without it messages wait in
# the outbox and delivery codes never reach customers.
MESSAGES_WEBHOOK_URL=
MESSAGES_WEBHOOK_TOKEN=

# Extra Shopify permissions once Shopify approves them (read_all_orders is already asked for). See docs/SHOPIFY_DATA.md
SHOPIFY_EXTRA_SCOPES=

# Heap limits (MB) for the API and the web server inside the one container; the defaults (192 and
# 256) suit a 512 MB instance (Next.js needs about 200). Raise them on a bigger plan.
API_HEAP_MB=
WEB_HEAP_MB=
