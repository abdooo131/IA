{
  "name": "shiply",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "eslint .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "pnpm --filter @shiply/web e2e",
    "db:up": "docker compose up -d",
    "db:deploy": "pnpm --filter @shiply/db migrate:deploy",
    "db:seed": "pnpm --filter @shiply/db seed",
    "db:test": "pnpm --filter @shiply/db test",
    "dev": "pnpm build:packages && pnpm --parallel --filter @shiply/api --filter @shiply/web dev"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "eslint": "9.15.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.8"
  }
}
