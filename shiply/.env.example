# Database and queue (docker compose maps them to these ports)
DATABASE_URL=postgresql://shiply:shiply@localhost:5433/shiply
TEST_DATABASE_URL=postgresql://shiply:shiply@localhost:5433/shiply_test
REDIS_URL=redis://localhost:6380

# Login: a random secret of at least 32 characters (the API refuses to start otherwise)
JWT_SECRET=change-me

# First admin, created by pnpm db:seed
SEED_ADMIN_EMAIL=admin@shiply.local
SEED_ADMIN_PASSWORD=change-me-too

# Google Maps, the last automatic step for unclear addresses (Geocoding API). Optional:
# without it, unclear addresses go straight to the Needs location queue.
GOOGLE_MAPS_API_KEY=

# Web app
API_URL=http://localhost:4100
