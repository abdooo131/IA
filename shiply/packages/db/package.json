{
  "name": "@shiply/db",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate:dev": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy",
    "seed": "node --env-file=../../.env dist/seed-run.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "@shiply/shared": "workspace:*",
    "argon2": "0.41.1",
    "@shiply/address": "workspace:*"
  },
  "devDependencies": {
    "prisma": "6.1.0"
  }
}
