generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "location"]
}

enum UserKind {
  staff
  agent_person
  agent_manager
  merchant_user

  @@schema("platform")
}

enum DeliveryStatus {
  pending
  done
  dead

  @@schema("platform")
}

model User {
  id                String    @id @default(cuid())
  name              String
  nameAr            String    @map("name_ar")
  email             String?   @unique
  mobile            String?   @unique
  passwordHash      String    @map("password_hash")
  kind              UserKind  @default(staff)
  active            Boolean   @default(true)
  roleId            String    @map("role_id")
  failedLogins      Int       @default(0) @map("failed_logins")
  lockedUntil       DateTime? @map("locked_until")
  /// Raised on logout and password change: older tokens stop working.
  tokenVersion      Int       @default(0) @map("token_version")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  role              JobRole   @relation(fields: [roleId], references: [id])
  sites             UserSite[]

  @@map("users")
  @@schema("platform")
}

model JobRole {
  id     String       @id @default(cuid())
  key    String       @unique
  nameEn String       @map("name_en")
  nameAr String       @map("name_ar")
  access RoleAccess[]
  users  User[]

  @@map("job_roles")
  @@schema("platform")
}

model RoleAccess {
  roleId String  @map("role_id")
  app    String
  level  String
  role   JobRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, app])
  @@map("role_access")
  @@schema("platform")
}

/// siteId is a plain id until the location module owns sites.
model UserSite {
  userId String @map("user_id")
  siteId String @map("site_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
  @@map("user_sites")
  @@schema("platform")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("platform")
}

model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String?  @map("user_id")
  action   String
  entity   String
  entityId String   @map("entity_id")
  before   Json?
  after    Json?

  @@index([entity, entityId])
  @@map("audit_log")
  @@schema("platform")
}

model IdempotencyRecord {
  key    String
  userId String   @map("user_id")
  route  String
  status Int
  body   Json
  at     DateTime @default(now())

  @@id([key, userId])
  @@map("idempotency_records")
  @@schema("platform")
}

model OutboxEvent {
  id         String          @id @default(cuid())
  type       String
  payload    Json
  key        String          @unique
  at         DateTime        @default(now())
  deliveries EventDelivery[]

  @@map("outbox_events")
  @@schema("platform")
}

model EventDelivery {
  eventId   String         @map("event_id")
  handler   String
  status    DeliveryStatus @default(pending)
  attempts  Int            @default(0)
  lastError String?        @map("last_error")
  nextAt    DateTime       @default(now()) @map("next_at")
  event     OutboxEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, handler])
  @@index([status, nextAt])
  @@map("event_deliveries")
  @@schema("platform")
}

model Company {
  id          String       @id @default(cuid())
  key         String       @unique
  nameEn      String       @map("name_en")
  nameAr      String       @map("name_ar")
  taxNumber   String?      @map("tax_number")
  costCentres CostCentre[]

  @@map("companies")
  @@schema("platform")
}

model CostCentre {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  code      String  @unique
  nameEn    String  @map("name_en")
  nameAr    String  @map("name_ar")
  company   Company @relation(fields: [companyId], references: [id])

  @@map("cost_centres")
  @@schema("platform")
}

// ── location ───────────────────────────────────────────────────────────────
// Owned by the location module only. Other modules ask LocationService.

enum SiteKind {
  sorting_facility
  last_mile_hub
  dark_store

  @@schema("location")
}

/// A governorate, city or district, neighbourhood, compound, landmark or street. parentId is
/// checked by the service, not a foreign key, so the list can be loaded in any order.
model Place {
  id           String   @id
  kind         String
  parentId     String?  @map("parent_id")
  nameEn       String   @map("name_en")
  nameAr       String   @map("name_ar")
  names        String[]
  needsParent  Boolean  @default(false) @map("needs_parent")
  served       Boolean  @default(true)
  active       Boolean  @default(true)
  mergedIntoId String?  @map("merged_into_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("places")
  @@schema("location")
}

model TaughtName {
  id         String   @id @default(cuid())
  name       String
  normalized String
  placeId    String   @map("place_id")
  byUserId   String?  @map("by_user_id")
  at         DateTime @default(now())

  @@unique([normalized, placeId])
  @@map("taught_names")
  @@schema("location")
}

model Site {
  id                String         @id @default(cuid())
  kind              SiteKind
  code              String         @unique
  nameEn            String         @map("name_en")
  nameAr            String         @map("name_ar")
  /// For a last mile hub: the sorting facility that feeds it.
  sortingFacilityId String?        @map("sorting_facility_id")
  active            Boolean        @default(true)
  sortingFacility   Site?          @relation("feeds", fields: [sortingFacilityId], references: [id])
  hubs              Site[]         @relation("feeds")
  zones             DeliveryZone[]

  @@map("sites")
  @@schema("location")
}

model DeliveryZone {
  id     String  @id @default(cuid())
  hubId  String  @map("hub_id")
  code   String  @unique
  nameEn String  @map("name_en")
  nameAr String  @map("name_ar")
  active Boolean @default(true)
  hub    Site    @relation(fields: [hubId], references: [id])

  @@map("delivery_zones")
  @@schema("location")
}

/// Who serves an area: its delivery zone (parcels) and its dark store (60 minutes).
model AreaService {
  placeId     String  @id @map("place_id")
  zoneId      String? @map("zone_id")
  darkStoreId String? @map("dark_store_id")
  notServed   Boolean @default(false) @map("not_served")

  @@map("area_services")
  @@schema("location")
}

/// Every address the system was asked to place, and how it was decided.
model AddressDecision {
  id           String    @id @default(cuid())
  service      String
  refType      String    @map("ref_type")
  refId        String    @map("ref_id")
  input        String
  phone        String?
  status       String
  confidence   Int
  placeId      String?   @map("place_id")
  method       String
  candidates   Json      @default("[]")
  resolvedById String?   @map("resolved_by_id")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([resolvedAt, createdAt])
  @@index([refType, refId])
  @@map("address_decisions")
  @@schema("location")
}

/// A customer's confirmed area: their next address is placed from here first.
model PhoneMemory {
  phone       String   @id
  placeId     String   @map("place_id")
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  source      String

  @@map("phone_memory")
  @@schema("location")
}
