generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "location", "merchants", "money", "parcels"]
}

enum UserKind {
  staff
  agent_person
  agent_manager
  merchant_user

  @@schema("platform")
}

enum DeliveryStatus {
  pending
  done
  dead

  @@schema("platform")
}

model User {
  id                String    @id @default(cuid())
  name              String
  nameAr            String    @map("name_ar")
  email             String?   @unique
  mobile            String?   @unique
  passwordHash      String    @map("password_hash")
  kind              UserKind  @default(staff)
  active            Boolean   @default(true)
  roleId            String    @map("role_id")
  failedLogins      Int       @default(0) @map("failed_logins")
  lockedUntil       DateTime? @map("locked_until")
  /// Raised on logout and password change: older tokens stop working.
  tokenVersion      Int       @default(0) @map("token_version")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  role              JobRole   @relation(fields: [roleId], references: [id])
  sites             UserSite[]

  @@map("users")
  @@schema("platform")
}

model JobRole {
  id     String       @id @default(cuid())
  key    String       @unique
  nameEn String       @map("name_en")
  nameAr String       @map("name_ar")
  access RoleAccess[]
  users  User[]

  @@map("job_roles")
  @@schema("platform")
}

model RoleAccess {
  roleId String  @map("role_id")
  app    String
  level  String
  role   JobRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, app])
  @@map("role_access")
  @@schema("platform")
}

/// siteId is a plain id until the location module owns sites.
model UserSite {
  userId String @map("user_id")
  siteId String @map("site_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
  @@map("user_sites")
  @@schema("platform")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("platform")
}

model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String?  @map("user_id")
  action   String
  entity   String
  entityId String   @map("entity_id")
  before   Json?
  after    Json?

  @@index([entity, entityId])
  @@map("audit_log")
  @@schema("platform")
}

model IdempotencyRecord {
  key    String
  userId String   @map("user_id")
  route  String
  status Int
  body   Json
  at     DateTime @default(now())

  @@id([key, userId])
  @@map("idempotency_records")
  @@schema("platform")
}

model OutboxEvent {
  id         String          @id @default(cuid())
  type       String
  payload    Json
  key        String          @unique
  at         DateTime        @default(now())
  deliveries EventDelivery[]

  @@map("outbox_events")
  @@schema("platform")
}

model EventDelivery {
  eventId   String         @map("event_id")
  handler   String
  status    DeliveryStatus @default(pending)
  attempts  Int            @default(0)
  lastError String?        @map("last_error")
  nextAt    DateTime       @default(now()) @map("next_at")
  event     OutboxEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, handler])
  @@index([status, nextAt])
  @@map("event_deliveries")
  @@schema("platform")
}

model Company {
  id          String       @id @default(cuid())
  key         String       @unique
  nameEn      String       @map("name_en")
  nameAr      String       @map("name_ar")
  taxNumber   String?      @map("tax_number")
  costCentres CostCentre[]

  @@map("companies")
  @@schema("platform")
}

model CostCentre {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  code      String  @unique
  nameEn    String  @map("name_en")
  nameAr    String  @map("name_ar")
  company   Company @relation(fields: [companyId], references: [id])

  @@map("cost_centres")
  @@schema("platform")
}

// ── location ───────────────────────────────────────────────────────────────
// Owned by the location module only. Other modules ask LocationService.

enum SiteKind {
  sorting_facility
  last_mile_hub
  dark_store

  @@schema("location")
}

/// A governorate, city or district, neighbourhood, compound, landmark or street. parentId is
/// checked by the service, not a foreign key, so the list can be loaded in any order.
model Place {
  id           String   @id
  kind         String
  parentId     String?  @map("parent_id")
  nameEn       String   @map("name_en")
  nameAr       String   @map("name_ar")
  names        String[]
  needsParent  Boolean  @default(false) @map("needs_parent")
  served       Boolean  @default(true)
  active       Boolean  @default(true)
  mergedIntoId String?  @map("merged_into_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("places")
  @@schema("location")
}

model TaughtName {
  id         String   @id @default(cuid())
  name       String
  normalized String
  placeId    String   @map("place_id")
  byUserId   String?  @map("by_user_id")
  at         DateTime @default(now())

  @@unique([normalized, placeId])
  @@map("taught_names")
  @@schema("location")
}

model Site {
  id                String         @id @default(cuid())
  kind              SiteKind
  code              String         @unique
  nameEn            String         @map("name_en")
  nameAr            String         @map("name_ar")
  /// For a last mile hub: the sorting facility that feeds it.
  sortingFacilityId String?        @map("sorting_facility_id")
  active            Boolean        @default(true)
  sortingFacility   Site?          @relation("feeds", fields: [sortingFacilityId], references: [id])
  hubs              Site[]         @relation("feeds")
  zones             DeliveryZone[]

  @@map("sites")
  @@schema("location")
}

model DeliveryZone {
  id     String  @id @default(cuid())
  hubId  String  @map("hub_id")
  code   String  @unique
  nameEn String  @map("name_en")
  nameAr String  @map("name_ar")
  active Boolean @default(true)
  hub    Site    @relation(fields: [hubId], references: [id])

  @@map("delivery_zones")
  @@schema("location")
}

/// Who serves an area: its delivery zone (parcels) and its dark store (60 minutes).
model AreaService {
  placeId     String  @id @map("place_id")
  zoneId      String? @map("zone_id")
  darkStoreId String? @map("dark_store_id")
  notServed   Boolean @default(false) @map("not_served")

  @@map("area_services")
  @@schema("location")
}

/// Every address the system was asked to place, and how it was decided.
model AddressDecision {
  id           String    @id @default(cuid())
  service      String
  refType      String    @map("ref_type")
  refId        String    @map("ref_id")
  input        String
  phone        String?
  status       String
  confidence   Int
  placeId      String?   @map("place_id")
  method       String
  candidates   Json      @default("[]")
  /// A map point, when Google Maps found one (kept as a hint even when queued).
  lat          Float?
  lng          Float?
  resolvedById String?   @map("resolved_by_id")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([resolvedAt, createdAt])
  @@index([refType, refId])
  @@map("address_decisions")
  @@schema("location")
}

/// A customer's confirmed area: their next address is placed from here first.
model PhoneMemory {
  phone       String   @id
  placeId     String   @map("place_id")
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  source      String

  @@map("phone_memory")
  @@schema("location")
}

/// Google Maps answers, one per address text: each address is paid for once, ever.
model GeocodeCache {
  normalized String   @id
  answer     Json?
  at         DateTime @default(now())

  @@index([at])
  @@map("geocode_cache")
  @@schema("location")
}

// ── merchants ──────────────────────────────────────────────────────────────
// Owned by the merchants module only. Other modules ask MerchantsService.

model Merchant {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  legalName        String?  @map("legal_name")
  logoUrl          String?  @map("logo_url")
  contactName      String   @map("contact_name")
  contactPhone     String   @map("contact_phone")
  contactEmail     String?  @map("contact_email")
  billingEmails    String[] @map("billing_emails")
  emailLanguage    String   @default("ar") @map("email_language")
  taxNumber        String?  @map("tax_number")
  taxGovernorate   String?  @map("tax_governorate")
  taxCity          String?  @map("tax_city")
  taxStreet        String?  @map("tax_street")
  taxBuilding      String?  @map("tax_building")
  bankName         String?  @map("bank_name")
  bankAccount      String?  @map("bank_account")
  iban             String?
  beneficiary      String?
  accountManagerId String?  @map("account_manager_id")
  pickupAddress    String?  @map("pickup_address")
  pickupPlaceId    String?  @map("pickup_place_id")
  pickupDecisionId String?  @map("pickup_decision_id")
  /// shiply_now, shiply
  services         String[]
  /// pending, approved, rejected, inactive
  status           String   @default("pending")
  rejectReason     String?  @map("reject_reason")
  flexShip         Boolean  @default(false) @map("flex_ship")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  users            MerchantUser[]
  contract         Contract?
  products         Product[]
  shops            ShopifyShop[]

  @@index([status])
  @@map("merchants")
  @@schema("merchants")
}

model MerchantUser {
  userId     String   @id @map("user_id")
  merchantId String   @map("merchant_id")
  /// owner, staff
  role       String   @default("staff")
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  @@map("merchant_users")
  @@schema("merchants")
}

/// A pricing zone (Greater Cairo, Delta, Upper Egypt...) made of governorates.
model PricingZone {
  id     String            @id @default(cuid())
  code   String            @unique
  nameEn String            @map("name_en")
  nameAr String            @map("name_ar")
  active Boolean           @default(true)
  areas  PricingZoneArea[]

  @@map("pricing_zones")
  @@schema("merchants")
}

model PricingZoneArea {
  /// a governorate place id; each governorate in one pricing zone only
  placeId       String      @id @map("place_id")
  pricingZoneId String      @map("pricing_zone_id")
  pricingZone   PricingZone @relation(fields: [pricingZoneId], references: [id])

  @@map("pricing_zone_areas")
  @@schema("merchants")
}

model Contract {
  id         String            @id @default(cuid())
  merchantId String            @unique @map("merchant_id")
  number     String            @unique
  merchant   Merchant          @relation(fields: [merchantId], references: [id])
  versions   ContractVersion[]

  @@map("contracts")
  @@schema("merchants")
}

/// draft -> pending -> active -> superseded; pending -> rejected. Goes live only after a second
/// person with Sales manage approves it.
model ContractVersion {
  id                  String    @id @default(cuid())
  contractId          String    @map("contract_id")
  version             Int
  status              String    @default("draft")
  startDate           DateTime  @map("start_date")
  endDate             DateTime? @map("end_date")
  noticeDays          Int       @default(30) @map("notice_days")
  payoutSchedule      String    @default("weekly") @map("payout_schedule")
  minimumPayout       Int       @default(0) @map("minimum_payout")
  minimumMonthlyFee   Int       @default(0) @map("minimum_monthly_fee")
  securityDeposit     Int       @default(0) @map("security_deposit")
  creditLimit         Int       @default(0) @map("credit_limit")
  // Shiply Now
  deliveryFee         Int       @default(0) @map("delivery_fee")
  orderFixed          Int       @default(0) @map("order_fixed")
  orderPercentBp      Int       @default(0) @map("order_percent_bp")
  codPercentBp        Int       @default(0) @map("cod_percent_bp")
  failedDeliveryFee   Int       @default(0) @map("failed_delivery_fee")
  receivingPerUnit    Int       @default(0) @map("receiving_per_unit")
  storagePerUnitMonth Int       @default(0) @map("storage_per_unit_month")
  returnPerUnit       Int       @default(0) @map("return_per_unit")
  packagingCharge     Int       @default(0) @map("packaging_charge")
  promiseMinutes      Int       @default(60) @map("promise_minutes")
  // Shiply parcels
  codFeeBp            Int       @default(0) @map("cod_fee_bp")
  returnFeeBp         Int       @default(0) @map("return_fee_bp")
  openPackageFee      Int       @default(0) @map("open_package_fee")
  deliveryAttempts    Int       @default(3) @map("delivery_attempts")
  terms               String?
  internalNote        String?   @map("internal_note")
  createdById         String    @map("created_by_id")
  submittedAt         DateTime? @map("submitted_at")
  submittedById       String?   @map("submitted_by_id")
  /// everyone who changed this draft: none of them may approve it
  editorIds           String[]  @map("editor_ids")
  approvedById        String?   @map("approved_by_id")
  approvedAt          DateTime? @map("approved_at")
  rejectedById        String?   @map("rejected_by_id")
  rejectReason        String?   @map("reject_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  contract            Contract  @relation(fields: [contractId], references: [id])
  prices              ParcelPrice[]
  tiers               VolumeTier[]

  @@unique([contractId, version])
  @@index([status])
  @@map("contract_versions")
  @@schema("merchants")
}

model ParcelPrice {
  versionId     String          @map("version_id")
  pricingZoneId String          @map("pricing_zone_id")
  /// small, medium, large, light_bulky, heavy_bulky
  size          String
  price         Int
  version       ContractVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, pricingZoneId, size])
  @@map("parcel_prices")
  @@schema("merchants")
}

model VolumeTier {
  versionId  String          @map("version_id")
  minParcels Int             @map("min_parcels")
  discountBp Int             @map("discount_bp")
  version    ContractVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, minParcels])
  @@map("volume_tiers")
  @@schema("merchants")
}

model Product {
  id               String   @id @default(cuid())
  merchantId       String   @map("merchant_id")
  sku              String
  barcode          String?
  nameEn           String   @map("name_en")
  nameAr           String   @map("name_ar")
  price            Int
  weightGrams      Int?     @map("weight_grams")
  shopifyVariantId String?  @map("shopify_variant_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  merchant         Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, sku])
  @@map("products")
  @@schema("merchants")
}

model ShopifyShop {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  domain      String   @unique
  status      String   @default("connected")
  connectedAt DateTime @default(now()) @map("connected_at")
  merchant    Merchant @relation(fields: [merchantId], references: [id])

  @@map("shopify_shops")
  @@schema("merchants")
}

// ── money ──────────────────────────────────────────────────────────────────
// Owned by the money module only: the only place that books money.

model Account {
  code   String  @id
  nameEn String  @map("name_en")
  nameAr String  @map("name_ar")
  /// asset, liability, equity, income, expense
  type   String
  active Boolean @default(true)

  @@map("accounts")
  @@schema("money")
}

/// Never edited or deleted; a correction is a reversing entry. sourceKey books a source once.
model JournalEntry {
  id          String        @id @default(cuid())
  companyKey  String        @map("company_key")
  date        DateTime      @db.Date
  memo        String
  sourceType  String        @map("source_type")
  sourceId    String        @map("source_id")
  sourceKey   String        @unique @map("source_key")
  createdById String?       @map("created_by_id")
  reversesId  String?       @unique @map("reverses_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  lines       JournalLine[]

  @@index([companyKey, date])
  @@map("journal_entries")
  @@schema("money")
}

model JournalLine {
  id           String       @id @default(cuid())
  entryId      String       @map("entry_id")
  accountCode  String       @map("account_code")
  debit        Int          @default(0)
  credit       Int          @default(0)
  costCentreId String?      @map("cost_centre_id")
  /// merchant, holder, supplier
  partyType    String?      @map("party_type")
  partyId      String?      @map("party_id")
  entry        JournalEntry @relation(fields: [entryId], references: [id])

  @@index([accountCode])
  @@index([partyType, partyId])
  @@map("journal_lines")
  @@schema("money")
}

/// Anyone or anything that holds cash: rider, courier, store box, hub safe, agent, bank.
model CashHolder {
  id           String   @id @default(cuid())
  kind         String
  refId        String?  @map("ref_id")
  nameEn       String   @map("name_en")
  nameAr       String   @map("name_ar")
  companyKey   String   @map("company_key")
  accountCode  String   @map("account_code")
  costCentreId String?  @map("cost_centre_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([kind, refId])
  @@map("cash_holders")
  @@schema("money")
}

/// Cash moves only by a handover: the giver states the amount, the receiver confirms it.
model Handover {
  id              String    @id @default(cuid())
  fromHolderId    String    @map("from_holder_id")
  toHolderId      String    @map("to_holder_id")
  amount          Int
  confirmedAmount Int?      @map("confirmed_amount")
  /// pending, confirmed, disputed
  status          String    @default("pending")
  createdById     String    @map("created_by_id")
  confirmedById   String?   @map("confirmed_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  confirmedAt     DateTime? @map("confirmed_at")

  @@index([status])
  @@map("handovers")
  @@schema("money")
}

model Payout {
  id           String    @id @default(cuid())
  merchantId   String    @map("merchant_id")
  companyKey   String    @map("company_key")
  amount       Int
  /// draft, approved, paid, cancelled
  status       String    @default("draft")
  method       String    @default("bank")
  reference    String?
  preparedById String    @map("prepared_by_id")
  approvedById String?   @map("approved_by_id")
  paidById     String?   @map("paid_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  approvedAt   DateTime? @map("approved_at")
  paidAt       DateTime? @map("paid_at")

  @@index([merchantId, status])
  @@map("payouts")
  @@schema("money")
}

model Bill {
  id               String    @id @default(cuid())
  companyKey       String    @map("company_key")
  payee            String
  supplierRef      String?   @map("supplier_ref")
  number           String
  date             DateTime  @db.Date
  dueDate          DateTime  @map("due_date") @db.Date
  amount           Int
  vat              Int       @default(0)
  accountCode      String    @map("account_code")
  costCentreId     String?   @map("cost_centre_id")
  /// draft, approved, paid, cancelled
  status           String    @default("draft")
  preparedById     String    @map("prepared_by_id")
  approvedById     String?   @map("approved_by_id")
  paidFromHolderId String?   @map("paid_from_holder_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  paidAt           DateTime? @map("paid_at")

  @@index([status, dueDate])
  @@map("bills")
  @@schema("money")
}

model Expense {
  id               String   @id @default(cuid())
  companyKey       String   @map("company_key")
  date             DateTime @db.Date
  accountCode      String   @map("account_code")
  amount           Int
  vat              Int      @default(0)
  costCentreId     String?  @map("cost_centre_id")
  paidFromHolderId String   @map("paid_from_holder_id")
  note             String
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("expenses")
  @@schema("money")
}

// ───────────────────────────── parcels ─────────────────────────────

/// A next day parcel. Statuses and their allowed changes live in apps/api/src/parcels/status.ts.
model Parcel {
  id               String   @id @default(cuid())
  tracking         String   @unique
  merchantId       String   @map("merchant_id")
  merchantRef      String?  @map("merchant_ref")
  customerName     String   @map("customer_name")
  phone            String
  addressText      String   @map("address_text")
  decisionId       String?  @map("decision_id")
  placeId          String?  @map("place_id")
  zoneId           String?  @map("zone_id")
  hubId            String?  @map("hub_id")
  facilityId       String?  @map("facility_id")
  originFacilityId String?  @map("origin_facility_id")
  /// small, medium, large, light_bulky, heavy_bulky
  size             String
  codAmount        Int      @default(0) @map("cod_amount")
  price            Int?
  openPackage      Boolean  @default(false) @map("open_package")
  notes            String?
  status           String   @default("created")
  /// forward or return
  direction        String   @default("forward")
  attempts         Int      @default(0)
  courierId        String?  @map("courier_id")
  runId            String?  @map("run_id")
  bagId            String?  @map("bag_id")
  pickupId         String?  @map("pickup_id")
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  events           ParcelEvent[]

  @@index([status])
  @@index([merchantId])
  @@index([hubId, status])
  @@index([decisionId])
  @@map("parcels")
  @@schema("parcels")
}

/// The parcel's timeline: one row per status change.
model ParcelEvent {
  id       String   @id @default(cuid())
  parcelId String   @map("parcel_id")
  status   String
  note     String?
  userId   String?  @map("user_id")
  siteId   String?  @map("site_id")
  at       DateTime @default(now())
  parcel   Parcel   @relation(fields: [parcelId], references: [id])

  @@index([parcelId])
  @@map("parcel_events")
  @@schema("parcels")
}

/// Every scan from a station or a courier's phone. deviceScanId makes a resent scan harmless.
model Scan {
  id           String    @id @default(cuid())
  deviceScanId String    @unique @map("device_scan_id")
  step         String
  code         String
  parcelId     String?   @map("parcel_id")
  bagId        String?   @map("bag_id")
  siteId       String?   @map("site_id")
  userId       String    @map("user_id")
  ok           Boolean
  reason       String?
  answer       Json
  at           DateTime  @default(now())
  clientAt     DateTime? @map("client_at")

  @@index([parcelId])
  @@index([siteId, step])
  @@map("scans")
  @@schema("parcels")
}

model Pickup {
  id            String   @id @default(cuid())
  merchantId    String   @map("merchant_id")
  date          DateTime @db.Date
  expectedCount Int?     @map("expected_count")
  courierId     String?  @map("courier_id")
  /// scheduled, assigned, on_the_way, done, cancelled
  status        String   @default("scheduled")
  recurringId   String?  @map("recurring_id")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([recurringId, date])
  @@index([date])
  @@map("pickups")
  @@schema("parcels")
}

model RecurringPickup {
  id         String  @id @default(cuid())
  merchantId String  @map("merchant_id")
  /// 0 Sunday to 6 Saturday
  weekdays   Int[]
  active     Boolean @default(true)

  @@map("recurring_pickups")
  @@schema("parcels")
}

/// A sealed bag (pre printed serial seal) from one site to another, or a bag of one.
model Bag {
  id           String  @id @default(cuid())
  seal         String  @unique
  fromSiteId   String  @map("from_site_id")
  toSiteId     String  @map("to_site_id")
  direction    String  @default("forward")
  /// open, closed, loaded, received, opened, done
  status       String  @default("open")
  single       Boolean @default(false)
  carId        String? @map("car_id")
  count        Int     @default(0)
  closedById   String? @map("closed_by_id")
  receivedById String? @map("received_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("bags")
  @@schema("parcels")
}

/// The night car between a sorting facility and a hub (or back, for returns).
model Car {
  id          String    @id @default(cuid())
  fromSiteId  String    @map("from_site_id")
  toSiteId    String    @map("to_site_id")
  driverName  String    @map("driver_name")
  /// loading, departed, arrived
  status      String    @default("loading")
  driverCount Int?      @map("driver_count")
  departedAt  DateTime? @map("departed_at")
  arrivedAt   DateTime? @map("arrived_at")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("cars")
  @@schema("parcels")
}

/// Missing or extra parcels, broken seals, wrong counts: shown until someone resolves them.
model Gap {
  id           String    @id @default(cuid())
  siteId       String    @map("site_id")
  /// missing, extra, not_handed_over, seal_broken, count_mismatch
  kind         String
  step         String
  parcelId     String?   @map("parcel_id")
  bagId        String?   @map("bag_id")
  carId        String?   @map("car_id")
  pickupId     String?   @map("pickup_id")
  lastScanById String?   @map("last_scan_by_id")
  open         Boolean   @default(true)
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedById String?   @map("resolved_by_id")
  resolvedAt   DateTime? @map("resolved_at")

  @@index([open, siteId])
  @@map("gaps")
  @@schema("parcels")
}

/// The delivery zones a courier usually covers (moves to Agents & Fleet when it exists).
model CourierZone {
  userId String @map("user_id")
  zoneId String @map("zone_id")

  @@id([userId, zoneId])
  @@map("courier_zones")
  @@schema("parcels")
}

/// A courier's run for one day from one hub.
model Run {
  id            String   @id @default(cuid())
  hubId         String   @map("hub_id")
  courierId     String   @map("courier_id")
  date          DateTime @db.Date
  /// open, out, closed
  status        String   @default("open")
  confirmedById String   @map("confirmed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([courierId, date])
  @@map("runs")
  @@schema("parcels")
}

model Attempt {
  id            String   @id @default(cuid())
  parcelId      String   @map("parcel_id")
  runId         String   @map("run_id")
  number        Int
  /// delivered or failed
  result        String
  reason        String?
  cashCollected Int      @default(0) @map("cash_collected")
  /// otp, photo, none
  proof         String   @default("none")
  at            DateTime @default(now())

  @@unique([parcelId, number])
  @@map("attempts")
  @@schema("parcels")
}
